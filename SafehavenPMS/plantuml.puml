    +InitialAssessmentForms : ICollection<InitialAssessmentForm>
    +PsychiatricAssessments : ICollection<PsychiatricAssessment>
    +Admissions : ICollection<Admission>
    +Interventions : ICollection<Intervention>
  }

  class ClinicalStaff {
    +ClinicalStaffID : int
