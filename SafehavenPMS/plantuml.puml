    --
    +IntakeForm : IntakeForm
    +ClinicalStaffPatients : ICollection<ClinicalStaffPatient>
    +MedicationOrders : ICollection<MedicationOrder>
    +AdministrationLogs : ICollection<AdministrationLog>
