@model SafehavenPMS.ViewModel.ClinicalStaffProfileViewModel

<div class="availability-container g-4">
    @* Container for Availability Page *@
    <div class="container-fluid border rounded bg-white p-4" style="width: 100%;">

        @* Header with Icon and Title *@
        <div class="table-header d-flex justify-content-center align-items-center text-center">
            <h5 class="mb-0">Availability</h5>
        </div>


        @* Filters/Search and Date Picker *@
        <div class="d-flex justify-content-between align-items-center mb-3">


            <div class="form-group d-flex justify-content-center align-items-center gap-2">
                <label for="startDate" class="form-label m-0">Date</label>
                <input type="date" id="startDate" class="form-control" style="width: 180px;">
            </div>
        </div>

        @* Availability Table *@
        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Day/s</th>
                        <th>Time Slot(s)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Availability == null || !Model.Availability.Any())
                    {
                        <tr><td colspan="5">No Availability Date</td></tr>
                    }
                    else
                    {
                        foreach (var available in Model.Availability)
                        {
                            // Filter only available days
                            var availableDays = available.Days.Where(d => d.IsAvailable).ToList();

                            foreach (var day in availableDays)
                            {
                                <tr>
                                    <td>@available.Title</td>
                                    <td>
                                        @{
                                            // Find the correct date for this specific day
                                            var targetDay = (DayOfWeek)Enum.Parse(typeof(DayOfWeek), day.DayName);
                                            var date = available.StartDate;

                                            while (date.DayOfWeek != targetDay)
                                            {
                                                date = date.AddDays(1);
                                            }
                                        }
                                        @date.ToString("MMM dd yyyy") <!-- Example: Aug 11 2025 -->
                                    </td>
                                    <td>@day.DayName</td>
                                    <td class="text-center">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var slot in day.TimeSlots)
                                            {
                                                <li class="mb-1">
                                                    <i class="bx bx-time-five text-success me-1"></i>
                                                    @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                                                </li>
                                            }
                                        </ul>
                                    </td>

                                    <td class="text-center d-flex justify-content-center gap-2">
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#appointment-modal" class="border rounded px-2 py-1 text-primary hover-fill" title="Edit">
                                            <i class='bx bx-edit'></i>
                                        </a>
                                        <a href="#" class="border rounded px-2 py-1 text-danger hover-fill" title="Delete">
                                            <i class='bx bx-trash'></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

    @* Section for adding new Availability *@
    <div class="availability-inputs border rounded d-flex flex-column" id="availability-input" style="display:none !important">
        <div class="availability-header d-flex flex-row justify-content-between p-3 border-bottom">
            <div class="d-flex flex-row ">
                <i class='bx bx-calendar-check fs-4 me-2'></i>
                <h5 class="modal-title fw-bold mb-0">Add Availability</h5>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" id="close-availability" aria-label="Close"></button>
            @* <button type="button" id="close-availability" aria-label="Close"></button> *@
        </div>

        @* Input Title *@
        <div class="col-md-12 d-flex flex-column align-items-start p-2">
            <label class="form-label mb-0 me-2 text-nowrap">Title</label>
            <input type="text" class="form-control flex-grow-1 uniform-input" id="availability-title" />
            <span class="text-danger" id="title-error"></span>
        </div>

        @* Date Range *@
        <div class="row p-2">
            <div class="col-md-6 mb-3">
                <label class="form-label mb-0 me-2 text-nowrap">Start Date</label>
                <input type="date" class="form-control uniform-input" id="start-date" />
                <span class="text-danger" id="start-date-error"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label mb-0 me-2 text-nowrap">End Date</label>
                <input type="date" class="form-control uniform-input" id="end-date"/>
                <span class="text-danger" id="end-date-error"></span>

                @* Added Checkbox below End Date *@
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="availability-checkbox"/>
                    <label class="form-check-label" for="availability-checkbox">
                        No end date
                    </label>
                </div>
            </div>
        </div>

        @* Populate with Days *@
       

        @* Populate with available dates *@
        <div class="row p-2">
            <div class="col-12">
                <h6 class="fw-semibold mb-3">Available Days</h6>

                <div class="form-check d-flex align-items-center">
                    <input class="form-check-input me-2" type="checkbox" id="${day}-check">
                    <label class="form-check-label fw-semibold">Monday</label>
                </div>
                <div class="time-slots mt-2" id="${day}-times" style="display: none;">
                    <div class="d-flex align-items-center mb-2" id="${day}-slot-1">
                        <input type="time" class="form-control me-2" value="06:00">
                        <span class="me-2">–</span>
                        <input type="time" class="form-control me-2" value="07:00">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addTimeSlot('${day}')">+</button>
                    </div>
                </div>

                <div id="weekdays-container">
                    <div class="d-flex align-items-center mb-2">
                        <input type="time" class="form-control me-2" value="06:00">
                        <span class="me-2">–</span>
                        <input type="time" class="form-control me-2" value="07:00">
                        <button type="button" class="btn btn-sm btn-outline-danger">-</button>
                    </div>
                </div>
            </div>
        </div>

        @* Availabilty inpput footer *@
        <div class="mt-auto d-flex justify-content-end gap-2 p-3 border-top bg-white">
            <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn-custom  btn-next" form="availability-form">Save</button>
        </div>
    </div>
</div>




    <style>
        .table-header {
            width: 100%;
            height: 50px;
            background: linear-gradient(to right, #069FB2, #058594);
            color: white;
            font-weight: 600;
            border-radius: 6px;
            margin-bottom: 10px;
        }

        .table-header-custom {
            background-color: #015F6B !important;
            color: #ffffff !important;
        }

        .hover-fill:hover {
            background-color: rgba(0, 163, 180, 0.1); /* Light teal for hover */
            transition: background-color 0.3s ease;
        }

        .hover-fill.text-danger:hover {
            background-color: rgba(244, 63, 94, 0.1); /* Light red for delete hover */
        }

    .availability-inputs {
        width: 60%;
        background-color: white;
        min-height:800px;
    }

    .availability-container {
        display: flex;
        margin: 10px;
        gap: 20px; /* horizontal space */
        align-items: flex-start; /* top align, no height stretching */
    }
    </style>

<script src="/js/appointment.js"></script>