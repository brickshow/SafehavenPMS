@model SafehavenPMS.ViewModel.ClinicalStaffProfileViewModel

<div class="availability-container g-4">
    @* Container for Availability Page *@
    <div class="container-fluid border rounded bg-white p-4" style="width: 100%;">

        @* Header with Icon and Title *@
        <div class="table-header d-flex justify-content-center align-items-center text-center">
            <h5 class="mb-0">Availability</h5>
        </div>


        @* Filters/Search and Date Picker *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <form asp-controller="ClinicalStaff" asp-action="FilterByDate" method="get">
                <div class="form-group d-flex justify-content-center align-items-center gap-2">
                    <label for="selectedDate" class="form-label m-0">Date</label>
                    <input type="date" id="selectedDate" name="selectedDate" class="form-control" style="width: 180px;" onchange="this.form.submit()"
                           value="@(ViewBag.SelectedDate != null ? ((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd") : null)" />
                    <input type="hidden" name="id" value="@ViewBag.ClinicalStaffId" />
                </div>
            </form>
        </div>

        @* Availability Table *@
        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Day/s</th>
                        <th>Time Slot(s)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Availability == null || !Model.Availability.Any())
                    {
                        <tr><td colspan="5">No Availability Date</td></tr>
                    }
                    else
                    {
                        foreach (var available in Model.Availability)
                        {
                            // Filter only available days
                            var availableDays = available.Days.Where(d => d.IsAvailable).ToList();

                            foreach (var day in availableDays)
                            {
                                <tr>
                                    <td>@available.Title</td>
                                    <td>
                                        @{
                                            // Find the correct date for this specific day
                                            var targetDay = (DayOfWeek)Enum.Parse(typeof(DayOfWeek), day.DayName);
                                            var date = available.StartDate;

                                            while (date.DayOfWeek != targetDay)
                                            {
                                                date = date.AddDays(1);
                                            }
                                        }
                                        @date.ToString("MMM dd yyyy") <!-- Example: Aug 11 2025 -->
                                    </td>
                                    <td>@day.DayName</td>
                                    <td class="text-center">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var slot in day.TimeSlots.Where(ts => ts.IsAvailable))
                                            {
                                                <li class="mb-1">
                                                    <i class="bx bx-time-five text-success me-1"></i>
                                                    @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                                                </li>
                                            }
                                        </ul>
                                    </td>

                                    <td class="text-center d-flex justify-content-center gap-2">
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#appointment-modal" class="border rounded px-2 py-1 text-primary hover-fill" title="Edit">
                                            <i class='bx bx-edit'></i>
                                        </a>
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                                           class="border rounded px-2 py-1 text-danger hover-fill" title="Delete"
                                           onclick="setDayToDelete(@(day.DayId))">
                                            <i class='bx bx-trash'></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

    @* Reder partial views *@
    @await Html.PartialAsync(
    "StaffPartialViews/AddAvailabilityPartial",
        Model.NewAvailability
        )
</div>

@* Modal to delete *@
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteConfirmLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this Availability? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <form asp-action="DeleteAvailability" asp-controller="ClinicalStaff" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="dayIdToDelete" name="id" />
                    <button type="button" class="btn-cancel btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-next btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>



    <style>
        .table-header {
            width: 100%;
            height: 50px;
            background: linear-gradient(to right, #069FB2, #058594);
            color: white;
            font-weight: 600;
            border-radius: 6px;
            margin-bottom: 10px;
        }

        .table-header-custom {
            background-color: #015F6B !important;
            color: #ffffff !important;
        }

        .hover-fill:hover {
            background-color: rgba(0, 163, 180, 0.1); /* Light teal for hover */
            transition: background-color 0.3s ease;
        }

        .hover-fill.text-danger:hover {
            background-color: rgba(244, 63, 94, 0.1); /* Light red for delete hover */
        }

    .availability-container {
        display: flex;
        margin: 10px;
        gap: 20px; /* horizontal space */
        align-items: flex-start; /* top align, no height stretching */
    }
    </style>

<script src="/js/appointment.js"></script>
<script>
      function setDayToDelete(dayId) {
        document.getElementById('dayIdToDelete').value = dayId;
    }
</script>