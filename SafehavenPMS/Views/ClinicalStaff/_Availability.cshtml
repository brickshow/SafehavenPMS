@model SafehavenPMS.ViewModel.ClinicalStaffProfileViewModel

<div class="availability-container g-4">
    @* Container for Availability Page *@
    <div class="container-fluid border rounded bg-white p-4" style="width: 100%;">

        @* Header with Icon and Title *@
        <div class="table-header d-flex justify-content-center align-items-center text-center">
            <h5 class="mb-0">Availability</h5>
        </div>

        @* Availability Table *@
        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Day/s</th>
                        <th>Time Slot(s)</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Availability != null && Model.Availability.Any())
                    {
                        var groupedByDay = Model.Availability
                        .GroupBy(a => a.Day)
                        .OrderBy(g => g.Key);

                        foreach (var dayGroup in groupedByDay)
                        {
                            var slots = dayGroup.ToList();
                            for (int i = 0; i < slots.Count; i++)
                            {
                                var slot = slots[i];
                                <tr>
                                    @* First row shows Day with rowspan *@
                                    @if (i == 0)
                                    {
                                        <td rowspan="@slots.Count">@dayGroup.Key</td>
                                    }
                                    <td>@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</td>
                                    <td>
                                        @if (slot.Status == "Available")
                                        {
                                            <span class="text-success">
                                                <i class="bx bx-check-circle"></i> Available
                                            </span>
                                        }
                                        else if (slot.Status == "Unavailable")
                                        {
                                            <span class="text-warning">
                                                <i class="bx bx-error"></i> Unavailable
                                            </span>
                                        }
                                        else if (slot.Status == "Booked")
                                        {
                                            <span class="text-danger">
                                                <i class="bx bx-x-circle"></i> Booked
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if(slot.Notes == null)
                                        {
                                            <span>-</span>
                                        }
                                        else
                                        {
                                            <span>@slot.Notes</span>
                                        }
                                    </td>

                                    <td>
                                        <a href="#" data-bs-toggle="modal"
                                           data-bs-target="#addNotes-@slot.AvailabilityId"
                                           class="border rounded px-2 py-1 text-primary hover-fill"
                                           title="Edit">
                                            <i class='bx bx-edit'></i>
                                        </a>

                                        <!-- Modal for this slot -->
                                        <div class="modal fade" id="addNotes-@slot.AvailabilityId" tabindex="-1"
                                             aria-labelledby="addNotesLabel-@slot.AvailabilityId" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-primary text-white">
                                                        <h5 class="modal-title" id="addNotesLabel-@slot.AvailabilityId">Add Notes</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form asp-action="AddNotes" asp-controller="ClinicalStaff" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-body">
                                                            <input type="hidden" name="availabilityId" value="@slot.AvailabilityId" />

                                                            <div class="mb-3">
                                                                <label for="notes-@slot.AvailabilityId" class="form-label">Notes</label>
                                                                <textarea id="notes-@slot.AvailabilityId" name="notes" class="form-control" rows="4">@slot.Notes</textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn-cancel btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn-next btn-primary">Save Notes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-muted">No availability found.</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>

    @* Reder partial views *@
    @* @await Html.PartialAsync("StaffPartialViews/AddAvailabilityPartial", Model.Days) *@

</div>
@* 
Modal to Add Notes
<div class="modal fade" id="addNotes" tabindex="-1" aria-labelledby="addNotesLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addNotesLabel">Add Notes</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddNotes" asp-controller="ClinicalStaff" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="appointmentId" name="AppointmentId" />

                    <div class="mb-3">
                        <label for="notes" class="form-label">Notes</label>
                        <textarea id="notes" name="Notes" class="form-control" rows="4" placeholder="Enter notes here..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-next btn-primary">Save Notes</button>
                </div>
            </form>
        </div>
    </div>
</div> *@




    <style>
        .table-header {
            width: 100%;
            height: 50px;
            background: linear-gradient(to right, #069FB2, #058594);
            color: white;
            font-weight: 600;
            border-radius: 6px;
            margin-bottom: 10px;
        }

        .table-header-custom {
            background-color: #015F6B !important;
            color: #ffffff !important;
        }

        .hover-fill:hover {
            background-color: rgba(0, 163, 180, 0.1); /* Light teal for hover */
            transition: background-color 0.3s ease;
        }

        .hover-fill.text-danger:hover {
            background-color: rgba(244, 63, 94, 0.1); /* Light red for delete hover */
        }

    .availability-container {
        display: flex;
        margin: 10px;
        gap: 20px; /* horizontal space */
        align-items: flex-start; /* top align, no height stretching */
    }
    </style>

<script src="/js/appointment.js"></script>
<script>
      function setDayToDelete(dayId) {
        document.getElementById('dayIdToDelete').value = dayId;
    }
</script>