    <div class="row p-3">
        <!-- Select Day -->
        <div class="col-md-12 mb-3">
            <label class="form-label fw-semibold">Day</label>
            <select class="form-select" id="availability-day">
                <option value="">-- Select Day --</option>
                <option>Monday</option>
                <option>Tuesday</option>
                <option>Wednesday</option>
                <option>Thursday</option>
                <option>Friday</option>
                <option>Saturday</option>
                <option>Sunday</option>
            </select>
        </div>

        <!-- Time inputs in one row -->
        <div class="col-md-4 mb-3">
            <label class="form-label fw-semibold">Start Time</label>
            <input type="time" class="form-control" id="availability-start" value="09:00">
        </div>
            
        <div class="col-md-4 mb-3">
            <label class="form-label fw-semibold">End Time</label>
            <input type="time" class="form-control" id="availability-end" value="12:00">
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label fw-semibold">Duration</label>
            <select class="form-select" id="availability-duration">
                <option value="30">30 min</option>
                <option value="60" selected>1 hour</option>
            </select>
        </div>
    </div>


    @* Availability input footer (sticky at bottom) *@
    <div class="mt-auto d-flex justify-content-end gap-2 p-3 border-top bg-white">
        <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn-custom btn-next" onclick="saveAvailability()">Save</button>
    </div>   
</div>
<style>
    .availability-inputs {
        width: 60%;
        background-color: white;
        min-height: 100%;
        /* Initially hidden */
        display: none;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.5s ease, transform 0.5s ease;
    }

        .availability-inputs.show {
            display: block; /* Make visible */
            /* Trigger the animation */
            opacity: 1;
            transform: translateY(0);
        }

</style>