@using SafehavenPMS.ViewModel
@model List<DayAvailabilityViewModel>

<div class="availability-inputs border rounded d-flex flex-column" id="availability-input">
    <div class="availability-header d-flex flex-row justify-content-between p-3 border-bottom">
        <div class="d-flex flex-row">
            <i class='bx bx-calendar-check fs-4 me-2'></i>
            <h5 class="modal-title fw-bold mb-0">Add Availability</h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" id="close-availability" aria-label="Close"></button>
    </div>

    <form asp-controller="ClinicalStaff" asp-action="AddAvailability" method="post" class="p-3">
        <input type="hidden" name="ClinicalStaffID" value="@ViewBag.ClinicalStaffID" />

        <div class="row">
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="col-12 mb-4 border p-2 rounded">
                    <h6 class="fw-semibold">@Model[i].Day</h6>
                    <input type="hidden" asp-for="@Model[i].Day" />

                    @for (int j = 0; j < Model[i].Slots.Count; j++)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <input asp-for="@Model[i].Slots[j].StartTime" type="time" class="form-control me-2" />
                            <span class="me-2">–</span>
                            <input asp-for="@Model[i].Slots[j].EndTime" type="time" class="form-control me-2" />
                            <input type="hidden" asp-for="@Model[i].Slots[j].Status" value="Available" />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mt-auto d-flex justify-content-end gap-2 p-3 border-top bg-white">
            <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn-custom btn-next">Save</button>
        </div>
    </form>
</div>
