
<div id="calendar-modal" class="modal fade right-modal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-slideout">
        <div class="modal-content border-0 shadow h-100 d-flex flex-column">
            <!-- Modal Header -->
            <div class="modal-header bg-white border-bottom">
                <i class='bx bx-calendar-check fs-4 me-2'></i>
                <h5 class="modal-title fw-bold mb-0">Add Availability</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body overflow-auto flex-grow-1">
                <form id="availability-form" method="post">
                    <!-- Hidden Fields -->
                    <input type="hidden" id="clinical-staff-id" value="@ViewBag.ClinicalStaffID"/>

                    <!-- Title -->
                    <div class="col-md-12 d-flex flex-column align-items-start p-2">
                        <label class="form-label mb-0 me-2 text-nowrap">Title</label>
                        <input type="text" class="form-control flex-grow-1 uniform-input" id="availability-title" />
                        <span class="text-danger" id="title-error"></span>
                    </div>

                    <!-- Date Range -->
                    <div class="row p-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label mb-0 me-2 text-nowrap">Start Date</label>
                            <input type="date" class="form-control uniform-input" id="start-date" onchange="updateWeekdays()" />
                            <span class="text-danger" id="start-date-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label mb-0 me-2 text-nowrap">End Date</label>
                            <input type="date" class="form-control uniform-input" id="end-date" onchange="updateWeekdays()" />
                            <span class="text-danger" id="end-date-error"></span>

                            <!-- Added Checkbox below End Date -->
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="availability-checkbox" onchange="updateWeekdays()" />
                                <label class="form-check-label" for="availability-checkbox">
                                    No end date
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Weekdays Container -->
                    <div class="row p-2">
                        <div class="col-12">
                            <h6 class="fw-semibold mb-3">Available Days</h6>
                            <div id="weekdays-container">
                                <div class="d-flex align-items-center mb-2">
                                    <input type="time" class="form-control me-2" value="06:00">
                                    <span class="me-2">–</span>
                                    <input type="time" class="form-control me-2" value="07:00">
                                    <button type="button" class="btn btn-sm btn-outline-danger">-</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>


            <!-- Modal Footer -->
            <div class="modal-footer bg-white border-top">
                <button type="button" class="btn-cancel btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn-custom btn-next" form="availability-form">Save</button>
            </div>
        </div>
    </div>
</div>


<script src="/js/appointment.js"></script>

<style>
    .right-modal .modal-dialog-slideout {
        min-height: 100%;
        margin: 0 0 0 auto;
    }

    .right-modal .modal.fade .modal-dialog-slideout {
        transform: translate(100%, 0);
    }

    .right-modal .modal.fade.show .modal-dialog-slideout {
        transform: translate(0, 0);
    }

    .modal-dialog-slideout {
        width: 500px;
    }
</style>