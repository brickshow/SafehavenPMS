@model SafehavenPMS.ViewModel.ClinicalStaffProfileViewModel


@{
    var staff = Model.Staffs.FirstOrDefault(); // safely get the first staff member
    ViewBag.Title = staff != null ? $"{staff.Firstname} {staff.Lastname} - Profile" : "Staff Profile";
}
<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index", "ClinicalStaff")" class="me-3">
                <i class="bx bx-reply fs-1 text-custom"></i>
            </a>
            <img src="@(string.IsNullOrEmpty(staff?.ProfilePictureURL) ? "/Images/default.png" : staff.ProfilePictureURL)"
                 class="rounded-circle me-3" style="width:60px; height:60px;" />
            <div>
                <div class="d-flex flex-row justify-content-start align-items-center" style="gap:10px">
                    <h4 class="mb-0 text-custom">@staff.Firstname @staff.Lastname</h4>
                    <span class="badge bg-success">@(staff.IsActive ? "Active" : "Inactive")</span>
                </div>
                <p class="mb-0 text-muted">@staff.Position - @staff.ClinicalStaffID</p>
            </div>
        </div>
        <a href="#" id="availability-button" class="add-availability btn-custom btn-primary text-decoration-none" data-bs-toggle="modal" data-bs-target="#calendar-modal" style="display:none">
            + Add Availability
        </a>
    </div>


    @* Tabs *@
    <ul class="nav nav-tabs mb-4" id="staffTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview"
                    type="button" role="tab" aria-controls="overview" aria-selected="true">
                Overview
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal"
                    type="button" role="tab" aria-controls="personal" aria-selected="false">
                Personal
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents"
                    type="button" role="tab" aria-controls="documents" aria-selected="false">
                Documents
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link availability-tab" id="availability-tab" data-bs-toggle="tab" data-bs-target="#availability"
                    type="button" role="tab" aria-controls="documents" aria-selected="false">
                Availability
            </button>
        </li>
    </ul>


    @* Tab Content *@
    <div class="tab-content" id="staffTabContent">
        <div class="tab-pane fade show active" id="overview" role="tabpanel" aria-labelledby="overview-tab">
            @await Html.PartialAsync("_OverviewTab", Model)
        </div>

        <div class="tab-pane fade" id="personal" role="tabpanel" aria-labelledby="personal-tab">
            @await Html.PartialAsync("_PersonalTab", Model)
        </div>

        <div class="tab-pane fade" id="documents" role="tabpanel" aria-labelledby="documents-tab">
            @await Html.PartialAsync("_DocumentsTab", Model)
        </div>

        <div class="tab-pane fade" id="availability" role="tabpanel" aria-labelledby="availability-tab">
            @await Html.PartialAsync("_Availability", Model)
        </div>
    </div>
</div>

<div id="calendar-modal" class="modal fade right-modal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-slideout">
        <div class="modal-content border-0 shadow h-100 d-flex flex-column">

            @* Modal Header *@
            <div class="modal-header bg-white border-bottom">
                <i class='bx bx-calendar-check fs-4 me-2'></i>
                <h5 class="modal-title fw-bold mb-0">Add Availability</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @* Scrollable Body *@
            <div class="modal-body overflow-auto flex-grow-1">

                @* Title *@
                <div class="col-md-12 d-flex flex-column align-items-start p-2">
                    <label class="form-label mb-0 me-2 text-nowrap">Title</label>
                    <input type="text" class="form-control flex-grow-1 uniform-input" id="availability-title" />
                    <span class="text-danger" id="title-error"></span>
                </div>

                @* Date Range *@
                <div class="row p-2">
                    <div class="col-md-6 mb-3">
                        <label class="form-label mb-0 me-2 text-nowrap">Start Date</label>
                        <input type="date" class="form-control uniform-input" id="start-date" onchange="updateWeekdays()" />
                        <span class="text-danger" id="start-date-error"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label mb-0 me-2 text-nowrap">End Date</label>
                        <input type="date" class="form-control uniform-input" id="end-date" onchange="updateWeekdays()" />
                        <span class="text-danger" id="end-date-error"></span>
                    </div>
                </div>

                @* Weekdays Container *@
                <div class="p-2" id="weekdays-container">
                    @* Weekday sections will be dynamically generated here *@
                </div>

            </div>

            @* Footer pinned at the bottom *@
            <div class="modal-footer bg-white border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveAvailability()">Save</button>
            </div>

        </div>
    </div>
</div>

<style>
    .card {
        border: 1px solid #e9ecef;
        border-radius: 10px;
    }

    .nav-tabs .nav-link {
        color: #767676;
        background-color: transparent;
        border: none;
        font-weight: normal;
    }

        .nav-tabs .nav-link.active {
            color: #00A3B4;
            background-color: transparent;
            border: none;
            border-bottom: 3px solid #00A3B4;
            font-weight: bold;
        }

</style>

<script src="/js/appointment.js"></script>
