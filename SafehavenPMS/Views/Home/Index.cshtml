@model SafehavenPMS.ViewModel.Dashboard.DashboardStatsViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="dashboard-wrapper container-fluid">
    <div class="stats-grid row gx-3 gy-3">
        <div class="col-12 col-sm-6 col-md-3">
            <a class="stat-card text-decoration-none" href="@Url.Action("Index","Patient")">
                <div class="stat-inner">
                    <div>
                        <div class="stat-label">Total Patients</div>
                        <div class="stat-value" data-target="@Model.TotalPatients">0</div>
                    </div>
                    <i class="fa-solid fa-users stat-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <a class="stat-card text-decoration-none" href="@Url.Action("Create","PatientRegistration")">
                <div class="stat-inner">
                    <div>
                        <div class="stat-label">New Patient (Month)</div>
                        <div class="stat-value" data-target="@Model.NewPatientsThisMonth">0</div>
                    </div>
                    <i class="fa-solid fa-user-plus stat-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <a class="stat-card text-decoration-none" href="@Url.Action("Index","ClinicalStaff")">
                <div class="stat-inner">
                    <div>
                        <div class="stat-label">Doctor</div>
                        <div class="stat-value" data-target="@Model.Doctors">0</div>
                    </div>
                    <i class="fa-solid fa-user-doctor stat-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <a class="stat-card text-decoration-none" href="@Url.Action("Index","ClinicalStaff")">
                <div class="stat-inner">
                    <div>
                        <div class="stat-label">Nurse</div>
                        <div class="stat-value" data-target="@Model.Nurses">0</div>
                    </div>
                    <i class="fa-solid fa-user-nurse stat-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <a class="stat-card text-decoration-none" href="@Url.Action("Index","Services")">
                <div class="stat-inner">
                    <div>
                        <div class="stat-label">Coach</div>
                        <div class="stat-value" data-target="@Model.Coaches">0</div>
                    </div>
                    <i class="fa-solid fa-chalkboard-user stat-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <a class="stat-card text-decoration-none" href="@Url.Action("Index","Appointment")">
                <div class="stat-inner">
                    <div>
                        <div class="stat-label">Appointment</div>
                        <div class="stat-value" data-target="@Model.Appointments">0</div>
                    </div>
                    <i class="fa-solid fa-calendar-check stat-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <a class="stat-card text-decoration-none" href="@Url.Action("Index","Billing")">
                <div class="stat-inner">
                    <div>
                        <div class="stat-label">Invoice</div>
                        <div class="stat-value" data-target="@Model.Invoices">0</div>
                    </div>
                    <i class="fa-solid fa-file-invoice stat-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <a class="stat-card text-decoration-none" href="@Url.Action("Index","User")">
                <div class="stat-inner">
                    <div>
                        <div class="stat-label">Total Users</div>
                        <div class="stat-value" data-target="@Model.Users">0</div>
                    </div>
                    <i class="fa-solid fa-users stat-icon"></i>
                </div>
            </a>
        </div>
    </div>

    <div class="charts-row row mt-4 gx-4">
        <div class="col-12 col-lg-6">
            <div class="card dashboard-panel">
                <div class="panel-header">
                    <h5>Patients Statuses</h5>
                </div>
                <div class="panel-body">
                    <canvas id="patientsPieChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="panel-body">
                <div id="appointmentCalendar"></div>
            </div>
        </div>
    </div>
</div>

<style>
:root{
  --teal:#0b6b6b;
  --teal-dark:#075157;
  --card-bg:#f5fbfb;
  --panel-bg:#ffffff;
  --accent:#0aa39a;
}
.dashboard-wrapper{ padding:22px 28px; }
.dashboard-header{ margin-bottom:18px; }
.dashboard-title{ font-size:48px; font-weight:500; text-align:center; width:100%; color:#222; }
.user-actions{ gap:12px; }
.notification-badge{ background:#e94b4b; color:#fff; padding:4px 8px; border-radius:12px; font-weight:600; }
.user-name{ color:#222; font-weight:600; }

.stats-grid .stat-card{
  background:var(--teal);
  color:#fff;
  padding:18px 20px;
  border-radius:8px;
  box-shadow:0 6px 18px rgba(2,6,23,0.06);
  display:flex;
  flex-direction:column;
  gap:6px;
  min-height:80px;
}
.stat-card .stat-label{ font-size:16px; opacity:0.95; }
.stat-card .stat-value{ font-size:36px; font-weight:700; line-height:1; }
.stat-card .stat-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  width:100%;
  gap:12px;
}
.stat-card .stat-icon{
  font-size:30px; /* reduced from 42px */
  color:#fff;
  opacity:0.95;
  line-height:1;
  width:auto;
  height:auto;
}

/* scale only the inner content so the card visually grows without altering layout flow */
.stats-grid .stat-card .stat-inner{
  transition: transform 180ms cubic-bezier(.2,.8,.2,1);
  transform-origin: center;
  will-change: transform;
}
.stats-grid .stat-card:hover{
  transform: translateY(-1px) scale(1.03);
  z-index: 2;
}s

.dashboard-panel{ border-radius:8px; padding:0; overflow:hidden; box-shadow:0 6px 16px rgba(0,0,0,0.06); }
.dashboard-panel .panel-header{ padding:18px 20px; border-bottom:1px solid #eee; background:linear-gradient(180deg,#fff,#fafafa); }
.dashboard-panel .panel-header h5{ font-size:20px; margin:0; color:var(--teal-dark); font-weight:600; }
.dashboard-panel .panel-body{ padding:22px; background:var(--panel-bg); display:flex; gap:20px; align-items:center; }

.legend-list{ list-style:none; padding:0; margin:12px 0 0 0; display:flex; flex-direction:column; gap:8px; color:#444; font-weight:500; font-size:15px; }
.legend-swatch{ display:inline-block; width:14px; height:14px; margin-right:10px; border-radius:3px; vertical-align:middle; }
.swatch-admitted{ background:#ff9f40; }
.swatch-pending{ background:#ffd86b; }
.swatch-assessment{ background:#ff6b86; }
.swatch-referral{ background:#1dd1a1; }
.swatch-discharge{ background:#2e86de; }

.empty-panel .panel-body{ min-height:260px; }
.placeholder-text{ color:#9aa3a3; font-weight:600; font-size:18px; }

@@media (max-width:768px){
  .dashboard-title{ font-size:34px; }
  .stat-card .stat-value{ font-size:30px; }
  .stat-card .stat-icon{ font-size:28px; } /* reduced for tablet */
  .dashboard-panel .panel-header h5{ font-size:18px; }
}

@@media (max-width:576px){
  .dashboard-title{ font-size:28px; }
  .stat-card .stat-value{ font-size:24px; }
  .stat-card .stat-icon{ font-size:26px; } /* reduced for small screens */
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // animate stat cards (existing)
  document.querySelectorAll('.stat-value').forEach(el => {
      const target = parseInt(el.dataset.target || '0',10);
      if(isNaN(target)){ el.textContent='0'; return; }
      let start=0;
      const duration=600;
      const t0=performance.now();
      const step=(ts)=>{
        const p=Math.min((ts - t0)/duration,1);
        el.textContent = Math.round(p*target).toLocaleString();
        if(p<1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
  });

  // --- NEW: dynamic pie chart data from server (via ViewBag JSON) ---
  const labels = @Html.Raw(ViewBag.PatientStatusLabelsJson ?? "[]");
  const counts = @Html.Raw(ViewBag.PatientStatusValuesJson ?? "[]");

  // fallback minimal data if nothing provided
  const fallbackLabels = ['Admitted','Pending Approval','On Assessment','New Referral','Discharge'];
  const fallbackCounts = [25,20,15,25,15];

  const chartLabels = (labels && labels.length) ? labels : fallbackLabels;
  const chartData = (counts && counts.length) ? counts : fallbackCounts;

  // generate a color palette (repeats if needed)
  const baseColors = ['#ff9f40','#ffd86b','#ff6b86','#1dd1a1','#2e86de','#06a9be','#7f8c8d','#9b59b6','#f39c12','#16a085'];
  const bgColors = chartLabels.map((_,i) => baseColors[i % baseColors.length]);

  const ctx = document.getElementById('patientsPieChart').getContext('2d');
  new Chart(ctx, {
      type: 'pie',
      data: {
          labels: chartLabels,
          datasets: [{
              data: chartData,
              backgroundColor: bgColors,
              hoverOffset: 6
          }]
      },
      options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
              legend: {
                  display: true,
                  position: 'top',
                  labels: { boxWidth: 14, padding: 12 }
              },
              tooltip: {
                  callbacks: {
                      label: function(context) {
                          const label = context.label || '';
                          const value = context.parsed || 0;
                          return `${label}: ${value.toLocaleString()}`;
                      }
                  }
              }
          }
      }
  });

  // ensure canvas container has height
  const canvas = document.getElementById('patientsPieChart');
  canvas.parentElement.style.minHeight = '220px';
  // -------------------------------------------------------------------

  // --- Appointments Calendar (FullCalendar) ---
  try {
      const calEl = document.getElementById('appointmentCalendar');
      if (calEl && window.FullCalendar) {
          const calendar = new FullCalendar.Calendar(calEl, {
              initialView: 'dayGridMonth',
              height: 'auto',
              headerToolbar: {
                  left: 'prev,next today',
                  center: 'title',
                  right: 'dayGridMonth,timeGridWeek,timeGridDay'
              },
              events: '/Appointment/GetAppointments',
              selectable: true,
               eventContent: function(arg){
                   var span = document.createElement('span');
                   span.className = 'cal-badge';
                   // keep title as tooltip for accessibility
                   if (arg.event && arg.event.title) span.title = arg.event.title;
                   return { domNodes: [span] };
               },
              dayCellDidMount: function (info) {
                  const today = new Date();
                  const d = info.date;
                  if (d.getFullYear() === today.getFullYear() && d.getMonth() === today.getMonth() && d.getDate() === today.getDate()) {
                      info.el.style.backgroundColor = '#fff4e5';
                      info.el.style.border = '2px solid #00A3B4';
                      info.el.style.borderRadius = '8px';
                  }
              }
          });
          calendar.render();
      }
  } catch (e) {
      console.warn('Calendar init failed', e);
  }
});
</script>

<style>
    /* Calendar styles copied to match _Calendar.cshtml design */
    #appointmentCalendar {
        max-width: 100%;
        margin: 0 auto;
        background: white;
        padding: 20px;
        border-radius: 8px;
    }
    .fc .fc-toolbar.fc-header-toolbar {
        background: linear-gradient(to right, #069FB2, #058594);
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        margin-bottom: 10px;
    }
    .fc .fc-toolbar-title {
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
    }
    .fc .fc-daygrid-day-number {
        color: #015F6B;
        font-weight: 600;
    }
    .fc .fc-scrollgrid,
    .fc .fc-scrollgrid td,
    .fc .fc-daygrid-day {
        border-color: #b3dfe5;
    }
    .fc .fc-daygrid-day-frame {
        background-color: #f8fcfc;
    }
    .fc .fc-col-header-cell-cushion {
        color: #015F6B;
        font-weight: 600;
        font-size: 0.95rem;
    }
     /* small badge for events */
     .cal-badge{
         display:inline-block;
         width:10px;
         height:10px;
         border-radius:50%;
         background: linear-gradient(to right, #069FB2, #058594);
         box-shadow: 0 0 0 1px #ffffff; /* tiny outline for contrast */
         margin: 2px 2px 0 0;
     }
</style>