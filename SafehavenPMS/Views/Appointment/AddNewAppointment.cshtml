@model SafehavenPMS.ViewModel.NewAppointmentViewModel

@{
    ViewBag.Title = "New Appointment";
}

<div class="header m-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <i class="bx bxs-calendar-check fs-2 me-2" title="Calendar"></i>
            <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
        </div>
    </div>
    <hr class="mt-0 mb-2" />
</div>

<div id="appointment" class="appointment d-flex flex-column justify-content-center m-auto mt-4">
    <div class="d-flex justify-content-start border-bottom w-100 p-2">
        <i class='bx bx-calendar-check fs-4 me-2 text-primary'></i>
        <h5 class="modal-title fw-bold mb-0">Schedule Appointment</h5>
    </div>

    <div class="row align-items-start m-3">

        <!-- ================= LEFT: Doctor & Calendar ================= -->
        <div class="col-md-6 border-end">

            <!-- Step 1: Select doctor -->
            <form asp-controller="Appointment" asp-action="SelectDoctor" method="post">
                <div class="mb-3">
                    <label class="form-label">Assign Doctor</label>
                    <select asp-for="ClinicalStaffID" asp-items="ViewBag.StaffList" class="form-select" onchange="this.form.submit()">
                        <option value="">--Select Doctor--</option>
                    </select>
                </div>
            </form>

            <!-- Step 2: Show calendar only if doctor is selected -->
            @if (Model.ClinicalStaffID > 0 || Model.ClinicalStaffID == null)
            {
                <form asp-controller="Appointment" asp-action="GetDateAndTimeSlots" method="post" id="dateForm">
                    <input type="hidden" asp-for="ClinicalStaffID" />
                    <input type="hidden" name="SelectedDate" id="selectedDate" />

                    <span class="d-block mb-2 fw-bold">Select Date</span>
                    <div id="datepicker"></div>
                </form>
            }
        </div>

        <!-- ================= RIGHT: Appointment Details ================= -->
        <div class="col-md-6">
        <form asp-controller="Appointment" asp-action="AddNewAppointment" method="post">
            @Html.AntiForgeryToken()

            <!-- Hidden Doctor -->
            <input type="hidden" asp-for="ClinicalStaffID" />

            <!-- Hidden Date -->
            <input type="hidden" asp-for="SelectedDate" id="SelectedDate" />

            <!-- Timeslot -->
            <div class="rounded border p-3">
                <span class="fw-bold d-block mb-2">Timeslot</span>
                @if (ViewBag.AvailableTimes is List<SafehavenPMS.Models.Availability> times && times.Any())
                {
                    <div class="row">
                        @foreach (var slot in times)
                        {
                            <div class="col-6 mb-2">
                                <label class="d-flex align-items-center">
                                    <input type="radio" asp-for="TimeSlot" value="@slot.StartTime" required />
                                    <span class="ms-2">
                                        @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                                    </span>
                                </label>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center">No Available Time</div>
                }
            </div>

            <!-- Patient Info -->
            <div class="mb-3">
                <label asp-for="PatientId" class="form-label"></label>
                <select asp-for="PatientId" asp-items="ViewBag.PatientList" class="form-select">
                    <option value="">--Select Patient--</option>
                </select>
            </div>

            <!-- Visit Type -->
            <div class="mb-3">
                <label asp-for="VisitType" class="form-label"></label>
                <select asp-for="VisitType" class="form-select">
                    <option>--Select--</option>
                    <option value="Medical Assessment">Medical Assessment</option>
                    <option value="Emergency Visit">Emergency Visit</option>
                    <option value="Follow-Up Treatment">Follow-Up Treatment</option>
                    <option value="Others">Others</option>
                </select>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-white border-top">
                <a href="@Url.Action("Index", "Appointment")" class="btn-cancel btn-secondary m-2 text-decoration-none">Cancel</a>
                <button type="submit" class="btn-custom btn-next m-2">Next</button>
            </div>
        </form>

        </div>
    </div>
</div>

@* ===== CSS for Appointment Card & Date Highlight ===== *@
<style>
    .appointment {
        width: 60%;
        background-color: white;
        box-shadow: 0 2px 5px rgba(5, 133, 148, 0.2);
        border-radius: 6px;
    }

    .flatpickr-day.selected {
        background: #007bff;
        border-color: #007bff;
        color: white;
    }

        .flatpickr-day.selected:hover {
            background: #0056b3;
            border-color: #0056b3;
        }
</style>

@* ===== Calendar Script ===== *@
<script>
    flatpickr("#datepicker", {
        inline: true,
        dateFormat: "Y-m-d",
        defaultDate: localStorage.getItem("selectedDate") || new Date(),
        minDate: "today",
        onChange: function (selectedDates, dateStr) {
            // save selected date
            localStorage.setItem("selectedDate", dateStr);

            // assign to hidden input
            document.getElementById("selectedDate").value = dateStr;

            // submit only the calendar form
            document.getElementById("dateForm").submit();
        }
    });

    // ensure stored date is restored on reload
    document.addEventListener("DOMContentLoaded", function () {
        const storedDate = localStorage.getItem("selectedDate");
        if (storedDate) {
            document.getElementById("selectedDate").value = storedDate;
        }
    });

    //Saving staff id to Calendar
    document.getElementById("doctorSelect").addEventListener("change", function() {
        const seletedStaffID = this.value; //Get the value of the passed ID

        //assigned data to hidden input
        document.getElementById("sendIdToCalendar").value = seletedStaffID;

        // If the user already picked a date, submit to refresh available slots
         const storedDate = localStorage.getItem("select  edDate");
            if (selectedStaffId && storedDate) {
                document.getElementById("selectedDate").value = storedDate;
                document.getElementById("dateForm").submit();
            }
    });
</script>
