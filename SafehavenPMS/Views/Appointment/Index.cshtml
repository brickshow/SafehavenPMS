@model SafehavenPMS.ViewModel.AppointmentPageViewModel

@{
    ViewBag.Title = "Appointment Calendar";
}

<div class="container-fluid m-2">
    @* Content Header *@
    <div class="header d-flex justify-content-between">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center g-4">
                <i class='bx bx-calendar-alt fs-4 m-0 p-0'></i>
                <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
            </div>
        </div>
        @* <a href="@Url.Action("AddNewAppointment", "Appointment")" class="btn-custom btn-primary text-decoration-none">
            + New Appointment
        </a> *@
    </div>


    <!-- Calendar container -->
    <div id="appointmentCalendar" class="calendar-container flex-grow-1"></div>



    @* Appointment Details Modal (action dropdown removed) *@
    <div class="modal fade" id="appointmentDetailModal" tabindex="-1" aria-labelledby="appointmentDetailLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header text-white" style="background: linear-gradient(to right, #069FB2, #058594);">
                    <h5 class="modal-title" id="appointmentDetailLabel">Appointment Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>
                        <strong>Status:</strong>
                        <span class="justify-content-end text-center p-2"
                              style="background-color:#BDDBF4; border-radius:6px"
                              id="detailStatus"></span>
                    </p>
                    <p><strong>Patient        :</strong> <span id="detailPatient"></span></p>
                    <p><strong>Doctor         :</strong> <span id="detailDoctor"></span></p>
                    <p><strong>Visit Type     :</strong> <span id="detailVisitType"></span></p>
                    <p><strong>Scheduled Date :</strong> <span id="detailDate"></span></p>
                    <p><strong>Scheduled Time :</strong> <span id="detailTime"></span></p>
                    <p><strong>Description    :</strong> <span id="detailDescription"></span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>




<style>
    .doctor-container {
        border: 1px solid #BFBFBF;
        margin: 20px;
        margin-right: 0;
        margin-bottom: 0;
    }

    .total {
        border: 1px solid #BFBFBF;
        margin: 20px;
        margin-right: 0;
        margin-top: 0;
        margin-bottom: 0;
    }

    .todays-apppointment{
        border: 1px solid #BFBFBF;
        margin: 20px;
        margin-right: 0;
        margin-top: 0;
    }

    .nav-tabs .nav-link {
        color: #767676;
        background-color: transparent;
        border: none;
        font-weight: normal;
    }

        .nav-tabs .nav-link.active {
            color: #00A3B4;
            background-color: transparent;
            border: none;
            border-bottom: 3px solid #00A3B4;
            font-weight: bold;
        }

    /* Calendar container */
    .calendar-container {
        width: 100%;
        transition: width 0.4s ease;
        background: white;
        padding: 20px;
        border-radius: 8px;
    }

    /* Notification panel */
    .notification-panel {
        width: 30%;
        max-width: 500px;
        position: fixed;
        top: 50px; /* adjust as needed */
        right: -100%; /* start hidden off-screen */
        height: calc(100% - 60px);
        overflow-y: auto;
        background-color: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        border-radius: 8px 0 0 8px;
        transition: right 0.4s ease;
        z-index: 1050;
    }

        /* Slide-in state */
        .notification-panel.show {
            right: 0;
        }

    /* Toggle button */
    #toggleNotifications {
        position: fixed;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        z-index: 1060;
        border-radius: 50% 0 0 50%;
        width: 30px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: right 0.4s ease;
    }

        /* When panel is visible, move button off-screen */
        #toggleNotifications.hide {
            right: -30px;
        }

    /* Toggle button styling */
    .toggle-btn {
        position: absolute;
        right: 0;
        top: 20px;
        z-index: 20;
        border-radius: 50% 0 0 50%;
        width: 30px;
        height: 60px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #waitlistedPanel::-webkit-scrollbar {
        width: 8px;
    }

    #waitlistedPanel::-webkit-scrollbar-thumb {
        background-color: #b3dfe5;
        border-radius: 4px;
    }

    #appointmentCalendar {
        max-width: 100%;
        margin: 0 auto;
        background: white;
        padding: 20px;
        border-radius: 8px;
    }

    /* Header styling */
    .fc .fc-toolbar.fc-header-toolbar {
        background: linear-gradient(to right, #069FB2, #058594);
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        margin-bottom: 10px;
    }

    .fc .fc-toolbar-title {
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .fc .fc-daygrid-day-number {
        color: #015F6B;
        font-weight: 600;
    }

    .fc .fc-scrollgrid,
    .fc .fc-scrollgrid td,
    .fc .fc-daygrid-day {
        border-color: #b3dfe5;
    }

    .fc .fc-daygrid-day-frame {
        background-color: #f8fcfc;
    }

    .fc .fc-col-header-cell-cushion {
        color: #015F6B;
        font-weight: 600;
        font-size: 0.95rem;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('appointmentCalendar');
        var selectedDoctors = []; // store selected doctor IDs

        // Initialize FullCalendar
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            height: 'auto',

            // Load events with filtering
            events: function (fetchInfo, successCallback, failureCallback) {
                fetch('/Appointment/GetAppointments')
                    .then(response => response.json())
                    .then(data => {
                        // Filter by selected doctors
                        if (selectedDoctors.length > 0) {
                            data = data.filter(ev =>
                                selectedDoctors.includes(ev.extendedProps.doctorId.toString())
                            );
                        }
                        successCallback(data);
                    })
                    .catch(error => {
                        console.error("Error fetching events:", error);
                        failureCallback(error);
                    });
            },

            eventClick: function (info) {
                info.jsEvent.preventDefault();

                // Populate only display fields (no form actions)
                document.getElementById("detailVisitType").innerText = info.event.extendedProps.visitType;
                document.getElementById("detailTime").innerText = info.event.extendedProps.time;
                document.getElementById("detailDate").innerText = info.event.start.toLocaleDateString("en-us", {
                    month: "long", day: "numeric", year: "numeric"
                });
                document.getElementById("detailStatus").innerText = info.event.extendedProps.status;
                document.getElementById("detailPatient").innerText = info.event.extendedProps.patientName;
                document.getElementById("detailDoctor").innerText = info.event.extendedProps.doctorName;
                document.getElementById("detailDescription").innerText = info.event.extendedProps.description;

                new bootstrap.Modal(document.getElementById('appointmentDetailModal')).show();
            },

            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },

            eventContent: function (info) {
                let status = info.event.extendedProps.status;
                let bgColor = "rgba(200,200,200,0.5)";
                if (status === "Confirmed") bgColor = "#BDDBF4";
                if (status === "Completed") bgColor = "#AEEBAB";
                return {
                    html: `
                        <div class="text-center" style="
                            background-color:${bgColor};
                            width:100%;border-radius:6px;padding:2px;">
                            <strong>${info.event.extendedProps.visitType}</strong><br/>
                            <small>Doctor: ${info.event.extendedProps.doctorName}</small><br/>
                            <small>Patient: ${info.event.extendedProps.patientName}</small><br/>
                            <small>${info.event.extendedProps.time}</small>
                        </div>`
                };
            }
        });

        calendar.render();

        // --- Checkbox filtering ---
        document.querySelectorAll('.doctor-filter').forEach(cb => {
            cb.addEventListener('change', function () {
                selectedDoctors = Array.from(
                    document.querySelectorAll('.doctor-filter:checked')
                ).map(c => c.value);
                calendar.refetchEvents(); // reload calendar events
            });
        });

        // --- "Select All" checkbox ---
        document.getElementById('all').addEventListener('change', function () {
            let allChecked = this.checked;
            document.querySelectorAll('.doctor-filter').forEach(cb => {
                cb.checked = allChecked;
            });
            selectedDoctors = allChecked
                ? Array.from(document.querySelectorAll('.doctor-filter')).map(c => c.value)
                : [];
            calendar.refetchEvents();
        });

        // --- Toggle Notifications Panel ---
        var toggleBtn = document.getElementById('toggleNotifications');
        var waitlistedPanel = document.getElementById('waitlistedPanel');
        var closeBtn = document.getElementById('closeNotifications');
        var indicator = document.getElementById('newAppointmentIndicator');

        // Always show indicator initially (even if count = 0)
        if (indicator) {
            indicator.classList.remove('d-none');
        }

        toggleBtn.addEventListener('click', function () {
            toggleBtn.classList.add('hide');          // Move button off-screen
            waitlistedPanel.classList.add('show');    // Slide panel in
            calendarEl.style.width = "70%";           // Shrink calendar

            if (indicator) {
                indicator.style.display = "none";     // Hide indicator when panel opens
            }
        });

        closeBtn.addEventListener('click', function () {
            toggleBtn.classList.remove('hide');       // Show toggle button
            waitlistedPanel.classList.remove('show'); // Slide panel out
            calendarEl.style.width = "100%";          // Expand calendar

            if (indicator) {
                indicator.style.display = "inline-block"; // Show indicator again when panel closes
            }
        });
    });
</script>


