@{
    ViewBag.Title = "Appointment Calendar";
}

@* Modal for creating a new doctor appointment - slides in from the right *@
<div id="calendar-modal" class="modal fade right-modal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-slideout">
        <div class="modal-content border-0 shadow h-100">

            @* Modal Header *@
            <div class="modal-header bg-white border-bottom">
                <i class='bx bx-calendar-alt fs-4 me-2'></i>
                <h5 class="modal-title fw-bold mb-0">New Doctor Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @* Date Summary Block *@
            <div class="border-bottom px-4 py-2 bg-light-subtle">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <a href="#" id="openCalendarPopover" class="fw-bold text-custom">Tue, 22 Jul</a><br />

                        <small>04:00 AM - 10:00 AM</small>
                    </div>
                </div>
            </div>

            @*Add here the calendar*@
            @* Appointment Picker Block *@
            <div class="px-4 pt-3 border-bottom" id="calendarBlock">
                <div class="d-flex">
                    @* Date Picker *@
                    <div class="me-4" style="width: 50%;">
                        <label class="form-label fw-semibold mb-2">Select Date</label>
                        <input type="text" id="appointmentDate" class="form-control mb-3" placeholder="Pick a date">
                    </div>

                   @* Time Picker *@
                    <div class="flex-grow-1">
                        <label class="form-label fw-semibold mb-2">Available Times</label>
                        <div class="d-flex flex-wrap gap-2" id="availableTimes">
                            @* Time buttons will go here *@
                        </div>
                        <small class="text-muted mt-2 d-block" id="noTimesMsg" style="display: none;">No available times found</small>
                    </div>
                </div>
            </div>

            @* Modal Body *@
            <div class="modal-body px-4 py-3 overflow-auto">
                <h6 class="fw-bold mb-3">Appointment Details</h6>

                @* Search for patient  *@
                <div class="mb-3 position-relative">
                    <label class="form-label">Patient</label>
                    <input type="text" id="patientSearch" class="form-control" placeholder="Type patient name...">
                    <div id="suggestions" class="list-group position-absolute w-100 shadow" style="z-index: 1000;"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Assigned Doctor</label>
                    <select class="form-select" disabled>
                        <option selected>Dr. Marlo Arante</option>
                    </select>
                </div>

                @* Add condition depending on Doctor's Position *@
                @* If The doctor is physician *@
                <div class="mb-3">
                    <label class="form-label">Visit Type</label>
                    <select class="form-select">
                        <option disabled selected>--Select--</option>
                        <option>Medical Assessment</option>
                        <option>Emergency Visit</option>
                        <option>Follow-Up Treatment</option>
                        <option>Others</option>
                    </select>
                </div>

                @* if the doctor is Psychiatrist *@
                <div class="mb-3" style="display:none">
                    <label class="form-label">Visit Type</label>
                    <select class="form-select">
                        <option disabled selected>--Select--</option>
                        <option>Psychiatric Evaluation</option>
                        <option>Medication Review</option>
                        <option>Follow-Up Treatment</option>
                        <option>Others</option>
                    </select>
                </div>

                <div class="mb-3">
                    <a href="#" class="text-custom fw-semibold d-block mb-2 text-decoration-none">+ Add Description</a>
                    <textarea class="form-control" rows="3" maxlength="1000" placeholder="Write here..."></textarea>
                    <small class="text-muted">0/1000</small>
                </div>
            </div>

            <div class="modal-footer bg-white border-top">
                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal" aria-label="Close">Cancel</button>
                <button type="button" class="btn btn-next text-white px-4">Create</button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mt-0">
    @* Content Header *@
    <div class="header d-flex justify-content-between">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center g-4">
                <i class='bx bx-calendar-alt fs-4 m-0 p-0'></i>
                <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
            </div>
        </div>
        <a href="#" class="btn-custom btn-primary text-decoration-none" data-bs-toggle="modal" data-bs-target="#calendar-modal">
            + New
        </a>
    </div>
    @* Tabs *@
    <ul class="nav nav-tabs mb-4" id="staffTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="calendar-tab" data-bs-toggle="tab" data-bs-target="#calendar"
                    type="button" role="tab" aria-controls="calendar" aria-selected="true">
                Calendar
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="availability-tab" data-bs-toggle="tab" data-bs-target="#availability"
                    type="button" role="tab" aria-controls="availability" aria-selected="false">
                Availability
            </button>
        </li>
    </ul>


    @* Tab Content *@
    <div class="tab-content" id="staffTabContent">
        <div class="tab-pane fade show active" id="calendar" role="tabpanel" aria-labelledby="calendar-tab">
            @await Html.PartialAsync("_Calendar")
        </div>

        <div class="tab-pane fade" id="availability" role="tabpanel" aria-labelledby="availability-tab">
            @await Html.PartialAsync("_Availability")
        </div>
    </div>
</div>




<style>
    .nav-tabs .nav-link {
        color: #767676;
        background-color: transparent;
        border: none;
        font-weight: normal;
    }

        .nav-tabs .nav-link.active {
            color: #00A3B4;
            background-color: transparent;
            border: none;
            border-bottom: 3px solid #00A3B4;
            font-weight: bold;
        }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>


<script>
    $(document).ready(function () {
        const patients = [
            "Sha Sha Ramos",
            "Shawn Rivera",
            "Maria Ramos",
            "Ramos Dela Cruz",
            "Dr. Sha",
            "Ramiro Santos"
        ];

        $('#patientSearch').on('input', function () {
            const input = $(this).val().toLowerCase();
            const filtered = patients.filter(name => name.toLowerCase().includes(input));

            if (input && filtered.length > 0) {
                const listItems = filtered.map(name =>
                    `<a href="#" class="list-group-item list-group-item-action">${name}</a>`
                ).join('');
                $('#suggestions').html(listItems).show();
            } else {
                $('#suggestions').hide();
            }
        });

        $('#suggestions').on('click', 'a', function (e) {
            e.preventDefault();
            $('#patientSearch').val($(this).text());
            $('#suggestions').hide();
        });

        $('#patientSearch').on('blur', function () {
            setTimeout(() => $('#suggestions').hide(), 150);
        });
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-..." crossorigin="anonymous"></script>