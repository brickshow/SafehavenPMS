@model SafehavenPMS.ViewModel.AppointmentPageViewModel

@{
    ViewBag.Title = "Appointment Calendar";
}

<div class="container-fluid m-2">
    @* Content Header *@
    <div class="header d-flex justify-content-between">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center g-4">
                <i class='bx bx-calendar-alt fs-4 m-0 p-0'></i>
                <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
            </div>
        </div>
        <a href="@Url.Action("AddNewAppointment", "Appointment")" class="btn-custom btn-primary text-decoration-none">
            + New Appointment
        </a>
    </div>

    <div class="d-flex position-relative mt-3">

        <div class="bg-white w-25">
            @* List of Doctors *@
            <div class="doctor-container p-4">
                <div class="title" style="color:#015F6B">
                    <strong>Doctors</strong>
                </div>

                @* "Select All" checkbox *@
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="all">
                    <label class="form-check-label" for="all">
                        All
                    </label>
                </div>

                @* Dynamic doctor list *@
                @foreach (var doctor in ViewBag.Doctors)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input doctor-filter" type="checkbox"
                               id="doctor_@doctor.ClinicalStaffID"
                               value="@doctor.ClinicalStaffID"
                               name="SelectedDoctors">
                        <label class="form-check-label" for="doctor_@doctor.ClinicalStaffID">
                            Dr. @doctor.Firstname @doctor.Lastname
                        </label>
                    </div>
                }

            </div>


            @* Total of each doctor *@
            <div class="total p-4">
                <div style="display: flex; justify-content: space-between; color: #015F6B;">
                    <span><strong>Assigned Patients</strong></span>
                    <span>23</span>
                </div>
                <div style="display: flex; justify-content: space-between; color: #015F6B;">
                    <span><strong>Appointments</strong></span>
                    <span>23</span>
                </div>
            </div>

            @* Todays Appointment *@
            <div class="todays-apppointment p-4">
                <div class="title" style="color:#015F6B"><strong>Today's Appointment</strong></div>
                <div style="margin-bottom: 5px;">
                    <span style="display: inline-block; width: 20px; height: 20px; background: #d3d3d3; border-radius: 50%; margin-right: 10px;"></span>
                    <span>Sha Sha Ramos</span>
                    <span style="float: right;">></span>
                </div>
                <div style="margin-bottom: 5px;">
                    <span style="display: inline-block; width: 20px; height: 20px; background: #d3d3d3; border-radius: 50%; margin-right: 10px;"></span>
                    <span>Sha Sha Ramos</span>
                    <span style="float: right;">></span>
                </div>
                <div>
                    <span style="display: inline-block; width: 20px; height: 20px; background: #d3d3d3; border-radius: 50%; margin-right: 10px;"></span>
                    <span>Sha Sha Ramos</span>
                    <span style="float: right;">></span>
                </div>
            </div>
        </div>

        <!-- Calendar container -->
        <div id="appointmentCalendar" class="calendar-container flex-grow-1"></div>

        @* Waitlisted panel *@
        <div id="waitlistedPanel" class="notification-panel rounded bg-white">
            <div class="d-flex flex-row justify-content-between p-3" style="background: linear-gradient(to right, #069FB2, #058594);">
                <h5 class="fw-bold">Waitlisted</h5>
                <button type="button" class="btn-close" id="closeNotifications" aria-label="Close"></button>
            </div>

            @if (Model != null && Model.WaitlistedPatients.Any())
            {
                <div class="px-3 py-2 text-muted fst-italic">(@Model.WaitlistedPatients.Count) Patients</div>
                @foreach (var patient in Model.WaitlistedPatients)
                {
                    <div class="card mb-3 border-0 m-2" style="box-shadow: 0 0 0 1px #d6e9ee inset;">
                        <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:40px;height:40px;background:#e9f4f6;color:#6c757d;">
                                    <i class="bx bxs-user" style="font-size:22px;"></i>
                                </div>
                                <div class="d-flex flex-column">
                                    <span class="fw-semibold">@patient.Firstname @patient.Lastname</span>
                                    <small class="text-muted">Date Added: @patient.DateOfReferral.ToString("MM-dd-yy")</small>
                                </div>
                            </div>
                            <div class="dropdown">
                                <a href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bx bx-dots-vertical fs-5 text-muted"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 px-2 py-2 rounded-3" style="min-width: 200px;">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" 
                                        href="@Url.Action("Profile","Patient", new { id = patient.PatientId })">View Profile</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                         href="@Url.Action("AddNewAppointment","Appointment", new { id = patient.PatientId })">Schedule Assessment</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center">No waitlisted</div>
            }

        </div>

        <!-- Toggle button -->
        <button id="toggleNotifications" class="btn-custom btn-primary"
                data-bs-toggle="tooltip" data-bs-placement="left" title="Show Notifications">
            &lt;
            <span id="newAppointmentIndicator"
                  class="position-absolute top-0 start-0 translate-middle bg-danger border border-light rounded-circle d-flex align-items-center justify-content-center"
                  style="width:18px; height:18px; font-size:12px;">
                @Model?.WaitlistedPatients.Count
            </span>
        </button>
    </div>

    @* Modal to confirm cancellation
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-contentIndex PatientProfileiv class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteConfirmLabel">Confirm Deletion</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </divScheduleAppointment<div class="modal-body">
                    Are you sure you want to Cancel this Appointment? This action cannot be undone.
                </div>
                <div class="modal-footer">
                    <form asp-action="Cancel" asp-controller="Appointment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="dayIdToDelete" name="id" />
                        <button type="button" class="btn-cancel btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-next btn-danger">Confirm</button>
                    </form>
                </div>
            </div>
        </div>
    </div> *@

  @*   Modal to confirm Appointment
    <div class="modal fade" id="ConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header text-white" style="background: linear-gradient(to right, #069FB2, #058594);">
                    <h5 class="modal-title" id="deleteConfirmLabel">Confirm Appointment</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Do you want to confirm this appointment?
                </div>
                <div class="modal-footer">
                    <form asp-action="Confirm" asp-controller="Appointment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="dayIdToDelete" name="id" />
                        <button type="button" class="btn-cancel btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-next btn-danger">Confirm</button>
                    </form>
                </div>
            </div>
        </div>
    </div> *@


    @* Appointment Details Modal *@
    <div class="modal fade" id="appointmentDetailModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header text-white d-flex justify-content-between" style="background: linear-gradient(to right, #069FB2, #058594);">
                    <h5 class="modal-title">Appointment Details</h5>
                    <div class="dropdown" data-bs-display="static">
                        <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bx bx-dots-vertical fs-5 text-muted"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 px-2 py-2 rounded-3" style="min-width: 220px;">
                            <li class="px-2 text-muted fw-semibold small">Options</li>
                            @* Add condition that if current session log is Admin show all *@

                            @* Mark as Completed Form *@
                            <li>
                                <form asp-action="Completed" asp-controller="Appointment" method="post" class="d-inline">
                                    <input type="hidden" name="id" id="ApointmentId" />
                                    <input type="hidden" name="patientId" id="patientId" />
                                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2">
                                        Mark as Completed
                                    </button>
                                </form>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" href="#">Open Assessment Form</a>
                            </li>
                            <li>
                                <a id="rescheduleLink" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                   href="#">
                                    Reschedule Appointment
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" href="#">Cancel Appointment</a>
                            </li>

                            @* <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" href="#">Create New Appointment</a>
                            </li>
                         *@

                        </ul>
                    </div>
                </div>
                <div class="modal-body">
                    <p>
                        <strong>Status:</strong>
                        <span class="justify-content-end text-center p-2" style="background-color:#BDDBF4; border-radius:6px" id="detailStatus"></span>
                    </p>
                    <p><strong>Patient        :</strong> <span id="detailPatient"></span></p>
                    <p><strong>Doctor         :</strong> <span id="detailDoctor"></span></p>
                    <p><strong>Visit Type     :</strong> <span id="detailVisitType"></span></p>
                    <p><strong>Scheduled Date :</strong> <span id="detailDate"></span></p>
                    <p><strong>Scheduled Time :</strong> <span id="detailTime"></span></p>
                    <p><strong>Description :</strong> <span id="detailDescription"></span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>




<style>
    .doctor-container {
        border: 1px solid #BFBFBF;
        margin: 20px;
        margin-right: 0;
        margin-bottom: 0;
    }

    .total {
        border: 1px solid #BFBFBF;
        margin: 20px;
        margin-right: 0;
        margin-top: 0;
        margin-bottom: 0;
    }

    .todays-apppointment{
        border: 1px solid #BFBFBF;
        margin: 20px;
        margin-right: 0;
        margin-top: 0;
    }

    .nav-tabs .nav-link {
        color: #767676;
        background-color: transparent;
        border: none;
        font-weight: normal;
    }

        .nav-tabs .nav-link.active {
            color: #00A3B4;
            background-color: transparent;
            border: none;
            border-bottom: 3px solid #00A3B4;
            font-weight: bold;
        }

    /* Calendar container */
    .calendar-container {
        width: 100%;
        transition: width 0.4s ease;
        background: white;
        padding: 20px;
        border-radius: 8px;
    }

    /* Notification panel */
    .notification-panel {
        width: 30%;
        max-width: 500px;
        position: fixed;
        top: 50px; /* adjust as needed */
        right: -100%; /* start hidden off-screen */
        height: calc(100% - 60px);
        overflow-y: auto;
        background-color: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        border-radius: 8px 0 0 8px;
        transition: right 0.4s ease;
        z-index: 1050;
    }

        /* Slide-in state */
        .notification-panel.show {
            right: 0;
        }

    /* Toggle button */
    #toggleNotifications {
        position: fixed;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        z-index: 1060;
        border-radius: 50% 0 0 50%;
        width: 30px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: right 0.4s ease;
    }

        /* When panel is visible, move button off-screen */
        #toggleNotifications.hide {
            right: -30px;
        }

    /* Toggle button styling */
    .toggle-btn {
        position: absolute;
        right: 0;
        top: 20px;
        z-index: 20;
        border-radius: 50% 0 0 50%;
        width: 30px;
        height: 60px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #waitlistedPanel::-webkit-scrollbar {
        width: 8px;
    }

    #waitlistedPanel::-webkit-scrollbar-thumb {
        background-color: #b3dfe5;
        border-radius: 4px;
    }

    #appointmentCalendar {
        max-width: 100%;
        margin: 0 auto;
        background: white;
        padding: 20px;
        border-radius: 8px;
    }

    /* Header styling */
    .fc .fc-toolbar.fc-header-toolbar {
        background: linear-gradient(to right, #069FB2, #058594);
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        margin-bottom: 10px;
    }

    .fc .fc-toolbar-title {
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .fc .fc-daygrid-day-number {
        color: #015F6B;
        font-weight: 600;
    }

    .fc .fc-scrollgrid,
    .fc .fc-scrollgrid td,
    .fc .fc-daygrid-day {
        border-color: #b3dfe5;
    }

    .fc .fc-daygrid-day-frame {
        background-color: #f8fcfc;
    }

    .fc .fc-col-header-cell-cushion {
        color: #015F6B;
        font-weight: 600;
        font-size: 0.95rem;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('appointmentCalendar');
        var selectedDoctors = []; // store selected doctor IDs

        // Initialize FullCalendar
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            height: 'auto',

            // Load events with filtering
            events: function (fetchInfo, successCallback, failureCallback) {
                fetch('/Appointment/GetAppointments')
                    .then(response => response.json())
                    .then(data => {
                        // Filter by selected doctors
                        if (selectedDoctors.length > 0) {
                            data = data.filter(ev =>
                                selectedDoctors.includes(ev.extendedProps.doctorId.toString())
                            );
                        }
                        successCallback(data);
                    })
                    .catch(error => {
                        console.error("Error fetching events:", error);
                        failureCallback(error);
                    });
            },

            eventClick: function (info) {
                info.jsEvent.preventDefault();

                document.getElementById("ApointmentId").value = info.event.id;
                document.getElementById("patientId").value = info.event.extendedProps.patientId;
                document.getElementById("detailVisitType").innerText = info.event.extendedProps.visitType;
                document.getElementById("detailTime").innerText = info.event.extendedProps.time;
                document.getElementById("detailDate").innerText = info.event.start.toLocaleDateString("en-us", {
                    month: "long", day: "numeric", year: "numeric"
                });
                document.getElementById("detailStatus").innerText = info.event.extendedProps.status;
                document.getElementById("detailPatient").innerText = info.event.extendedProps.patientName;
                document.getElementById("detailDoctor").innerText = info.event.extendedProps.doctorName;
                document.getElementById("detailDescription").innerText = info.event.extendedProps.description;

                const rescheduleLink = document.getElementById('rescheduleLink');
                rescheduleLink.href = `/Appointment/ScheduleAppointment?id=${info.event.extendedProps.patientId}`;

                var appointmentDetailModal = new bootstrap.Modal(document.getElementById('appointmentDetailModal'));
                appointmentDetailModal.show();
            },

            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },

            eventContent: function (info) {
                let visitType = info.event.extendedProps.visitType;
                let patient = info.event.extendedProps.patientName;
                let doctor = info.event.extendedProps.doctorName;
                let status = info.event.extendedProps.status;
                let time = info.event.extendedProps.time;

                let bgColor = "rgba(200,200,200,0.5)";
                if (status === "Confirmed") bgColor = "#BDDBF4";
                if (status === "Completed") bgColor = "#AEEBAB";

                return {
                    html: `
                        <div class="text-center" style="
                            background-color: ${bgColor};
                            width: 100%;
                            box-sizing: border-box;
                            border-radius: 6px;
                            white-space: normal;
                            word-wrap: break-word;
                            overflow-wrap: break-word;
                            padding: 2px;
                        ">
                            <strong>${visitType}</strong><br/>
                            <small>Doctor: ${doctor}</small><br/>
                            <small>Patient: ${patient}</small><br/>
                            <small>${time}</small><br/>
                        </div>
                    `
                };
            }
        });

        calendar.render();

        // --- Checkbox filtering ---
        document.querySelectorAll('.doctor-filter').forEach(cb => {
            cb.addEventListener('change', function () {
                selectedDoctors = Array.from(
                    document.querySelectorAll('.doctor-filter:checked')
                ).map(c => c.value);
                calendar.refetchEvents(); // reload calendar events
            });
        });

        // --- "Select All" checkbox ---
        document.getElementById('all').addEventListener('change', function () {
            let allChecked = this.checked;
            document.querySelectorAll('.doctor-filter').forEach(cb => {
                cb.checked = allChecked;
            });
            selectedDoctors = allChecked
                ? Array.from(document.querySelectorAll('.doctor-filter')).map(c => c.value)
                : [];
            calendar.refetchEvents();
        });

        // --- Toggle Notifications Panel ---
        var toggleBtn = document.getElementById('toggleNotifications');
        var waitlistedPanel = document.getElementById('waitlistedPanel');
        var closeBtn = document.getElementById('closeNotifications');
        var indicator = document.getElementById('newAppointmentIndicator');

        // Always show indicator initially (even if count = 0)
        if (indicator) {
            indicator.classList.remove('d-none');
        }

        toggleBtn.addEventListener('click', function () {
            toggleBtn.classList.add('hide');          // Move button off-screen
            waitlistedPanel.classList.add('show');    // Slide panel in
            calendarEl.style.width = "70%";           // Shrink calendar

            if (indicator) {
                indicator.style.display = "none";     // Hide indicator when panel opens
            }
        });

        closeBtn.addEventListener('click', function () {
            toggleBtn.classList.remove('hide');       // Show toggle button
            waitlistedPanel.classList.remove('show'); // Slide panel out
            calendarEl.style.width = "100%";          // Expand calendar

            if (indicator) {
                indicator.style.display = "inline-block"; // Show indicator again when panel closes
            }
        });
    });
</script>


