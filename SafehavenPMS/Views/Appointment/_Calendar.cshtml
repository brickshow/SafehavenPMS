@model List<SafehavenPMS.ViewModel.AppointmentPendingApprovalViewModel>

<div class="d-flex position-relative mt-3">
    <!-- Calendar container -->
    <div id="appointmentCalendar" class="calendar-container flex-grow-1"></div>

    <!-- Notification panel -->
    <div id="notificationPanel" class="notification-panel rounded p-3 bg-white">
        <div class="d-flex flex-row justify-content-between">
            <h5 class="fw-bold text-custom">New Appointments</h5>
            <button type="button" class="btn-close" id="closeNotifications" aria-label="Close"></button>
        </div>

        @if (Model != null && Model.Any())
        {
            @foreach (var appointment in Model)
            {
                <div class="notification-item card mb-3">
                    <div class="card-body p-2">
                        <div class="col-md-12 d-flex flex-row mb-3">
                            <div class="d-flex col-md-8 flex-column">
                                <span><strong>Patient:</strong> @appointment.PatientName</span>
                                <span><strong>Doctor:</strong> @appointment.DoctorName</span>
                                <span><strong>Visit Type:</strong> @appointment.VisitType</span>
                                <span><strong>Date :</strong> @appointment.AppointmentDate.ToString("MM/dd/yyyy")</span>
                            </div>
                            <div class="col-md-4 justify-content-end">
                                @if(appointment.Status == "Pending")
                                {
                                    <div class="justify-content-end text-center" style="background-color:#F0EFBC; border-radius:6px">
                                        @appointment.Status
                                    </div>
                                }
                               
                            </div>
                        </div>  
                        <div class="d-flex gap-2">
                            <button data-id="@appointment.AppointmentId" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal" type="button" class="btn-cancel flex-fill">Cancel</button>
                            <button data-id="@appointment.AppointmentId" data-bs-toggle="modal" data-bs-target="#ConfirmModal" type="button" class="btn-next flex-fill">Confirm</button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center">No pending appointments.</div>
        }

    </div>

    <!-- Toggle button -->
    <button id="toggleNotifications" class="btn-custom btn-primary" data-bs-toggle="tooltip" data-bs-placement="left" title="Show Notifications">&lt;</button>
</div>

@* Modal to confirm cancellation *@
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteConfirmLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to Cancel this Appointment? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <form asp-action="Cancel" asp-controller="Appointment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="dayIdToDelete" name="id" />
                    <button type="button" class="btn-cancel btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-next btn-danger">Confirm</button>
                </form>
            </div>
        </div>
    </div>
</div>

@* Modal to confirm Appointment *@
<div class="modal fade" id="ConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" style="background: linear-gradient(to right, #069FB2, #058594);">
                <h5 class="modal-title" id="deleteConfirmLabel">Confirm Appointment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Do you want to confirm this appointment?
            </div>
            <div class="modal-footer">
                <form asp-action="Confirm" asp-controller="Appointment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="dayIdToDelete" name="id" />
                    <button type="button" class="btn-cancel btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-next btn-danger">Confirm</button>
                </form>
            </div>
        </div>
    </div>
</div>


@* Appointment Details Modal *@
<div class="modal fade" id="appointmentDetailModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white d-flex justify-content-between" style="background: linear-gradient(to right, #069FB2, #058594);">
                <h5 class="modal-title">Appointment Details</h5>
                <div class="dropdown" data-bs-display="static">
                    <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bx bx-dots-vertical fs-5 text-muted"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 px-2 py-2 rounded-3" style="min-width: 220px;">
                        <li class="px-2 text-muted fw-semibold small">Options</li>
                        @* Add condition that if current session log is Admin show all *@

                        @* Mark as Completed Form *@
                        <li>
                            <form asp-action="Completed" asp-controller="Appointment" method="post" class="d-inline">
                                <input type="hidden" name="id" id="ApointmentId" />
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2">
                                    Mark as Completed
                                </button>
                            </form>
                        </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" href="#">Open Assessment Form</a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" href="#">Reschedule Appointment</a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" href="#">Cancel Appointment</a>
                            </li>
                 
                            <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" href="#">Create New Appointment</a>
                            </li>
                        

                    </ul>
                </div>
            </div>
            <div class="modal-body">
                <p>
                    <strong>Status:</strong>
                    <span class="justify-content-end text-center p-2" style="background-color:#BDDBF4; border-radius:6px" id="detailStatus"></span>
                </p>
                <p><strong>Patient        :</strong> <span id="detailPatient"></span></p>
                <p><strong>Doctor         :</strong> <span id="detailDoctor"></span></p>
                <p><strong>Visit Type     :</strong> <span id="detailVisitType"></span></p>
                <p><strong>Scheduled Date :</strong> <span id="detailDate"></span></p>
                <p><strong>Scheduled Time :</strong> <span id="detailTime"></span></p>
                <p><strong>Description :</strong> <span id="detailDescription"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<style>
    /* Calendar container */
    .calendar-container {
        width: 100%;
        transition: width 0.4s ease;
        background: white;
        padding: 20px;
        border-radius: 8px;
    }

    /* Notification panel */
    .notification-panel {
        width: 30%;
        max-width:500px;
        position: fixed;
        top: 50px; /* adjust as needed */
        right: -100%; /* start hidden off-screen */
        height: calc(100% - 60px);
        overflow-y: auto;
        background-color: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        border-radius: 8px 0 0 8px;
        transition: right 0.4s ease;
        z-index: 1050;
    }

        /* Slide-in state */
        .notification-panel.show {
            right: 0;
        }

    /* Toggle button */
    #toggleNotifications {
        position: fixed;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        z-index: 1060;
        border-radius: 50% 0 0 50%;
        width: 30px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: right 0.4s ease;
    }

        /* When panel is visible, move button off-screen */
        #toggleNotifications.hide {
            right: -30px;
        }

    /* Toggle button styling */
    .toggle-btn {
        position: absolute;
        right: 0;
        top: 20px;
        z-index: 20;
        border-radius: 50% 0 0 50%;
        width: 30px;
        height: 60px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    #notificationPanel::-webkit-scrollbar {
        width: 8px;
    }

    #notificationPanel::-webkit-scrollbar-thumb {
        background-color: #b3dfe5;
        border-radius: 4px;
    }
    #appointmentCalendar {
        max-width: 100%;
        margin: 0 auto;
        background: white;
        padding: 20px;
        border-radius: 8px;
    }

    /* Header styling */
    .fc .fc-toolbar.fc-header-toolbar {
        background: linear-gradient(to right, #069FB2, #058594);
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        margin-bottom: 10px;
    }

    .fc .fc-toolbar-title {
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .fc .fc-daygrid-day-number {
        color: #015F6B;
        font-weight: 600;
    }

    .fc .fc-scrollgrid,
    .fc .fc-scrollgrid td,
    .fc .fc-daygrid-day {
        border-color: #b3dfe5;
    }

    .fc .fc-daygrid-day-frame {
        background-color: #f8fcfc;
    }

    .fc .fc-col-header-cell-cushion {
        color: #015F6B;
        font-weight: 600;
        font-size: 0.95rem;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<script>
    // Wait until the DOM is fully loaded before running the script
    document.addEventListener('DOMContentLoaded', function () {
        // Get the calendar container element by its ID
        var calendarEl = document.getElementById('appointmentCalendar');

        // Initialize the FullCalendar instance
          var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        height: 'auto',

        // Load events from backend
        events: function(fetchInfo, successCallback, failureCallback) {
            fetch('/Appointment/GetAppointments')
                .then(response => response.json())
                .then(data => {
                    console.log("Fetched events:", data);
                    successCallback(data);
                })
                .catch(error => {
                    console.error("Error fetching events:", error);
                    failureCallback(error);
                });
        },

        eventClick: function(info) {
            info.jsEvent.preventDefault();

            document.getElementById("ApointmentId").value = info.event.id; 
            document.getElementById("detailVisitType").innerText = info.event.extendedProps.visitType;
            document.getElementById("detailTime").innerText = info.event.extendedProps.time;
            document.getElementById("detailDate").innerText = info.event.start.toLocaleDateString("en-us", {
                month: "long", day: "numeric", year: "numeric"
            });
            document.getElementById("detailStatus").innerText = info.event.extendedProps.status;
            document.getElementById("detailPatient").innerText = info.event.extendedProps.patientName;
            document.getElementById("detailDoctor").innerText = info.event.extendedProps.doctorName;
            document.getElementById("detailDescription").innerText = info.event.extendedProps.description;

            var appointmentDetailModal = new bootstrap.Modal(document.getElementById('appointmentDetailModal'));
            appointmentDetailModal.show();
        },

        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay'
        },

        selectable: false,

        // Customize event display
        eventContent: function(info) {
            let visitType = info.event.extendedProps.visitType;
            let patient = info.event.extendedProps.patientName;
            let doctor = info.event.extendedProps.doctorName;
            let status = info.event.extendedProps.status;
            let time = info.event.extendedProps.time;

            // Set color based on status
            let bgColor = "rgba(200, 200, 200, 0.5)";
            if (status === "Confirmed") bgColor = "#BDDBF4";
            if (status === "Completed") bgColor = "#AEEBAB";

            return {
                html: `
                    <div class="text-center" style="
                        background-color: ${bgColor};
                        width: 100%;
                        box-sizing: border-box;
                        border-radius: 6px;
                        white-space: normal;
                        word-wrap: break-word;
                        overflow-wrap: break-word;
                        padding: 2px;
                    ">
                        <strong>${visitType}</strong><br/>
                        <small>Doctor: ${doctor}</small><br/>
                        <small>Patient: ${patient}</small><br/>
                        <small>${time}</small><br/>
                    </div>
                `
            };
        },

        dayCellDidMount: function(info) {
            const today = new Date();
            const cellDate = info.date;

            if (
                cellDate.getFullYear() === today.getFullYear() &&
                cellDate.getMonth() === today.getMonth() &&
                cellDate.getDate() === today.getDate()
            ) {
                info.el.style.backgroundColor = '#fff4e5';
                info.el.style.border = '2px solid #00A3B4';
                info.el.style.borderRadius = '8px';
            }
        }
    });

    // Render the calendar
    calendar.render();


        // Render the calendar inside the container
        calendar.render();
    });


     var toggleBtn = document.getElementById('toggleNotifications');
    var notificationPanel = document.getElementById('notificationPanel');
    var closeBtn = document.getElementById('closeNotifications');
    var calendar = document.getElementById('appointmentCalendar');

    toggleBtn.addEventListener('click', function() {
        toggleBtn.classList.add('hide');          // Move button off-screen
        notificationPanel.classList.add('show'); // Slide panel in
        calendar.style.width = "70%";             // Shrink calendar
    });

    closeBtn.addEventListener('click', function() {
        toggleBtn.classList.remove('hide');      // Show toggle button
        notificationPanel.classList.remove('show'); // Slide panel out
        calendar.style.width = "100%";           // Expand calendar
    });

     // For Cancel modal
    const cancelModal = document.getElementById('deleteConfirmModal');
    cancelModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget; // Button that triggered the modal
        const id = button.getAttribute('data-id'); // Extract info from data-id
        cancelModal.querySelector('#dayIdToDelete').value = id;
    });

    // For Confirm modal
    const confirmModal = document.getElementById('ConfirmModal');
    confirmModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const id = button.getAttribute('data-id');
        confirmModal.querySelector('#dayIdToDelete').value = id;
    });
</script>
