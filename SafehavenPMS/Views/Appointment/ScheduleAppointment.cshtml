@model SafehavenPMS.ViewModel.AppointmentViewModel

@{
    ViewBag.Title = "Appointment";
}

<div class="header">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <i class="bx bxs-calendar-check fs-2 me-2" title="Calendar"></i>
            <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
        </div>
    </div>
    <hr class="mt-0 mb-2" />
</div>

<div id="appointment" class="appointment d-flex flex-column justify-content-center m-auto mt-4">
    @* Section header *@
    <div class="d-flex justify-content-start border-bottom w-100 p-2">
        <i class='bx bx-calendar-check fs-4 me-2 text-primary'></i>
        <h5 class="modal-title fw-bold mb-0">Schedule Appointment</h5>
    </div>

    <div class="row align-items-start m-3">
        <!-- ================= LEFT: Calendar ================= -->
        <div class="col-md-6 border-end">
            @* Calendar Form (submits only selected date) *@
            <form asp-controller="Appointment" asp-action="SubmitDate" method="post" id="dateForm">
                <span class="d-block mb-2 fw-bold">Select Date</span>

                @* Hidden fields to pass date + context *@
                <input type="hidden" name="SelectedDate" id="selectedDate" />
                <input type="hidden" name="PatientId" value="@Model?.PatientId" />
                <input type="hidden" name="ClinicalStaffID" value="@Model?.ClinicalStaffID" />

                <div id="datepicker"></div>
            </form>
        </div>

        <!-- ================= RIGHT: Appointment Details ================= -->
        <div class="col-md-6">
            @* Appointment Form (submits schedule details) *@
            <form asp-controller="Appointment" asp-action="ScheduleAppointment" method="post" id="appointmentForm">

                <span class="d-block mb-2 fw-bold">Available Time</span>
                <div class="d-flex flex-column border rounded p-3 mb-3">
                    <div class="row">
                        <input type="hidden" asp-for="PatientId" />
                        <input type="hidden" asp-for="ClinicalStaffID" />
                        <input type="hidden" name="SelectedDate" id="selectedDate"
                               value="@(ViewBag.SelectedDate ?? Model.SelectedDate.ToString("yyyy-MM-dd"))"
                               asp-for="SelectedDate" />
                        @if (ViewBag.AvailableTimes != null && ((IEnumerable<object>)ViewBag.AvailableTimes).Cast<dynamic>().Any())
                        {
                            foreach (var slot in (IEnumerable<dynamic>)ViewBag.AvailableTimes)
                            {
                                <div class="col-6 mb-2">
                                    <label class="d-flex align-items-center">
                                        <input type="radio" name="AvailabilityId" value="@slot.AvailabilityId" required />
                                        <span class="ms-2">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</span>
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted">No Available Time</div>
                        }
                    </div>
                </div>

                <!-- Patient Info -->
                <div class="mb-3">
                    <label class="form-label">Patient Name</label>
                    <input asp-for="PatientName" type="text" class="form-control" value="@Model.PatientName" disabled />
                </div>

                <div class="mb-3">
                    <label class="form-label">Assign Doctor </label>
                    <input asp-for="ClinicalStaffName" type="text" class="form-control" value="@Model.ClinicalStaffName" disabled />
                </div>

                <!-- Visit Details -->
                <div class="mb-3">
                    <label class="form-label">Visit Type</label>
                    <select asp-for="VisitType" class="form-select" required>
                        <option value="">--Select--</option>
                        <option value="Medical Assessment">Medical Assessment</option>
                        <option value="Emergency Visit">Emergency Visit</option>
                        <option value="Follow-Up Treatment">Follow-Up Treatment</option>
                        <option value="Others">Others</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Add Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Additional notes..."></textarea>
                </div>

                <!-- Footer -->
                <div class="modal-footer bg-white border-top">
                    <a href="@Url.Action("Index", "Patient")" class="btn-cancel btn-secondary m-2 text-decoration-none">Cancel</a>
                    <button type="submit" class="btn-custom btn-next m-2">Next</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ===== CSS for Appointment Card & Date Highlight ===== *@
<style>
    .appointment {
        width:60%;
        background-color: white;
        box-shadow: 0 2px 5px rgba(5, 133, 148, 0.2);
        border-radius: 6px;
    }

    .flatpickr-day.selected {
        background: #007bff;
        border-color: #007bff;
        color: white;
    }

        .flatpickr-day.selected:hover {
            background: #0056b3;
            border-color: #0056b3;
        }
</style>

@* ===== Calendar Script ===== *@
<script>
    flatpickr("#datepicker", {
        inline: true,
        dateFormat: "Y-m-d",
        defaultDate: localStorage.getItem("selectedDate") || new Date(),
        minDate: "today",
        onChange: function (selectedDates, dateStr) {
            // save selected date
            localStorage.setItem("selectedDate", dateStr);

            // assign to hidden input
            document.getElementById("selectedDate").value = dateStr;

            // submit only the calendar form
            document.getElementById("dateForm").submit();
        }
    });

    // ensure stored date is restored on reload
    document.addEventListener("DOMContentLoaded", function () {
        const storedDate = localStorage.getItem("selectedDate");
        if (storedDate) {
            document.getElementById("selectedDate").value = storedDate;
        }
    });
</script>
