@{
    ViewBag.Title = "Successful Message";
}

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-sm text-center" style="width: 420px; border-radius: 8px;">
        <div class="card-header py-2" style="background-color: #007178; color: #fff; border-top-left-radius: 8px; border-top-right-radius: 8px;">
            <h6 class="mb-0">Successful Message</h6>
        </div>

        <div class="card-body py-4">
            <h5 class="text-success fw-bold mb-3">Clinical Staff Added Successfully</h5>
            <p class="mb-4 px-3 text-secondary">
                The clinical staff member has been added, and a user account has been automatically created.
                An email with account login details has been sent to the registered email address.
            </p>
            <a asp-controller="ClinicalStaff" asp-action="Index" class="btn btn-outline-secondary px-4">ok</a>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f6f8f8;
    }

    .card {
        border: none;
    }

    .text-success {
        color: #009966 !important;
    }
</style>
