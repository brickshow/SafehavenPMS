@model SafehavenPMS.ViewModel.GenerateInvoiceViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Generate Monthly Invoice";
    var currentYear = DateTime.UtcNow.Year;
    var currentMonth = DateTime.UtcNow.Month;
    var targetYear = Model?.Year ?? DateTime.UtcNow.Year;
    var allowedMonths = Enumerable.Range(1,12)
        .Where(m => targetYear < currentYear || (targetYear == currentYear && m < currentMonth))
        .ToList();
}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="section-header bg-teal text-white p-3 pt-2 pb-2 mb-3" style="background-color: #015F6B;">
            <h5 class="mb-0">Generate Monthly Invoice</h5>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {   
                <div class="alert alert-success">
                    <strong>@TempData["Success"]</strong>
                    <div>Number of Invoices Generated: <strong>@TempData["GeneratedCount"]</strong></div>
                </div>
            }
            else if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning">
                    <strong>@TempData["Warning"]</strong>
                </div>
            }

            @if (!(ViewBag.HasMonthlyFeeConfig ?? false))
            {
                <div class="alert alert-warning mb-4">
                    Monthly fee not configured. <a asp-controller="BillingSetup" asp-action="Index">Set it up here</a>.
                </div>
            }
            else
            {
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="border rounded p-3">
                            <h6 class="fw-semibold mb-3">Current Standard Monthly Program Fee</h6>
                            <div class="d-flex justify-content-between"><span>Treatment</span><span>@((decimal)ViewBag.TreatmentFee)</span></div>
                            <div class="d-flex justify-content-between"><span>Food</span><span>@((decimal)ViewBag.FoodFee)</span></div>
                            <div class="d-flex justify-content-between"><span>Accommodation & Amenities</span><span>@((decimal)ViewBag.AccommodationAmenitiesFee)</span></div>
                            <hr />
                            <div class="d-flex justify-content-between fw-bold">
                                <span>Total</span><span>@((decimal)ViewBag.TotalMonthlyFee)</span>
                            </div>  
                            <div class="text-muted mt-1" style="font-size:.75rem;">
                                Effective: @ViewBag.EffectiveDate
                            </div>
                            <div class="mt-2">
                                <a asp-controller="BillingSetup" asp-action="Index" class="small text-decoration-none">Edit in Billing Setup</a>
                            </div>
                            <div class="mt-3 small text-muted">
                                Only completed past months are eligible. Due Date must be ≥ 15 days from today.
                            </div>
                        </div>
                    </div>
                </div>
            }

            <form asp-action="GenerateInvoiceConfirm" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-6">
                    <label class="form-label">Month of</label>
                    <select asp-for="Month" class="form-select">
                        <option value="">Select month</option>
                        @foreach (var m in allowedMonths)
                        {
                            var label = new DateTime(2000, m, 1).ToString("MMMM");
                            <option value="@m" selected="@(Model?.Month == m)">@label</option>
                        }
                    </select>
                    <span asp-validation-for="Month" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Year</label>
                    <select asp-for="Year" class="form-select" onchange="this.form.submit()">
                        <option value="">Select year</option>
                        @for (int y = currentYear - 3; y <= currentYear; y++)
                        {
                            <option value="@y" selected="@(Model!=null && Model.Year==y)">@y</option>
                        }
                    </select>
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Due Date</label>
                    <input asp-for="DueDate" class="form-control" type="date"
                           min="@DateTime.UtcNow.Date.AddDays(15).ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DueDate" class="text-danger"></span>
                </div>

                <div class="col-12 mt-3 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-cancel">Cancel</a>
                    <button type="submit" class="btn btn-next" @((ViewBag.HasMonthlyFeeConfig ?? false) ? "" : "disabled")>Generate</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}