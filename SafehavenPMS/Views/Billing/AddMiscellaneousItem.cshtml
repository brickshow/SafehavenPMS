@model SafehavenPMS.ViewModel.Billing.MiscellaneousItemViewModel

@{
    ViewBag.Title = "Add Miscellaneous";
}

@* Content Header *@
<div class="header">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index")" class="me-2" title="Back">
                <i class="bx bx-reply fs-2 text-custom"></i>
            </a>
            <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
        </div>
    </div>
    <hr class="mt-0 mb-3" />
</div>

<div class="container my-4">
    <div class="card shadow-sm">
        <!-- Header -->
        <div class="p-2" style="background-color:#0097a7; color:#fff;">
            <h5 class="modal-title">Add Miscellaneous Item</h5>
        </div>

        <div class="card-body">
            <form asp-action="AddMiscellaneousItem" asp-controller="Billing" method="post" id="miscellaneousForm">
                <!-- Patient Section -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Patient</label>
                    <div class="input-group">
                        <input type="text" id="patientSearch" class="form-control" placeholder="Search patient name/id ..." />
                        <button type="button" class="btn btn-info text-white">Search</button>
                    </div>

                    <!-- Selected Patient Card -->
                    <div class="card shadow-sm mt-3">
                        <div class="card-body d-flex align-items-center">
                            <div class="me-3">
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                                     style="width:60px; height:60px; border:1px solid #ddd;">
                                    <span class="text-danger fw-bold">profile</span>
                                </div>
                            </div>
                            <div>
                                <p class="mb-0 fw-bold">Sha Sha Rizon Ramos</p>
                                <small class="text-muted">56Y | F</small>
                            </div>
                        </div>
                    </div>
                </div>

                <h6 class="fw-semibold">Items</h6>
                <div id="itemRows">
                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-md-7">
                            <input type="text" name="ItemDescriptions" class="form-control" placeholder="Item Description" required />
                        </div>
                        <div class="col-md-4">
                            <input type="number" name="Amounts" class="form-control text-end" placeholder="Amount" min="0.01" step="0.01" required />
                        </div>
                        <div class="col-md-1 text-center">
                            <button type="button" class="btn btn-outline-danger btn-sm removeRow" aria-label="Remove row">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="text-end mb-3">
                    <button type="button" id="addRow" class="btn btn-sm btn-outline-primary">+ Add Item</button>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3 mb-3">
                    <h5 class="mb-0 fw-bold">TOTAL</h5>
                    <h5 class="mb-0 fw-bold text-dark">₱<span id="totalAmount">0</span></h5>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a class="btn btn-secondary" asp-action="Index" asp-controller="Billing">Cancel</a>
                    <button type="submit" class="btn btn-info text-white">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const containerSelector = '#itemRows';
    const descName = "ItemDescriptions";
    const amtName = "Amounts";

    function createRow() {
        const div = document.createElement('div');
        div.className = 'row g-2 align-items-center mb-2';
        div.innerHTML = `
            <div class="col-md-7">
                <input type="text" name="${descName}" class="form-control" placeholder="Item Description" required />
            </div>
            <div class="col-md-4">
                <input type="number" name="${amtName}" class="form-control text-end" placeholder="Amount" min="0.01" step="0.01" required />
            </div>
            <div class="col-md-1 text-center">
                     <button type="button" class="btn btn-outline-danger btn-sm removeRow" aria-label="Remove row">
            <i class="bx bx-trash"></i>
        </button>
            </div>`;
        return div;
    }

    // rows add/remove & validation
    const addBtn = document.getElementById('addRow');
    addBtn?.addEventListener('click', function () {
        const container = document.querySelector(containerSelector);
        if (!container) return;

        const lastRow = container.querySelector('.row:last-child');
        if (lastRow) {
            const desc = (lastRow.querySelector(`input[name='${descName}']`)?.value || "").trim();
            const amt = parseFloat(lastRow.querySelector(`input[name='${amtName}']`)?.value) || 0;
            if (!desc || amt <= 0) {
                if (!desc) lastRow.querySelector(`input[name='${descName}']`)?.classList.add('is-invalid');
                if (amt <= 0) lastRow.querySelector(`input[name='${amtName}']`)?.classList.add('is-invalid');
                lastRow.querySelector(`input[name='${descName}']`)?.focus();
                return;
            }
        }
        container.appendChild(createRow());
        calculateTotal();
    });

    document.addEventListener('click', function (e) {
        const rem = e.target.closest('.removeRow');
        if (rem) {
            const row = rem.closest('.row');
            if (!row) return;
            const container = document.querySelector(containerSelector);
            row.remove();
            if (container && container.querySelectorAll('.row').length === 0) {
                container.appendChild(createRow());
            }
            calculateTotal();
        }
    });

    document.addEventListener('input', function (e) {
        if (!e.target) return;
        if (e.target.name === amtName || e.target.name === descName) {
            e.target.classList.remove('is-invalid');
            calculateTotal();
        }
    }, { passive: true });

    function calculateTotal() {
        let total = 0;
        const container = document.querySelector(containerSelector);
        if (!container) return;
        container.querySelectorAll(`input[name='${amtName}']`).forEach(i => {
            total += parseFloat(i.value) || 0;
        });
        const target = document.getElementById('totalAmount');
        if (target) target.textContent = total.toLocaleString();
    }

    // form validation
    const form = document.getElementById('miscellaneousForm');
    form?.addEventListener('submit', function (e) {
        const container = document.querySelector(containerSelector);
        if (!container) return;
        let valid = true;
        container.querySelectorAll('.row').forEach(row => {
            const descEl = row.querySelector(`input[name='${descName}']`);
            const amtEl = row.querySelector(`input[name='${amtName}']`);
            const desc = (descEl?.value || "").trim();
            const amt = parseFloat(amtEl?.value) || 0;

            if (!desc) { descEl?.classList.add('is-invalid'); valid = false; }
            if (amt <= 0) { amtEl?.classList.add('is-invalid'); valid = false; }
        });

        const hiddenPatient = document.getElementById('PatientId');
        if (!hiddenPatient || !hiddenPatient.value || hiddenPatient.value === "0") {
            e.preventDefault();
            document.getElementById('patientSearch')?.classList.add('is-invalid');
            alert('Please select a patient from the list.');
            return;
        }

        if (!valid) {
            e.preventDefault();
            const firstInvalid = document.querySelector('.is-invalid');
            firstInvalid?.focus();
            alert('Please fill item description and an amount greater than 0 for all rows.');
        }
    });

    calculateTotal();

    // --- patient search (server endpoint /Billing/SearchPatients expected) ---
    const input = document.getElementById('patientSearch');
    const suggestions = document.getElementById('patientSuggestions');
    const hiddenId = document.getElementById('PatientId');
    const selCard = document.getElementById('selectedPatientCard');
    const selName = document.getElementById('selectedPatientName');
    const selMeta = document.getElementById('selectedPatientMeta');
    let debounceTimer = 0;

    function renderList(items) {
        if (!items || items.length === 0) {
            suggestions.style.display = 'none';
            suggestions.innerHTML = '';
            return;
        }
        suggestions.innerHTML = items.map(i =>
            `<li class="list-group-item list-group-item-action" data-id="${i.id}" data-text="${(i.text||'')}">${i.text}${i.extra ? ' · ' + i.extra : ''}</li>`
        ).join('');
        suggestions.style.display = 'block';
    }

    function pickItem(el) {
        if (!el) return;
        const id = el.getAttribute('data-id');
        const text = el.getAttribute('data-text') || el.textContent.trim();
        input.value = text;
        hiddenId.value = id || '';
        if (selCard) {
            selName.textContent = text;
            selMeta.textContent = el.textContent.replace(text, '').trim();
            selCard.classList.remove('d-none');
        }
        suggestions.style.display = 'none';
    }

    input?.addEventListener('input', function () {
        const q = input.value.trim();
        hiddenId.value = '';
        if (q.length < 2) { suggestions.style.display = 'none'; suggestions.innerHTML = ''; return; }
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(async () => {
            try {
                const url = '/Billing/SearchPatients?q=' + encodeURIComponent(q);
                const res = await fetch(url, { credentials: 'same-origin' });
                if (!res.ok) { renderList([]); return; }
                const data = await res.json();
                renderList(data);
            } catch (err) { console.error(err); renderList([]); }
        }, 250);
    }, { passive: true });

    suggestions?.addEventListener('click', function (e) {
        const li = e.target.closest('li[data-id]');
        if (!li) return;
        pickItem(li);
    });

    input?.addEventListener('keydown', function (e) {
        const visible = suggestions.style.display === 'block';
        if (!visible) return;
        const active = suggestions.querySelector('.active');
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (!active) { suggestions.querySelector('li')?.classList.add('active'); }
            else { active.classList.remove('active'); active.nextElementSibling?.classList.add('active'); }
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (!active) return;
            active.classList.remove('active');
            active.previousElementSibling?.classList.add('active');
        } else if (e.key === 'Enter') {
            const toPick = suggestions.querySelector('.active') || suggestions.querySelector('li');
            if (toPick) { e.preventDefault(); pickItem(toPick); }
        } else if (e.key === 'Escape') { suggestions.style.display = 'none'; }
    });

    document.addEventListener('click', function (e) {
        if (!input.contains(e.target) && !suggestions.contains(e.target)) { suggestions.style.display = 'none'; }
    });

})();
</script>
}