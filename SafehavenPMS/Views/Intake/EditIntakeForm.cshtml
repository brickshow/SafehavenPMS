@model SafehavenPMS.ViewModel.IntakeViewModel

@{
    ViewBag.Title = "Edit Intake Form";
}

@* Content Header *@
<div class="header">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index")" class="me-2" title="Back">
                <i class="bx bx-reply fs-2 text-custom"></i>
            </a>
            <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
        </div>
    </div>
    <hr class="mt-0 mb-3" />
</div>

<!-- Header spans full width above the tablature -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm mb-4" style="border-radius:6px;">
            <div class="card-body p-4">
                <div class="row g-0 align-items-center justify-content-between">
                    <!-- Photo + Name -->
                    <div class="col-auto d-flex align-items-center">
                        <div class="position-relative me-3">
                            <div class="rounded-circle bg-secondary" style="width:58px;height:58px;overflow:hidden;">
                                <img src="~/Images/default.png" alt="Patient Photo" style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                            <div class="position-absolute bottom-0 end-0 rounded-circle bg-success d-flex align-items-center justify-content-center"
                                 style="width:20px;height:20px;">
                                <i class="bx bx-smile text-white" style="font-size:12px;"></i>
                            </div>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.FullName</h5>
                            <small class="text-muted">Patient No. @Model.IntakeId</small>
                        </div>
                    </div>

                    <!-- Patient Info Grid -->
                    <div class="col">
                        <div class="row text-center">
                            <div class="col-6 col-md-3 mb-2 mb-md-0 d-flex flex-column justify-content-start">
                                <div class="text-muted small">Age</div>
                                <div class="fw-semibold">@Model.Age</div>
                            </div>
                            <div class="col-6 col-md-3 mb-2 mb-md-0 d-flex flex-column justify-content-start">
                                <div class="text-muted small">Sex</div>
                                <div class="fw-semibold">@Model.Sex</div>
                            </div>
                            <div class="col-6 col-md-3 mb-2 mb-md-0 d-flex flex-column justify-content-start">
                                <div class="text-muted small">Occupation</div>
                                <div class="fw-semibold">@Model.Occupation</div>
                            </div>
                            <div class="col-6 col-md-3 mb-2 mb-md-0 d-flex flex-column justify-content-start">
                                <div class="text-muted small">Address</div>
                                <div class="fw-semibold">@Model.Address</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Information Card -->
<div class="card shadow-sm mb-4" style="border-radius:6px;">
    <form>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Date of Intake:</label>
                    <input type="date" class="form-control" value="@Model.IntakeDate?.ToString("MMM dd, yyyy")" disabled/>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Date of Referral:</label>
                    <input type="date" class="form-control" value="@Model.DateOfReferral?.ToString("MMM dd, yyyy")" disabled/>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Referred by:</label>
                    <input type="text" class="form-control" value="@Model.ReferredBy" disabled/>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Contact No.:</label>
                    <input type="text" class="form-control" value="@Model.ReferredByPhoneNumber" disabled/>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Reason for Intake:</label>
                    <input type="text" class="form-control" value="@Model.ReasonForIntake" disabled/>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="row g-1">
    <!-- Left navigation (Bootstrap pills vertical) -->
    <div class="col-md-3">
        <div class="nav flex-column nav-pills mb-3" id="leftTabs" role="tablist" aria-orientation="vertical">
            <a class="nav-link active" id="tab-family-link" data-bs-toggle="pill" href="#tab-family" role="tab"
               aria-controls="tab-family" aria-selected="true">
                Family Constellation
            </a>
            <a class="nav-link" id="tab-problems-link" data-bs-toggle="pill" href="#tab-problems" role="tab"
               aria-controls="tab-problems" aria-selected="false">
                Presenting Problems
            </a>
            <a class="nav-link" id="tab-impressions-link" data-bs-toggle="pill" href="#tab-impressions" role="tab"
               aria-controls="tab-impressions" aria-selected="false">
                Counselor's / Case Worker's Impression
            </a>
        </div>
    </div>
    <!-- In the tab content section -->
    <div class="col-md-9">
        <div class="tab-content" id="tabContentWrapper">
            <div class="tab-pane fade show active" id="tab-family" role="tabpanel" aria-labelledby="tab-family-link">
                @await Html.PartialAsync("IntakeFormTabs/FamilyTab", Model)
            </div>

            <div class="tab-pane fade" id="tab-problems" role="tabpanel" aria-labelledby="tab-problems-link">
                @await Html.PartialAsync("IntakeFormTabs/ProblemsTab", Model)
            </div>

            <div class="tab-pane fade" id="tab-impressions" role="tabpanel" aria-labelledby="tab-impressions-link">
                @await Html.PartialAsync("IntakeFormTabs/ImpressionsTab", Model)
            </div>
        </div>
    </div>
</div>


<style>
    /* Visual adjustments to mimic the tablature look */
    .table thead th {
        border-bottom: none;
        background: transparent;
    }

    .form-control:focus {
        box-shadow: none;
        border-color: #cfecec;
    }

    .btn-outline-danger {
        border-color: #ef5a5a;
        color: #ef5a5a;
    }

        .btn-outline-danger:hover {
            background: #ef5a5a;
            color: #fff;
        }

    /* Minor spacing */
    .list-group .list-group-item, .nav-pills .nav-link {
        padding: 12px 14px;
        cursor: pointer;
    }

    .fw-semibold {
        font-weight: 600;
    }

    /* Updated styling for navigation pills */
    .nav-pills .nav-link {
        color: #333;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0;
        margin-bottom: -1px;
        padding: 12px 20px;
        transition: all 0.2s ease;
    }

        .nav-pills .nav-link:hover {
            background-color: #f8f9fa;
        }

        .nav-pills .nav-link.active {
            color: #fff;
            background-color: #006d77;
            border-color: #006d77;
        }

        /* Remove border radius from first and last items */
        .nav-pills .nav-link:first-child {
            border-top-left-radius: 4px;
            border-top-right-radius: 4px;
        }

        .nav-pills .nav-link:last-child {
            border-bottom-left-radius: 4px;
            border-bottom-right-radius: 4px;
            margin-bottom: 0;
        }
</style>