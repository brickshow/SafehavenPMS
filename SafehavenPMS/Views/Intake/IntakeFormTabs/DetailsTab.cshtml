@model SafehavenPMS.ViewModel.IntakeViewModel

<form asp-action="SaveDetails" asp-controller="Intake" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PatientId" value="@Model.PatientId" />
    <div class="card shadow-sm mb-4" style="border-radius:6px;">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Referred by:</label>
                    <input type="text" asp-for="ReferredBy" class="form-control" value="@Model.ReferredBy"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Affiliation:</label>
                    <input type="text" asp-for="Affiliation" class="form-control" value="@Model.Affiliation"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Contact No.:</label>
                    <input type="text" asp-for="ReferredByPhoneNumber" class="form-control" value="@Model.ReferredByPhoneNumber"/>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Reason for Intake:</label>
                    <textarea class="form-control" rows="3" asp-for="ReasonForIntake">@Model.ReasonForIntake</textarea>
                </div>
            </div>
        </div>



    </div>

    @* //Save button at the bottom right *@
    <div class="text-end">
        <button type="submit" class="btn btn-next">Save</button>
    </div>

</form>