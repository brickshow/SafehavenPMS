@model SafehavenPMS.ViewModel.IntakeViewModel



<form asp-action="SaveFamilyData" asp-controller="Intake" method="post" id="familyForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="IntakeId" value="@Model.IntakeId" />

    <!-- Family Constellation Table -->
    <div class="card rounded shadow-sm mb-4">
        <div class="card-header bg-transparent text-custom d-flex flex-row">
            <h5 class="mb-0">FAMILY CONSTELLATION: </h5>
            <p class="text-muted small mb-0 fst-italic">(Indicate whether parents are natural or adoptive; include siblings and other significant persons)</p>
        </div>
        <div class="card-body px-4 py-4">
            <div class="table-responsive">
                <table class="table family-table mb-0" style="border-collapse: separate; border-spacing: 0;">
                    <thead>
                        <tr>
                            <th class="family-th">Family Member</th>
                            <th class="family-th">Age</th>
                            <th class="family-th">Relationship</th>
                            <th class="family-th">Comments</th>
                            <th class="family-th"></th>
                        </tr>
                    </thead>
                    <tbody id="familyTableBody">
                        @for (int i = 0; i < Model.FamilyMembers.Count; i++)
                        {
                            <tr class="family-row" data-index="@i">
                                <td>
                                    <input type="text" name="FamilyMembers[@i].Name" class="family-td-input" value="@Model.FamilyMembers[i].Name" />
                                </td>
                                <td>
                                    <input type="number" name="FamilyMembers[@i].Age" class="family-td-input" value="@Model.FamilyMembers[i].Age" />
                                </td>
                                <td>
                                    <input type="text" name="FamilyMembers[@i].Relationship" class="family-td-input" value="@Model.FamilyMembers[i].Relationship" />
                                </td>
                                <td>
                                    <input type="text" name="FamilyMembers[@i].Comments" class="family-td-input" value="@Model.FamilyMembers[i].Comments" />
                                </td>
                                <td class="text-center align-middle">
                                    <button type="button" class="family-delete-btn" title="Remove" onclick="removeRow(this)">
                                        <i class="bx bx-trash" style="color:#e44e4e; font-size:1.4rem;"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        <!-- Add row -->
                        <tr id="addRow">
                            <td>
                                <input type="text" id="newName" class="family-td-input" placeholder="" />
                            </td>
                            <td>
                                <input type="number" id="newAge" class="family-td-input" placeholder="" />
                            </td>
                            <td>
                                <input type="text" id="newRelationship" class="family-td-input" placeholder="" />
                            </td>
                            <td>
                                <input type="text" id="newComments" class="family-td-input" placeholder="" />
                            </td>
                            <td class="text-center align-middle">
                                <button type="button" class="family-add-btn" onclick="addRow()" style="background:#066; color:#fff; border-radius:6px; width:32px; height:32px; border:none;">
                                    <i class="bx bx-plus" style="font-size:1.3rem; vertical-align:middle;"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Other family details -->
            <div class="mt-4">
                <textarea  asp-for="OtherFamilyDetails" class="family-details-textarea" rows="4" placeholder="Other family details............">@Model.OtherFamilyDetails</textarea>
            </div>
        </div>
    </div>

    <!-- Save Button -->
    <div class="d-flex justify-content-end mt-4 mb-4">
        <button type="submit" class="btn btn-custom">
            <i class="bx bx-save me-2"></i>Save
        </button>
    </div>
</form>

<style>
    .family-table {
        width: 100%;
        background: #fff;
        border-radius: 10px;
        border: none;
        font-size: 1.08rem;
    }

        .family-table td,
        .family-table th {
            border-bottom: none !important;
        }

    .family-th {
        font-weight: 600;
        color: #6c6c6c;
        padding: 18px 10px 12px 10px;
        background: none;
        font-size: 1.08rem;
        border-bottom: none !important;
    }

    .family-td-input {
        width: 100%;
        border: 1px solid gray;
        background: transparent;
        font-size: 1.11rem;
        border-radius: 4px;
        color: #232323;
        padding: 4px 2px;
        outline: none;
    }

        .family-td-input:focus {
            background: #f6fafc;
            border-radius: 4px;
            box-shadow: none;
        }

    .family-delete-btn {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        outline: none;
        vertical-align: middle;
    }

    .family-add-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: none;
        border: none;
        cursor: pointer;
    }

    .family-details-textarea {
        width: 100%;
        border: 2px solid #d4d4d4;
        border-radius: 10px;
        background: #fff;
        padding: 16px;
        font-size: 1.08rem;
        color: #6c6c6c;
        resize: none;
        margin-top: 12px;
    }

        .family-details-textarea::placeholder {
            color: #b5b5b5;
            font-style: italic;
            font-size: 1.08rem;
        }
</style>

<script>
    // Track the current index for new family members to ensure unique naming
    let familyIndex = @(Model.FamilyMembers?.Count ?? 0);

    /**
     * Adds a new family member row to the table
     */
    function addRow() {
        // Get values from the input fields in the add row
        const name = document.getElementById('newName').value;
        const age = document.getElementById('newAge').value;
        const relationship = document.getElementById('newRelationship').value;
        const comments = document.getElementById('newComments').value;

        if (!name.trim()) {
            alert("Family member name is required");
            return;
        }

        // Get references to the table body and the add row
        const tbody = document.getElementById('familyTableBody');
        const addRow = document.getElementById('addRow');

        // Create a new table row element
        const newRow = document.createElement('tr');
        newRow.className = 'family-row';

        // Set the HTML content for the new row with proper input names for model binding
        newRow.innerHTML = `
            <td>
                <input type="text" name="FamilyMembers[${familyIndex}].Name" class="family-td-input" value="${name}" />
            </td>
            <td>
                <input type="number" name="FamilyMembers[${familyIndex}].Age" class="family-td-input" value="${age}" />
            </td>
            <td>
                <input type="text" name="FamilyMembers[${familyIndex}].Relationship" class="family-td-input" value="${relationship}" />
            </td>
            <td>
                <input type="text" name="FamilyMembers[${familyIndex}].Comments" class="family-td-input" value="${comments}" />
            </td>
            <td class="text-center align-middle">
                <button type="button" class="family-delete-btn" title="Remove" onclick="removeRow(this)">
                    <i class="bx bx-trash" style="color:#e44e4e; font-size:1.4rem;"></i>
                </button>
            </td>
        `;

        // Insert the new row before the add row
        tbody.insertBefore(newRow, addRow);

        // Clear inputs
        document.getElementById('newName').value = '';
        document.getElementById('newAge').value = '';
        document.getElementById('newRelationship').value = '';
        document.getElementById('newComments').value = '';

        familyIndex++;
        reindexRows(); // Add reindexing to ensure proper model binding
    }

    /**
     * Removes a family member row from the table
     */
    function removeRow(button) {
        button.closest('tr').remove();
        reindexRows(); // Reindex after removal to maintain continuous indices
    }
</script>