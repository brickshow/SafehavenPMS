@model SafehavenPMS.ViewModel.DischargePatientViewModel
@{
    ViewBag.Title = "Discharge Patient";
}

<div class="container-fluid py-3">
    <h5 class="mb-3">Discharge</h5>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="post" asp-action="Discharge" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Select Patient</label>
                    <select asp-for="PatientId" class="form-select" asp-items="Model.PatientOptions">
                        <option value="">-- Choose patient --</option>
                    </select>
                    <span asp-validation-for="PatientId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button type="submit" class="btn btn-next">Load</button>
                </div>

                @if (Model.PatientId > 0 && !string.IsNullOrEmpty(Model.PatientName))
                {
                    <hr class="mt-3"/>

                    <div class="col-12">
                        <div class="d-flex align-items-center gap-3 bg-white p-3 rounded border">
                            <img src="@(Model.PhotoUrl ?? Url.Content("~/Images/default.png"))"
                                 style="width:70px;height:70px;object-fit:cover;border-radius:50%;">
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@Model.PatientName</div>
                                <div class="text-muted small">Patient No. @Model.PatientNumber</div>
                            </div>
                            <div class="small">
                                <div><strong>Sex:</strong> @Model.Sex</div>
                                <div><strong>Address:</strong> @Model.Address</div>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="ProceedAnyway" id="ProceedAnyway" />

                    <div class="col-md-6 mt-3">
                        <label asp-for="AdmissionDate" class="form-label fw-semibold"></label>
                        <input asp-for="AdmissionDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-6 mt-3">
                        <label asp-for="DischargeDate" class="form-label fw-semibold"></label>
                        <input asp-for="DischargeDate" class="form-control" type="date" />
                    </div>

                    <div class="col-md-6 mt-3">
                        <label asp-for="Reason" class="form-label fw-semibold"></label>
                        <input asp-for="Reason" class="form-control" list="reasonList" autocomplete="off" />
                        <datalist id="reasonList">
                            <option value="Completed" />
                            <option value="Against medical advice" />
                            <option value="Transferred" />
                            <option value="Escapes" />
                            <option value="Mortality/Death" />
                            <option value="Morbidity" />
                        </datalist>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>
                    <div class="col-12 mt-3">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" rows="5" class="form-control"></textarea>
                        @if (Model.HasUnpaidInvoices)
                        {
                            <div class="small text-danger mt-2">
                                Patient has unpaid invoices. You will be asked to confirm.
                            </div>
                        }
                    </div>

                    <div class="col-12 d-flex justify-content-end mt-3">
                        <button name="finalSubmit" value="true" type="submit" class="btn btn-success px-5">
                            Confirm Discharge
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    @if (Model.PatientId > 0 && Model.HasUnpaidInvoices)
    {
        <script>
            document.querySelector('button[name="finalSubmit"]')?.addEventListener('click', function (e) {
                if (document.getElementById('ProceedAnyway').value !== 'true') {
                    if (!confirm("Patient has unpaid invoices. Proceed with discharge?")) {
                        e.preventDefault();
                    } else {
                        document.getElementById('ProceedAnyway').value = 'true';
                    }
                }
            });
        </script>
    }
}