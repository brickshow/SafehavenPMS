@model SafehavenPMS.ViewModel.Billing.BankInfoEditViewModel
@{
    ViewBag.Title = "Edit Bank Info";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="header">
    <div class="d-flex align-items-center gap-2 mb-2">
        <h5 class="mb-0">Edit Bank Information</h5>
    </div>
    <hr class="mt-0 mb-3" />
</div>
<form asp-action="EditBank" method="post" class="card shadow-sm p-4">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="BankName" class="form-label"></label>
        <input asp-for="BankName" class="form-control" />
        <span asp-validation-for="BankName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AccountName" class="form-label"></label>
        <input asp-for="AccountName" class="form-control" />
        <span asp-validation-for="AccountName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AccountNumber" class="form-label"></label>
        <input asp-for="AccountNumber" class="form-control" />
        <span asp-validation-for="AccountNumber" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button class="btn btn-primary" type="submit">Save</button>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }