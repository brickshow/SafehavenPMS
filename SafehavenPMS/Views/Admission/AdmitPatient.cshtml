@model SafehavenPMS.ViewModel.AdmitPatientViewModel

@{
    ViewBag.Title = "New Admission";
}

@* Content Header *@
<div class="header">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <i class="bx bxs-group fs-2 me-2" title="Staff"></i>
            <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
        </div>
    </div>
    <hr class="mt-0 mb-2" />
</div>

<div class="container bg-white mt-3 p-0">
    @* Search Patient Section *@
    <div class="section-header text-white p-2 mb-3" style="background-color: #015F6B;">
        <h5 class="mb-0">Search Patient</h5>
    </div>

    <div class="row mb-3 justify-content-start m-3">

        <form asp-action="SearchPatient" asp-controller="Admission" method="post">
            <div class="row mb-3 justify-content-start m-3">
                <div class="row mb-3 justify-content-start m-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <select id="searchQuery" name="searchQuery" class="form-control" asp-items="ViewBag.PatientList" onchange="this.form.submit()">
                                <option value="">Select patient</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </form>


    </div>

    <form asp-action="AdmitPatient" asp-controller="Admission" method="post">
        <div class="section-header bg-teal text-wwhite p-2 mb-3 w-100" style="background-color: #015F6B;">
            Patient Details
        </div>

        @* Hidden Value for Patient ID *@
        <input type="hidden" asp-for="PatientId" value="@Model.PatientId" />
        <div class="row mb-3">
            <div class="col-md-4 d-flex align-items-center">
                <div>
                    <img src="~/Images/default.png" alt="Patient Photo" style="border-radius: 50%;width:90px;  margin: 10px;">
                </div>
                <div>
                    <p><strong>@Model.FullName</strong></p>
                    <p><small>Patient No.: @Model.PatientId</small></p>
                </div>
            </div>
            <div class="col-md-8 p-4">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label">DOB:</label>
                        <input type="text" class="form-control" value="@(Model.DOB.HasValue? Model.DOB.Value.ToString("yyyy-MM-dd") : "")" readonly>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Educational Attainment:</label>
                        <input type="text" class="form-control" value="@Model.EducationalAttainment" readonly>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Occupation:</label>
                        <input type="text" class="form-control" value="@Model.Occupation" readonly>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Religion:</label>
                        <input type="text" class="form-control" value="@Model.Religion" readonly>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Phone Number:</label>
                        <input type="text" class="form-control" value="@Model.PhoneNumber" readonly>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-header bg-teal text-white p-2 mb-3 w-100" style="background-color: #015F6B;">
            Assign Clinical Staff
        </div>
        <div class="d-flex justify-content-center mb-3">
            <div class="container">
                <div class="row g-3 justify-content-center">
                    <!-- Physician -->
                    <div class="col-md-6">
                        <label class="form-label">Physician</label>
                        <input type="hidden" asp-for="PhysicianId" value="@Model.PhysicianId" />
                        <input type="text" class="form-control" value="@Model.PhysicianName " readonly />
                    </div>

                    <!-- Psychiatrist -->
                    <div class="col-md-6">
                        <label asp-for="PsychiatristId" class="form-label">Psychiatrist</label>
                        <select asp-for="PsychiatristId" asp-items="ViewBag.Psychiatrists" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>

                    <!-- Psychologist -->
                    <div class="col-md-6">
                        <label asp-for="PsychologistId" class="form-label">Psychologist</label>
                        <select asp-for="PsychologistId" asp-items="ViewBag.Psychologists" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>

                    <!-- Psychometrician -->
                    <div class="col-md-6">
                        <label asp-for="PsychometricianId" class="form-label">Psychometrician</label>
                        <select asp-for="PsychometricianId" asp-items="ViewBag.Psychometricians" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>

                    <!-- Social Worker -->
                    <div class="col-md-6">
                        <label asp-for="SocialWorkerId" class="form-label">Social Worker</label>
                        <select asp-for="SocialWorkerId" asp-items="ViewBag.SocialWorkers" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>

                    <!-- Recovery Coach -->
                    <div class="col-md-6">
                        <label asp-for="RecoveryCoachId" class="form-label">Recovery Coach</label>
                        <select asp-for="RecoveryCoachId" asp-items="ViewBag.RecoveryCoaches" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

        </div>

        <div class="section-header bg-teal text-white p-2 mb-3 w-100" style="background-color: #015F6B;">
            Family/Payer Information
        </div>
        <div class="container">
            <div class="row g-3">
                <!-- Name -->
                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <input asp-for="FamilyName" type="text" class="form-control" placeholder="Enter name">
                </div>

                <!-- Relationship to Patient -->
                <div class="col-md-6">
                    <label class="form-label">Relationship to Patient</label>
                    <input asp-for="FamilyRelationship" type="text" class="form-control" placeholder="Enter relationship">
                </div>

                <!-- Phone Number -->
                <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <input asp-for="FamilyPhone" type="text" class="form-control" placeholder="Enter phone number">
                </div>

                <!-- Email -->
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input asp-for="FamilyEmail" type="email" class="form-control" placeholder="Enter email">
                </div>

                <!-- Activate Family Portal -->
                <div class="col-md-6">
                    <div class="form-check form-switch mt-2">
                        <input type="checkbox" class="form-check-input" id="activatePortal">
                        <label class="form-check-label" for="activatePortal">Activate Family Portal</label>
                    </div>
                </div>
            </div>
        </div>


        <div class="row mt-5 pt-3 border-top">
            <div class="col-md-12 text-end">
                <button type="button" class="btn-cancel me-2" onclick="history.back()">Cancel</button>
                <button type="submit" class="btn-custom">Admit Patient</button>
            </div>
        </div>
    </form>
   
</div>

<script>
    document.getElementById("searchQuery").addEventListener("input", async function () {
        let query = this.value;
        if (query.length < 2) return; // start searching after 2 chars

        try {
            let response = await fetch(`/Admission/GetPatientMatches?query=${encodeURIComponent(query)}`);
            if (!response.ok) {
                console.error("Fetch failed:", response.statusText);
                return;
            }

            let data = await response.json();

            let datalist = document.getElementById("patientList");
            datalist.innerHTML = "";
            data.forEach(p => {
                let option = document.createElement("option");
                option.value = p.name; // must match property casing from JSON
                datalist.appendChild(option);
            });
        } catch (err) {
            console.error("Error fetching:", err);
        }
    });
</script>