@model SafehavenPMS.ViewModel.AdmitPatientViewModel

@{
    ViewBag.Title = "New Admission";
}

@* Content Header *@
<div class="header">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <i class="bx bxs-group fs-2 me-2" title="Staff"></i>
            <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
        </div>
    </div>
    <hr class="mt-0 mb-2" />
</div>

<!-- Header spans full width above the tablature -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm mb-4" style="border-radius:6px;">
            <div class="card-body p-4">
                <div class="row g-0 align-items-center justify-content-between">
                    <!-- Photo + Name -->
                    <div class="col-auto d-flex align-items-center">
                        <div class="position-relative me-3">
                            <div class="rounded-circle bg-secondary" style="width:58px;height:58px;overflow:hidden;">
                                <img src="~/Images/default.png" alt="Patient Photo"
                                    style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                            <div class="position-absolute bottom-0 end-0 rounded-circle bg-success d-flex align-items-center justify-content-center"
                                style="width:20px;height:20px;">
                                <i class="bx bx-smile text-white" style="font-size:12px;"></i>
                            </div>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.FullName</h5>
                            <small class="text-muted">Patient No. @Model.PatientId</small>
                        </div>
                    </div>

                    <!-- Patient Info Grid -->
                    <div class="col">
                        <div class="row text-center">
                            <div class="col-6 col-md-3 mb-2 mb-md-0 d-flex flex-column justify-content-start">
                                <div class="text-muted small">Age</div>
                                <div class="fw-semibold">@Model.Age</div>
                            </div>
                            <div class="col-6 col-md-3 mb-2 mb-md-0 d-flex flex-column justify-content-start">
                                <div class="text-muted small">Sex</div>
                                <div class="fw-semibold">@Model.Sex</div>
                            </div>
                            <div class="col-6 col-md-3 mb-2 mb-md-0 d-flex flex-column justify-content-start">
                                <div class="text-muted small">Occupation</div>
                                <div class="fw-semibold">@Model.Occupation</div>
                            </div>
                            <div class="col-6 col-md-3 mb-2 mb-md-0 d-flex flex-column justify-content-start">
                                <div class="text-muted small">Address</div>
                                <div class="fw-semibold">@Model.Address</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container bg-white mt-3 p-0">
    <form asp-action="AdmitPatient" asp-controller="Admission" method="post">
        <input type="hidden" asp-for="PatientId" value="@Model.PatientId">
        <div class="section-header bg-teal text-white p-2 mb-3 w-100" style="background-color: #015F6B;">
            Assign Clinical Staff
        </div>
        <div class="d-flex justify-content-center mb-3">
            <div class="container">
                <div class="row g-3 justify-content-center">
                    <!-- Physician -->
                    <div class="col-md-6">
                        <label asp-for="PhysicianId" class="form-label">Physician</label>
                        <select asp-for="PhysicianId" asp-items="ViewBag.Physicians" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>

                    <!-- Psychologist -->
                    <div class="col-md-6">
                        <label asp-for="PsychologistId" class="form-label">Psychologist</label>
                        <select asp-for="PsychologistId" asp-items="ViewBag.Psychologists" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>

                    <!-- Psychometrician -->
                    <div class="col-md-6">
                        <label asp-for="PsychometricianId" class="form-label">Psychometrician</label>
                        <select asp-for="PsychometricianId" asp-items="ViewBag.Psychometricians" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>

                    <!-- Social Worker -->
                    <div class="col-md-6">
                        <label asp-for="SocialWorkerId" class="form-label">Social Worker</label>
                        <select asp-for="SocialWorkerId" asp-items="ViewBag.SocialWorkers" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>

                    <!-- Recovery Coach -->
                    <div class="col-md-6">
                        <label asp-for="RecoveryCoachId" class="form-label">Recovery Coach</label>
                        <select asp-for="RecoveryCoachId" asp-items="ViewBag.RecoveryCoaches" class="form-select">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @* Family feilds for family portal *@
        <div class="section-header bg-teal text-white p-2 mb-3 w-100" style="background-color: #015F6B;">
            Family / Responsible for Payment
        </div>

        <div class="container mb-3">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FamilyName" class="form-label">Full Name</label>
                    <input asp-for="FamilyName" class="form-control" />
                    <span asp-validation-for="FamilyName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FamilyRelationship" class="form-label">Relationship</label>
                    <input asp-for="FamilyRelationship" class="form-control" />
                    <span asp-validation-for="FamilyRelationship" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FamilyPhone" class="form-label">Phone</label>
                    <input asp-for="FamilyPhone" class="form-control" />
                    <span asp-validation-for="FamilyPhone" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FamilyEmail" class="form-label">Email</label>
                    <input asp-for="FamilyEmail" class="form-control" />
                    <span asp-validation-for="FamilyEmail" class="text-danger small"></span>
                </div>

                <div class="col-12 d-flex align-items-center">
                    <input type="checkbox" id="ActivatePortal" asp-for="ActivatePortal" class="form-check-input me-2" />
                    <label for="ActivatePortal" class="form-check-label">Create portal access for this family member</label>
                </div>
            </div>
        </div>

        <div class="row mt-5 pt-3 border-top p-3">
            <div class="col-md-12 text-end">
                <button type="button" class="btn-cancel me-2" onclick="history.back()">Cancel</button>
                <button type="submit" class="btn-custom">Admit Patient</button>
            </div>
        </div>
    </form>
   
</div>

<script>
    document.getElementById("searchQuery").addEventListener("input", async function () {
        let query = this.value;
        if (query.length < 2) return; // start searching after 2 chars

        try {
            let response = await fetch(`/Admission/GetPatientMatches?query=${encodeURIComponent(query)}`);
            if (!response.ok) {
                console.error("Fetch failed:", response.statusText);
                return;
            }

            let data = await response.json();

            let datalist = document.getElementById("patientList");
            datalist.innerHTML = "";
            data.forEach(p => {
                let option = document.createElement("option");
                option.value = p.name; // must match property casing from JSON
                datalist.appendChild(option);
            });
        } catch (err) {
            console.error("Error fetching:", err);
        }
    });

    // show/hide portal fields
    (function () {
        const chk = document.getElementById('isPortalUser');
        const portalFields = document.querySelectorAll('.portal-fields');
        function toggle() {
            portalFields.forEach(f => f.style.display = chk.checked ? 'block' : 'none');
        }
        if (chk) {
            chk.addEventListener('change', toggle);
            // initial state from server-side value
            toggle();
        }
    })();
</script>