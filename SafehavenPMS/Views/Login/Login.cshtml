@model SafehavenPMS.ViewModel.LoginViewModel

@{
    Layout = "_Login";
    ViewData["Title"] = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>
    body, html {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #004D4D 0%, #003B3B 100%);
        height: 100%;
        overflow: hidden;
    }

    .login-container {
        display: flex;
        min-height: 100vh;
        height: 100dvh;
    }

    .left-panel {
        flex: 1;
        position: relative; /* allow absolute positioning of the highlight */
        background: url('Images/loginImage.png') center center no-repeat;
        background-size: cover;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background-color: #63656589;
        clip-path: polygon(0 0, 100% 0, 80% 100%, 0% 100%);
    }

    /* place highlight closer to the bottom */
    .left-panel .text-highlight {
        position: absolute;
        bottom: 165px;               /* move it a bit up from the bottom */
        display: block;
        width: auto;
        box-sizing: border-box;
        padding: 16px 20px;
        border-radius: 10px;
        margin: 0;
        color: #fff;
    }

    /* smaller screens: reduce offset and padding */
    @@media (max-width: 768px) {
        .left-panel .text-highlight {
            left: 12px;
            right: 12px;
            bottom: 24px;
            padding: 12px;
        }
    }

        .left-panel h1 {
            font-weight: 600;
        }

        .left-panel p {
            font-size: 1rem;
            color: #f0eaea;
        }

    .right-panel {
        flex: 1;        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        flex-direction: column;
        padding: 60px;
        clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);
        box-shadow: -10px 0 20px rgba(0, 0, 0, 0.1);
    }

    .form-box {
        background-color: #f1f1f1;
        padding: 40px;
        border-radius: 10px;
        width: 100%;
        max-width: 500px;
        color: #333;
    }

        .form-box h3 {
            font-weight: bold;
            margin-bottom: 10px;
        }

    .form-check-label {
        margin-left: 5px;
    }

    .btn-primary {
        background: linear-gradient(to right, #00b4db, #0083b0);
        border: none;
    }

        .btn-primary:hover {
            opacity: 0.9;
        }

    a {
        color: #0083b0;
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

    /* subtle solid highlight behind left-panel text (no blur) */
    .left-panel .text-highlight {
        display: inline-block;
        background: rgba(228, 228, 228, 0.135); /* dark translucent band to improve contrast */
        padding: 20px 24px;
        margin: 0;
        max-width: 100%;
    }

    .left-panel .text-highlight h1,
    .left-panel .text-highlight p {
        margin: 0;
        color: #fff;
    }

    .left-panel .text-highlight p {
        opacity: 0.95;
        margin-top: 8px;
        font-size: 1rem;
    }

</style>

<div class="login-container">
    <!-- Left Side: Image and Text -->
    <div class="left-panel" style="background-color: #63656589;">
        <div class="text-highlight">
            <h1>Your Recovery Journey Starts Here!</h1>
            <p>Bringing quality healthcare delivery to everyone</p>
        </div>
    </div>

    <!-- Right Side: Login Form -->
    <div class="right-panel">
        <div class="text-center mb-4">
            <h2 style="font-weight: bold;">LOGO</h2>
        </div>

        <div class="form-box">
            <h3 class="text-center">Welcome</h3>
            <p class="mb-4 text-muted text-center">Please sign in to your account</p>

            @* Show validation summary for errors *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div id="login-error-alert" class="alert alert-danger text-center py-2 mb-3" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-controller="Login" asp-action="Login" method="post" class="">
                <div class="col-md-12">
                    <label asp-for="Username" class="form-label">Email or username</label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
             
                <div class="col-md-12 position-relative">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" id="loginPassword" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <span class="position-absolute end-0 translate-middle-y me-3" style="cursor:pointer;top:75%" onclick="togglePassword('loginPassword', this)" >
                        <i class='bx bx-hide' id="toggleLoginPasswordIcon"></i>
                    </span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    @* <div>
                        <input type="checkbox" class="form-check-input" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                    </div> *@
                    <a asp-action="ForgotPassword" asp-controller="Login" class="ms-auto">Forgot Password</a>
                </div>

                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>
        </div>
    </div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', function () {
        var alert = document.getElementById('login-error-alert');
        if (alert) {
            setTimeout(function () {
                alert.style.display = 'none';
            }, 2000);
        }
    });

    function togglePassword(inputId, iconSpan) {
        var input = document.getElementById(inputId);
        var icon = iconSpan.querySelector('i');
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("bx-hide");
            icon.classList.add("bx-show");
        } else {
            input.type = "password";
            icon.classList.remove("bx-show");
            icon.classList.add("bx-hide");
        }
    }
</script>