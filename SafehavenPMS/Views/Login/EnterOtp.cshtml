@model SafehavenPMS.ViewModel.OtpViewModel
@{
    Layout = "_Login";
    ViewData["Title"] = "Enter OTP";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body, html {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #004D4D 0%, #003B3B 100%);
        height: 100%;
        overflow: hidden;
    }
    .login-container {
        display: flex;
        min-height: 100vh;
        height: 100dvh;
    }
    .left-panel {
        flex: 1;
        position: relative;
        background: url('/Images/loginImage.png') center center no-repeat;
        background-size: cover;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background-color: #63656589;
        clip-path: polygon(0 0, 100% 0, 80% 100%, 0% 100%);
    }
    .left-panel .text-highlight {
        position: absolute;
        bottom: 165px;
        display: block;
        width: auto;
        box-sizing: border-box;
        padding: 16px 20px;
        border-radius: 10px;
        margin: 0;
        color: #fff;
        background: rgba(228, 228, 228, 0.135);
        max-width: 100%;
    }
    .left-panel .text-highlight h1,
    .left-panel .text-highlight p {
        margin: 0;
        color: #fff;
    }
    .left-panel .text-highlight p {
        opacity: 0.95;
        margin-top: 8px;
        font-size: 1rem;
    }
    .right-panel {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        flex-direction: column;
        padding: 60px;
        clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);
        box-shadow: -10px 0 20px rgba(0, 0, 0, 0.1);
    }
    .form-box {
        background-color: #f1f1f1;
        padding: 40px;
        border-radius: 10px;
        width: 100%;
        max-width: 500px;
        color: #333;
    }
    .form-box h3 {
        font-weight: bold;
        margin-bottom: 10px;
    }
    .btn-primary {
        background: linear-gradient(to right, #00b4db, #0083b0);
        border: none;
    }
    .btn-primary:hover {
        opacity: 0.9;
    }
    a {
        color: #0083b0;
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
</style>

<div class="login-container">
    <!-- Left Side: Image and Text -->
    <div class="left-panel" style="background-color: #63656589;">
        <div class="text-highlight">
            <h1>Enter OTP</h1>
            <p>Please enter the OTP sent to your email to continue.</p>
        </div>
    </div>

    <!-- Right Side: OTP Form -->
    <div class="right-panel">
        <div class="text-center mb-4">
            <h2 style="font-weight: bold;">LOGO</h2>
        </div>

        <div class="form-box">
            <h3 class="text-center">OTP Verification</h3>
            <p class="mb-4 text-muted text-center">Enter the code sent to your email.</p>

            @if (TempData["OtpError"] != null)
            {
                <div class="alert alert-danger text-center py-2 mb-3" role="alert">
                    @TempData["OtpError"]
                </div>
            }

            <form asp-controller="Login" asp-action="EnterOtp" method="post">
                <div class="mb-3">
                    <label asp-for="Otp" class="form-label">OTP Code</label>
                    <input type="text" asp-for="Otp" class="form-control" required maxlength="6" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Verify</button>
            </form>

            <div class="text-center mt-3">
                <a asp-controller="Login" asp-action="ForgotPassword">Resend OTP</a> |
                <a asp-controller="Login" asp-action="Login">Back to Login</a>
            </div>
        </div>
    </div>
</div>