<!-- Updated modal in your Layout file -->
<div id="appointment-modal" class="modal fade right-modal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-slideout">
        <div class="modal-content border-0 shadow h-100 d-flex flex-column">
            <!-- Modal Header -->
            <div class="modal-header bg-white border-bottom">
                <div class="d-flex align-items-center">
                    <i class='bx bx-calendar-check fs-4 me-2 text-primary'></i>
                    <h5 class="modal-title fw-bold mb-0">Schedule Appointment</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body overflow-auto flex-grow-1">
                <form id="appointment-form" asp-controller="Appointment" asp-action="ScheduleAssessment" method="post">
                    <!-- Hidden field for patient ID -->
                    <input type="hidden" id="modalPatientId" name="PatientId" value="" />
                    <div class="mb-3">
                        <label for="appointmentDate" class="form-label">Date</label>
                        <input type="date" class="form-control" id="appointmentDate" name="AppointmentDate" required>
                    </div>

                    <div class="mb-3 border-bottom p-3">
                        <label class="form-label">Available Time</label>
                        <div id="time-slots" class="row g-4">
                            <!-- dynamically filled -->
                        </div>
                    </div>

                    @* Populated by Patient Name *@
                    <div class="mb-3">
                        <label for="duration" class="form-label">Patient Name</label>
                        <input type="text" class="form-control" id="patientName" name="PatientName" disabled>
                    </div>

                    <div class="mb-3">
                        <label for="clinicalStaff" class="form-label">Assign Clinical Staff</label>
                        <input type="text" class="form-control" id="staffName" name="StaffName" disabled>
                    </div>

                    <div class="mb-3">
                        <label for="duration" class="form-label">Visit Type</label>
                        <select class="form-select" id="duration" name="Duration">
                            <option>--Select--</option>
                            <option value="Medical Assessment">Medical Assessment</option>
                            <option value="Emergency Visit">Emergency Visit</option>
                            <option value="Follow-Up Treatment">Follow-Up Treatment</option>
                            <option value="Others">Others</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="notes" class="form-label">Add Description</label>
                        <textarea class="form-control" id="notes" name="Notes" rows="3" placeholder="Additional notes for the assessment..."></textarea>
                    </div>
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-white border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn-custom btn-primary" form="appointment-form">
                    <i class='bx bx-calendar-plus me-1'></i>
                    Schedule Appointment
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .right-modal .modal-dialog-slideout {
        min-height: 100%;
        margin: 0 0 0 auto;
        max-width: 500px;
        width: 100%;
    }

    .right-modal .modal.fade .modal-dialog-slideout {
        transform: translate(100%, 0);
        transition: transform 0.3s ease-out;
    }

    .right-modal .modal.fade.show .modal-dialog-slideout {
        transform: translate(0, 0);
    }

    @@media (max-width: 576px) {
        .right-modal .modal-dialog-slideout {
            max-width: 100%;
            margin: 0;
        }
    }

    .badge-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .bg-warning {
        background-color: #FF9900;
    }
</style>
<script>
    // Track currently selected time slot button
    let selectedSlot = null;

    // Store selected slot's appointment-related data
    let selectedSlotData = null;

    // Event listener: When appointment date changes
    document.getElementById('appointmentDate').addEventListener('change', function () {
        let date = this.value; // Get chosen date
        let patientId = document.getElementById('modalPatientId').value; // Get patient ID from modal hidden field

        // Stop if no date selected
        if (!date) return;

        // Stop if patient ID is missing or invalid
        if (!patientId || patientId === '0') {
            alert('Invalid patient ID. Please try again.');
            return;
        }

        console.log(`Fetching availability for patientId=${patientId}, date=${date}`);

        // Fetch available time slots from server
        fetch(`/Appointment/GetAvailabilityTime?id=${patientId}&date=${date}`)
            .then(res => res.json()) // Convert response to JSON
            .then(data => {
                console.log("Full server response:", data); // Log full response for debugging

                let container = document.getElementById('time-slots'); // Container for time slot buttons
                container.innerHTML = ''; // Clear previous slots

                // If patient name exists, update the input
                if (data.patientName) {
                    document.querySelector('input[name="PatientName"]').value = data.patientName;
                }

                // If staff name exists, update the input
                if (data.staffName) {
                    document.querySelector('input[name="StaffName"]').value = data.staffName;
                }

                // If no time slots available, show message and stop
                if (!data.success || !data.timeSlots || data.timeSlots.length === 0) {
                    container.innerHTML = '<div class="col-12 text-muted">No availability</div>';
                    return;
                }

                console.log("Available timeSlots:", data.timeSlots); // Debug time slot array

                // Loop through each time slot returned by the server
                data.timeSlots.forEach(ts => {
                    let slotHTML = document.createElement('div'); // Create slot container
                    slotHTML.className = 'col-md-3'; // Bootstrap column size

                    // Create clickable time slot button
                    slotHTML.innerHTML = `
                        <div class="time-container text-center"
                             style="border:1px solid Gray; border-radius:6px; cursor:pointer;color:#069FB2">
                            ${ts.startTime}
                        </div>`;

                    let slotButton = slotHTML.querySelector('.time-container'); // Get slot button element

                    // Add click event for selecting slot
                    slotButton.addEventListener('click', function () {
                        // Reset style of previously selected slot if different
                        if (selectedSlot && selectedSlot !== slotButton) {
                            selectedSlot.style.backgroundColor = '';
                            selectedSlot.style.color = '#069FB2';
                        }

                        // If clicked again, deselect it
                        if (slotButton === selectedSlot) {
                            slotButton.style.backgroundColor = '';
                            slotButton.style.color = '#069FB2';
                            selectedSlot = null;
                            selectedSlotData = null;
                            return;
                        } else {
                            // Highlight the selected slot
                            slotButton.style.backgroundColor = '#069FB2';
                            slotButton.style.color = 'white';
                            selectedSlot = slotButton;

                            // Store necessary slot data for appointment submission
                            selectedSlotData = {
                                appointmentDate: date, // Chosen date
                                availabilityId: ts.availabilityId || ts.availability?.availabilityId, // Handle both direct & nested
                                staffId: ts.st || ts.availability?.staffId || ts.staff?.staffId, // Handle both direct & nested
                                timeSlotId: ts.timeSlotId || ts.id || ts.slotId, // Handle multiple possible keys
                                startTime: ts.startTime // Slot start time
                            };

                            console.log("Selected slot data:", selectedSlotData); // Debug selected slot info
                        }
                    });

                    container.appendChild(slotHTML); // Add slot to container
                });
            })
            .catch(err => {
                console.error("Error fetching availability:", err); // Log fetch errors
                alert('Error loading availability.'); // Show user-friendly message
            });
    });

    // Event listener: When schedule button is clicked
    document.querySelector('button[form="appointment-form"]').addEventListener('click', function (event) {
        event.preventDefault(); // Prevent default form submit

        // Ensure a slot has been selected
        if (!selectedSlotData) {
            alert("Please select a time slot before scheduling.");
            return;
        }

        // Prepare appointment data payload
        let payload = {
            appointmentDate: selectedSlotData.appointmentDate, // Date from selected slot
            availabilityId: selectedSlotData.availabilityId, // Availability ID from slot
            description: document.getElementById('notes').value, // Notes from form
            patientId: document.getElementById('modalPatientId').value, // Patient ID from modal
            ClinicalStaffID: selectedSlotData.staffId, // Staff ID from slot
            status: "Pending", // Default status
            timeSlotId: selectedSlotData.timeSlotId, // Time slot ID from slot
            visitType: document.getElementById('duration').value // Visit type from form
        };

        console.log("Submitting appointment payload:", payload); // Debug payload

        // Send POST request to schedule appointment
        fetch('/Appointment/Schedule', {
            method: 'POST', // Use POST request
            headers: { 'Content-Type': 'application/json' }, // Send JSON data
            body: JSON.stringify(payload) // Convert JS object to JSON string
        })
        .then(res => {
            console.log("Response status:", res.status); // Debug status code
            return res.text(); // Get raw text for logging
        })
        .then(text => {
            console.log("Raw response text:", text); // Debug raw response

            let parsed = {};
            try {
                parsed = JSON.parse(text); // Try parsing JSON
            } catch (e) {
                console.error("Failed to parse JSON:", e); // Log parse error
            }

            console.log("Parsed response object:", parsed); // Debug parsed object

            // If successful, notify user
            if (parsed.success) {
                alert('Appointment scheduled!');
            } else {
                // If failed, show message from server or default message
                alert('Failed to schedule appointment: ' + (parsed.message || 'Unknown error'));
            }
        })
        .catch(err => {
            console.error("Error submitting appointment:", err); // Log network error
            alert('Error submitting appointment.'); // Notify user
        });
    });
</script>


