<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>


<div id="appointmentCalendar"></div>

<style>
    #appointmentCalendar {
        max-width: 100%;
        margin: 0 auto;
        background: white;
        padding: 20px;
        border-radius: 8px;
    }

    /* Header background and padding */
    .fc .fc-toolbar.fc-header-toolbar {
        background: linear-gradient(to right, #069FB2, #058594);
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        margin-bottom: 10px;
    }

    /* Title text (e.g., "August 2025") */
    .fc .fc-toolbar-title {
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
    }

    /* Day numbers in dark teal */
    .fc .fc-daygrid-day-number {
        color: #015F6B;
        font-weight: 600;
    }

    /* Grid lines in light teal */
    .fc .fc-scrollgrid,
    .fc .fc-scrollgrid td,
    .fc .fc-daygrid-day {
        border-color: #b3dfe5;
    }

    /* Background for better readability */
    .fc .fc-daygrid-day-frame {
        background-color: #f8fcfc;
    }

    /* Change the color of the day names in the calendar header */
    .fc .fc-col-header-cell-cushion {
        color: #015F6B; /* Dark teal or your preferred color */
        font-weight: 600;
        font-size: 0.95rem;
    }
</style>

<script>
    // Wait until the entire HTML document is loaded before running this script
    document.addEventListener('DOMContentLoaded', function () {
        // Find the calendar container element by ID
        var calendarEl = document.getElementById('appointmentCalendar');

        // Create a new FullCalendar instance
        var calendar = new FullCalendar.Calendar(calendarEl, {
            // Set the default calendar view to a full month
            initialView: 'dayGridMonth',
            height: 'auto', // Let the calendar adjust its height automatically

            // Load events from your controller (must return JSON)
            events: '/Appointments/GetAppointments',

            // Setup header toolbar buttons
            headerToolbar: {
                left: 'prev,next today', // navigation buttons
                center: 'title',         // current month/year title
                right: 'dayGridMonth,timeGridWeek,timeGridDay' // view toggle buttons
            },

            selectable: true, // allow selecting dates on the calendar

            // When a calendar day is clicked
            dateClick: function(info) {
                const selectedDate = info.dateStr; // the date clicked in YYYY-MM-DD format

                // Initialize Flatpickr on the date input inside the modal
                const flatpickrInstance = flatpickr("#appointmentDateModal", {
                    defaultDate: selectedDate,  // pre-fill the clicked date
                    dateFormat: "Y-m-d"         // keep format consistent with the backend
                });

                // Manually update Flatpickr to ensure it's using the clicked date
                flatpickrInstance.setDate(selectedDate, true);

                // Open the Bootstrap modal with ID 'calendar-modal'
                var modal = new bootstrap.Modal(document.getElementById('calendar-modal'));
                modal.show();
            },

            // When an event (appointment) is clicked
            eventClick: function(info) {
                alert('Appointment: ' + info.event.title); // show the title in a popup
                // You can replace this with opening an "Edit" modal instead
            },

            // Highlight today's cell in the calendar (in dayGridMonth view)
            dayCellDidMount: function (info) {
                const today = new Date();       // get today's date
                const cellDate = info.date;     // the date for the current cell

                // Check if this cell is today (compare only year, month, day)
                if (
                    cellDate.getFullYear() === today.getFullYear() &&
                    cellDate.getMonth() === today.getMonth() &&
                    cellDate.getDate() === today.getDate()
                ) {
                    // Apply custom styles to visually highlight today
                    info.el.style.backgroundColor = '#fff4e5';  // light teal background
                    info.el.style.border = '2px solid #00A3B4'; // border to emphasize
                    info.el.style.borderRadius = '8px';         // rounded corners
                }
            }
        });

        // Finally, render the calendar to the page
        calendar.render();
    });

</script>