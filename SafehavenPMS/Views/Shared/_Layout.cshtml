<script>
    document.addEventListener('submit', function (e) {
        var overlay = document.getElementById('loadingOverlay');

        // Check if the form being submitted is inside a modal
        var form = e.target;
        var isModalForm = form.closest('.modal') !== null;

        // Only show loader if it's not a modal form
        if (overlay && !isModalForm) {
            overlay.style.display = 'flex';
        }
    }, true);

    window.addEventListener('pageshow', function () {
        const overlay = document.getElementById('loadingOverlay');
        if (overlay) overlay.style.display = 'none';
    });

    // NEW: sidebar toggle and submenu behavior (improved)
    document.addEventListener('DOMContentLoaded', function () {
        const sidebar = document.querySelector('.sidebar');
        const menuToggle = document.querySelector('.home-content-left i'); // menu icon
        if (menuToggle && sidebar) {
            menuToggle.addEventListener('click', function () {
                sidebar.classList.toggle('close');
            });
        }

        // Attach click handlers to the anchor with class "nav-parent"
        document.querySelectorAll('a.nav-parent').forEach(function (anchor) {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();

                const li = anchor.closest('li');
                if (!li) return;

                // toggle visual open state on the li
                li.classList.toggle('open');

                // toggle the submenu visibility
                const submenu = li.querySelector('.submenu');
                if (submenu) {
                    submenu.classList.toggle('show');
                }

                // close other submenus in the same level
                const allSubmenus = li.parentElement.querySelectorAll('> li > .submenu');
                allSubmenus.forEach(function (otherSubmenu) {
                    if (otherSubmenu !== submenu) {
                        otherSubmenu.classList.remove('show');
                        otherSubmenu.closest('li').classList.remove('open');
                    }
                });
            });
        });
    });

    (function(){
    const badge = document.getElementById('notifBadge');
    const list = document.getElementById('notifList');
    const refresh = document.getElementById('notif-refresh');

    async function load(){
        const r = await fetch('/PatientProfile/UnreadNotifications');
        if(!r.ok) return;
        const data = await r.json();
        if(!data.length){
            list.innerHTML = '<li class="p-2 small text-muted">No new notifications</li>';
            badge?.classList.add('d-none');
            return;
        }
        badge.textContent = data.length;
        badge.classList.remove('d-none');
        list.innerHTML = '';
        data.forEach(n=>{
            const li = document.createElement('li');
            li.className='p-2 small border-bottom';
            li.innerHTML = `
                <div class="d-flex justify-content-between">
                    <span>${escapeHtml(n.message)}</span>
                    <button class="btn btn-sm btn-light ms-2 mark-read" data-id="${n.notificationId}">&times;</button>
                </div>
                <div class="text-muted mt-1" style="font-size:.6rem;">${n.createdAt}</div>
            `;
            li.addEventListener('click', e => {
                if(e.target.closest('.mark-read')) markRead(n.notificationId, li);
                else if(n.linkUrl) window.location = n.linkUrl;
            });
            list.appendChild(li);
        });
    }
    async function markRead(id, li){
        await fetch('/PatientProfile/MarkNotificationRead?id='+id, {method:'POST'});
        li.remove();
        if(!list.children.length){
            badge.classList.add('d-none');
            list.innerHTML='<li class="p-2 small text-muted">No new notifications</li>';
        }else{
            badge.textContent = list.children.length;
        }
    }
    function escapeHtml(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

    refresh?.addEventListener('click', e => { e.preventDefault(); load(); });
    load();
    setInterval(load, 60000);
})();

    (function () {
        const token = document.querySelector('meta[name="request-verification-token"]')?.content;

        // Elements
        const wrapper = document.getElementById('notifWrapper');
        const toggleBtn = document.getElementById('notifToggle');
        const dropdown = document.getElementById('notifDropdown');
        const badge = document.getElementById('notifBadge');
        const list = document.getElementById('notifList');
        const btnRefresh = document.getElementById('notif-refresh');
        const btnMarkAll = document.getElementById('notif-mark-all');

        if (!wrapper) return;

        let loading = false;
        let opened = false;

        function openDropdown() {
            dropdown.classList.remove('d-none');
            toggleBtn.setAttribute('aria-expanded', 'true');
            opened = true;
        }
        function closeDropdown() {
            dropdown.classList.add('d-none');
            toggleBtn.setAttribute('aria-expanded', 'false');
            opened = false;
        }
        function toggleDropdown() {
            opened ? closeDropdown() : openDropdown();
        }

        toggleBtn.addEventListener('click', e => {
            e.stopPropagation();
            toggleDropdown();
            if (opened) loadNotifications();
        });

        document.addEventListener('click', e => {
            if (opened && !wrapper.contains(e.target)) closeDropdown();
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && opened) closeDropdown();
        });

        async function loadNotifications() {
            if (loading) return;
            loading = true;
            list.innerHTML = '<li class="notif-empty">Loading...</li>';
            try {
                const r = await fetch('/PatientProfile/UnreadNotifications', { headers: { 'Accept': 'application/json' } });
                if (!r.ok) throw new Error('Failed');
                const data = await r.json();
                if (!Array.isArray(data) || !data.length) {
                    list.innerHTML = '<li class="notif-empty">No new notifications</li>';
                    badge.classList.add('d-none');
                    return;
                }
                badge.textContent = data.length;
                badge.classList.remove('d-none');
                list.innerHTML = '';
                data.forEach(n => {
                    const li = document.createElement('li');
                    li.className = 'unread';
                    li.dataset.id = n.notificationId;
                    li.innerHTML = `
                            <div class="fw-semibold" style="font-size:.78rem;">${escapeHtml(n.title || 'Notification')}</div>
                            <div style="font-size:.72rem;">${escapeHtml(n.message || '')}</div>
                            <span class="small-time">${escapeHtml(n.createdAt || '')}</span>
                        `;
                    li.addEventListener('click', () => {
                        markRead(n.notificationId, li, n.linkUrl);
                    });
                    list.appendChild(li);
                });
            } catch {
                list.innerHTML = '<li class="notif-empty text-danger">Error loading notifications</li>';
            } finally {
                loading = false;
            }
        }

        async function markRead(id, li, link) {
            try {
                await fetch('/PatientProfile/MarkNotificationRead?id=' + encodeURIComponent(id), {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token || ''
                    }
                });
            } catch { }
            li.remove();
            updateBadge();
            if (link) window.location = link;
            if (!list.children.length) {
                list.innerHTML = '<li class="notif-empty">No new notifications</li>';
            }
        }

        async function markAllRead() {
            const ids = [...list.querySelectorAll('li[data-id]')].map(li => li.dataset.id);
            if (!ids.length) return;
            try {
                await fetch('/PatientProfile/MarkAllNotificationsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify(ids)
                });
            } catch { }
            list.innerHTML = '<li class="notif-empty">No new notifications</li>';
            badge.classList.add('d-none');
        }

        function updateBadge() {
            const remaining = list.querySelectorAll('li[data-id]').length;
            if (!remaining) {
                badge.classList.add('d-none');
            } else {
                badge.textContent = remaining;
            }
        }

        function escapeHtml(s) {
            return (s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        btnRefresh?.addEventListener('click', e => {
            e.preventDefault();
            loadNotifications();
        });
        btnMarkAll?.addEventListener('click', e => {
            e.preventDefault();
            markAllRead();
        });

        // Initial (silent) preload to show badge
        loadNotifications();
        setInterval(() => loadNotifications(), 60000);
    })();
</script>
