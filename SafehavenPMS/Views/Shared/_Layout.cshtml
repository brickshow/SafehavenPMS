    <style>
        /* hide submenus by default and show when .show applied */
        ul.submenu {
            display: none;
            margin: 0;
            padding-left: 12px;
        }
        ul.submenu.show {
            display: block;
        }

        /* caret rotation when parent open */
        .nav-parent .caret {
            transition: transform .18s ease;
            display: inline-block;
        }
        li.open > a .caret {
            transform: rotate(-180deg);
        }

        /* safety: also allow li.open to show submenu */
        li.open > .submenu {
            display: block;
        }

        /* ---------- NEW: Hover dropdown / flyout when sidebar is collapsed ---------- */
        /* Only enable hover behaviour on devices that support hover (non-touch) */
        @@media (hover: hover) {
            /* make each nav item a positioning context */
            .nav-links li {
                position: relative;
            }

            /* Support both .submenu and .dropdown (markup uses both in places) */
            .sidebar.close .nav-links li:hover > .submenu,
            .sidebar.close .nav-links li:hover > .dropdown {
                display: block;
                position: absolute;
                left: calc(100% + 10px); /* place flyout to the right of collapsed sidebar */
                top: 0;
                min-width: 200px;
                background: var(--sidebar-bg, #fff);
                color: inherit;
                padding: 8px 0;
                box-shadow: 0 6px 18px rgba(0,0,0,0.08);
                border-radius: 6px;
                z-index: 1050;
                white-space: nowrap;
            }

            /* item layout inside flyout */
            .sidebar.close .nav-links li:hover > .submenu li,
            .sidebar.close .nav-links li:hover > .dropdown li {
                display: block;
                padding: 6px 16px;
            }
            .sidebar.close .nav-links li:hover > .submenu li a,
            .sidebar.close .nav-links li:hover > .dropdown li a {
                color: inherit;
                display: inline-block;
                width: 100%;
            }

            /* keep caret rotation on hover when opening via hover */
            .sidebar.close .nav-links li:hover > a .caret {
                transform: rotate(-180deg);
            }
        }
        /* --------------------------------------------------------------------------- */

        /* Reduce icon size for sidebar and header */
        .sidebar .bx,
        .home-content .bx,
        .user-info-header .bx,
        .notification-icon .bx {
            font-size: 1.2rem !important;
        }
    </style>
</head>
