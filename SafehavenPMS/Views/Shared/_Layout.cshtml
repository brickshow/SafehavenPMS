<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SafeHaven</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* SweetAlert2 for better notifications *@
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Bootstrap bundle *@  

    <!-- Select2 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @* Injecting Fullcalendar Via CDN *@
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />

    @* Use Flatpickr CDN *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @* Icons8 *@
    <link rel="stylesheet" href="https://cdn.lineicons.com/2.0/LineIcons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SafeHavenPatientManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="sidebar close">
        <!-- Logo -->
        <div class="logo-details">
            <i class='bx bxs-plus-medical'></i>
            <span class="logo_name">SafeHaven</span>
        </div>

        <!-- Navigation Links -->
        <ul class="nav-links">
            <!-- Dashboard -->
            <li class="navigation @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                <a asp-controller="Home" asp-action="Index">
                    <i class='bx bxs-dashboard'></i>
                    <span class="link_name">Dashboard</span>
                </a>
            </li>
            <!-- Patient -->
            <li class="navigation @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" ? "active" : "")">
                <a href="#" class="nav-parent">
                    <i class='bx bxs-user-detail'></i>
                    <span class="link_name">Patients</span>
                    <i class='bx bx-chevron-down caret'></i>
                </a>
                <ul class="submenu">
                    <li>
                        <a asp-controller="Patient" asp-action="AddNewPatient">
                            <span>Register Patient </span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Patient" asp-action="Index">
                            <span>Patient List</span>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Intake" asp-action="Index">
                            <span>Intake</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admission" asp-action="Index">
                            <span>Admission</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Transfer" asp-action="Index">
                            <span>Transfer</span>
                        </a>
                    </li>   
                    <li>
                        <a asp-controller="Admission" asp-action="Index">
                            <span>Treatment Plan</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Discharge" asp-action="Index">
                            <span>Discharge</span>
                        </a>
                    </li>
                </ul>
            </li>
            <!-- Scheduling -->
            <li class="navigation @(ViewContext.RouteData.Values["controller"]?.ToString() == "Scheduling" ? "active" : "")">
                <a asp-controller="Scheduling" asp-action="Index">
                    <i class='bx bxs-time'></i>
                    <span class="link_name">Scheduling</span>
                </a>
            </li>
            <!-- Assessment -->
            <li class="navigation @(ViewContext.RouteData.Values["controller"]?.ToString() == "Assessment" ? "active" : "")">
                <a href="#" class="nav-parent">
                    <i class='bx bxs-user-detail'></i>
                    <span class="link_name">Assessment</span>
                    <i class='bx bx-chevron-down caret'></i>
                </a>
                <ul class="submenu">
                    <li>
                        <a asp-controller="Assessment" asp-action="Index">
                            <span>Initial Assessment</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Assessment" asp-action="Index">
                            <span>Psychiatric Assessment</span>
                        </a>
                    </li>
                </ul>
            </li>
            </li>
            <!-- Clinical Staff -->
            <li class="navigation @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClinicalStaff" ? "active" : "")">
                <a asp-controller="ClinicalStaff" asp-action="Index">
                    <i class='bx bxs-group'></i>
                    <span class="link_name">Clinical Staff</span>
                </a>
            </li>
            <!-- Doctor Schedule -->
            <li class="navigation">
                <a asp-controller="Appointment" asp-action="Index">
                    <i class='bx bxs-calendar-event'></i>
                    <span class="link_name">Doctor Schedule</span>
                </a>
            </li>
            <!-- Medication -->
            <li class="navigation">
                <a asp-controller="Medication" asp-action="Index">
                    <i class='bx bxs-capsule'></i>
                    <span class="link_name">Medication</span>
                </a>
            </li>
            <!-- Billing -->
            <li class="navigation">
                <a asp-controller="Reports" asp-action="Index">
                    <i class='bx bxs-receipt'></i>
                    <span class="link_name">Billing</span>
                </a>
            </li>
            <!-- Email -->
            <li class="navigation">
                <a asp-controller="Email" asp-action="Index">
                    <i class='bx bxs-envelope'></i>
                    <span class="link_name">Email</span>
                </a>
            </li>
            <!-- Templates -->
            <li class="navigation">
                <a asp-controller="Templates" asp-action="Index">
                    <i class='bx bxs-file-blank'></i>
                    <span class="link_name">Templates</span>
                </a>
            </li>
            <!-- Users -->
            <li class="navigation">
                <a asp-controller="Users" asp-action="Index">
                    <i class='bx bxs-user-account'></i>
                    <span class="link_name">Users</span>
                </a>
            </li>
            <!-- Settings -->
            <li class="navigation">
                <a asp-controller="Settings" asp-action="Index">
                    <i class='bx bxs-cog'></i>
                    <span class="link_name">Settings</span>
                </a>
            </li>
        </ul>
        <!-- Bottom Section with DateTime and Logout -->
        <div class="sidebar-footer">
            <form asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">
                <button type="submit" class="logout-button">
                    <i class='bx bx-log-out'></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </div>
    <!-- Main Content Section -->
    <section class="home-section">
        <div class="home-content">
            <div class="home-content-left">
                <i class='bx bx-menu'></i>
            </div>
            <div class="home-content-right">
                <!-- Message icon -->
                <div class="notification-icon">
                    <i class='bx bxs-message'></i>
                    <span class="notification-badge">3</span>
                </div>
                <!-- Notification Bell icon -->
                <div class="notification-icon">
                    <i class='bx bxs-bell'></i>
                    <span class="notification-badge">3</span>
                </div>
                <!-- User Info -->
                <div class="user-info-header">
                    <i class='bx bxs-user'></i>
                    <span>Admin</span>
                </div>
            </div>
        </div>
        <div class="main-content">
            @RenderBody()
        </div>
    </section>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Global Appointment Modal -->
    @await Html.PartialAsync("_AddAppointmentModal")

    @await RenderSectionAsync("Scripts", required: false)



    @* Loader *@
    <div id="loadingOverlay" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:9999;align-items:center;justify-content:center;">
        @* Imported from UIVerse *@
        <div class="loader"></div>
    </div>

    @* Success Message *@
    <!-- Success Indicator Modal -->
    <div class="modal fade" id="waitlistSuccessModal" tabindex="-1" aria-labelledby="waitlistSuccessLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4 text-center">
                <div class="modal-body">
                    <i class='bx bx-check-circle' style="font-size:3rem;color:#00A3B4;"></i>
                    <h5 class="mt-3 mb-2 fw-bold" id="waitlistSuccessLabel">Patient Added in the waitlist</h5>
                    <button type="button" class="btn btn-teal mt-2" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    @* FUll Calendar CDN *@
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>


</body>
</html>


<script>
    document.addEventListener('submit', function (e) {
        var overlay = document.getElementById('loadingOverlay');

        // Check if the form being submitted is inside a modal
        var form = e.target;
        var isModalForm = form.closest('.modal') !== null;

        // Only show loader if it's not a modal form
        if (overlay && !isModalForm) {
            overlay.style.display = 'flex';
        }
    }, true);

    window.addEventListener('pageshow', function () {
        const overlay = document.getElementById('loadingOverlay');
        if (overlay) overlay.style.display = 'none';
    });
</script>
