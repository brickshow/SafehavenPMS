    <style>
        /* Notification dropdown styles */
        .notification-wrapper { position: relative; }
        .notif-btn {
            background: transparent; border: none; position: relative; cursor: pointer; padding: 6px;
        }
        .notif-btn:focus { outline: 2px solid #0aa; outline-offset:2px; }
        .notification-badge {
            position: absolute; top: 2px; right: 2px; background:#dc3545; color:#fff;
            border-radius: 12px; padding:0 6px; font-size:.65rem; line-height:18px; min-width:18px; text-align:center;
        }
        .notif-dropdown {
            position: absolute; top: 42px; right: 0; width: 360px; max-height: 480px;
            background:#fff; border:1px solid #ddd; border-radius:8px; padding:0;
            display:flex; flex-direction:column; z-index: 1200;
        }
        .notif-dropdown.d-none { display:none; }
        .notif-dropdown-header {
            padding:8px 12px; border-bottom:1px solid #eee; display:flex; justify-content:space-between; align-items:center;
        }
        .notif-dropdown-header h6 { margin:0; font-size:.9rem; font-weight:600; }
        .notif-actions button {
            background: none; border: none; font-size:.7rem; text-transform:uppercase;
            letter-spacing:.5px; color:#0a6c84; padding:2px 6px; cursor:pointer;
        }
        .notif-actions button:hover { text-decoration:underline; }
        #notifList { list-style:none; margin:0; padding:0; overflow-y:auto; flex:1; }
        #notifList li { padding:10px 12px; border-bottom:1px solid #f1f1f1; cursor:pointer; }
        #notifList li.unread { background:#f5fbfc; }
        #notifList li:hover { background:#eef7f8; }
        #notifList .small-time { font-size:.65rem; color:#6c757d; margin-top:4px; display:block; }
        .notif-empty { padding:30px 16px; text-align:center; font-size:.8rem; color:#888; }
        .notif-footer {
            padding:6px 10px; border-top:1px solid #eee; text-align:right;
        }
        .notif-footer a { font-size:.7rem; text-decoration:none; color:#0a6c84; }
        .notif-footer a:hover { text-decoration:underline; }
        @@media (max-width:520px){
            .notif-dropdown { width: 90vw; right:-30px; }
        }
    </style>
</head>

