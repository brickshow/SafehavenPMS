@using System.Security.Claims
@{
    var roleClaim = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "(no role)";
}
@* <div style="position:fixed;right:12px;top:12px;z-index:9999;background:#fff;padding:6px;border:1px solid #eee;">
    <small>User: @User?.Identity?.Name ?? "(anon)"</small><br />
    <small>Role: @roleClaim</small>
</div> *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SafeHaven</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* SweetAlert2 for better notifications *@
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Bootstrap bundle *@  

    <!-- Select2 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @* Injecting Fullcalendar Via CDN *@
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />

    @* Use Flatpickr CDN *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @* Icons8 *@
    <link rel="stylesheet" href="https://cdn.lineicons.com/2.0/LineIcons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SafeHavenPatientManagementSystem.styles.css" asp-append-version="true" />



</head>
<body>
    <div class="sidebar close">
        <!-- Logo -->
        <div class="logo-details">
            <i class='bx bxs-plus-medical'></i>
            <span class="logo_name">SafeHaven</span>
        </div>

        @functions {
    // simple helper to check multiple roles
        private bool HasAnyRole(params string[] roles)
        {
            if (User?.Identity?.IsAuthenticated != true) return false;
            var claims = User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value?.Trim().ToLowerInvariant());
            foreach (var r in roles)
            {
                if (claims.Contains(r.Trim().ToLowerInvariant())) return true;
            }
            // fallback to IsInRole for completeness
            foreach (var r in roles)
            {
                if (User.IsInRole(r)) return true;
            }
            return false;
        }
    }

         @if (User.IsInRole("Family"))
    {
        <ul class="sd-nav-links">
            <li class="navigation">
                <a asp-controller="Home" asp-action="Index">
                    <i class='bx bxs-dashboard'></i>
                    <span class="link_name">Dashboard</span>
                </a>
            </li>

            <li class="navigation">
                <a asp-controller="Billing" asp-action="Index">
                    <i class='bx bxs-receipt'></i>
                    <span class="link_name">Billing</span>
                </a>
            </li>
        </ul>
    }
    else
    {
        <ul class="nav-links">
    <!-- Dashboard -->
   <li class="navigation @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
        <a href="/Home/Index/" data-label="Dashboard">
            <i class='bx bxs-dashboard'></i>                    <!-- Dashboard -->
            <span class="sd-link-name">Dashboard</span>
        </a>
        <ul class="submenu">
            <li><a href="/Home/Index/">Dashboard</a></li>
        </ul>
    </li>

    @* Patient Management *@
    @if (HasAnyRole("Admin","Staff","Doctor","Physician","Psychiatrist","Nurse","RecoveryCoach","SocialWorker","OccupationalTherapist","Psychologist"))
    {
        <li class="navigation">
            <a href="#" class="nav-parent">
                <i class='bx bxs-user'></i>                     <!-- Patient Management -->
                <span class="link_name">Patient Management</span>
                <i class='bx bx-chevron-down caret'></i>
            </a>
            <ul class="submenu">
                @* Register patient: Admin or staff roles *@
                @if (HasAnyRole("Admin","Staff"))
                {
                    <li>
                        <a asp-controller="Patient" asp-action="AddNewPatient">
                            <span>Register Patient</span>
                        </a>
                    </li>
                }

                @* Patient list: Admin, staff and clinical roles (clinicians will be filtered by controller) *@
                @if (HasAnyRole("Admin","Physician","Psychiatrist","Nurse","RecoveryCoach","SocialWorker","OccupationalTherapist","Psychologist"))
                {
                    <li>
                        <a asp-controller="Patient" asp-action="Index">
                            <span>Patient List</span>
                        </a>
                    </li>
                }

                @* Progress notes: clinical roles only (view / add depends on ProgressNote controller permissions) *@
                @if (HasAnyRole("Admin","Physician","Psychiatrist","Nurse","RecoveryCoach","SocialWorker","OccupationalTherapist","Psychologist"))
                {
                    <li>
                        <a asp-controller="ProgressNote" asp-action="Index">
                            <span>Progress Notes</span>
                        </a>
                    </li>
                }   
            </ul>
        </li>
    }

    @* Patient Movements (Intake/Approval/Admission/Discharge) - typically admin + clinical staff *@
    @if (HasAnyRole("Admin","Staff","Doctor","Physician","Psychiatrist","Nurse"))
    {
        <li class="navigation">
            <a href="#" class="nav-parent">
                <i class='bx bx-detail'></i>                 <!-- Patient Movements -->
                <span class="link_name">Patient Movements</span>
                <i class='bx bx-chevron-down caret'></i>
            </a>
            <ul class="submenu">
                <li><a asp-controller="Intake" asp-action="Index"><span>Intake</span></a></li>
                <li><a asp-controller="Approval" asp-action="Index"><span>Approval</span></a></li>
                <li><a asp-controller="Admission" asp-action="Index"><span>Admission</span></a></li>
                <li><a asp-controller="DischargedPatient" asp-action="Index"><span>Discharge</span></a></li>
            </ul>
        </li>
    }

    @* Scheduling: clinicians + admin + recovery coach (clinician pages will filter assigned patients) *@
    @if (HasAnyRole("Admin","Staff","Doctor","Physician","Psychiatrist","Nurse","RecoveryCoach"))
    {
        <li class="navigation">
            <a href="#" class="nav-parent">
                <i class='bx bxs-calendar'></i>                  <!-- Scheduling -->
                <span class="link_name">Scheduling</span>
                <i class='bx bx-chevron-down caret'></i>
            </a>
            <ul class="submenu">
                <li><a asp-controller="Appointment" asp-action="Index"><span>Doctor's Calendar</span></a></li>
                <li><a asp-controller="Scheduling" asp-action="Index"><span>General Scheduling</span></a></li>
            </ul>
        </li>
    }

    @* Assessment: clinicians only *@
    @if (HasAnyRole("Admin","Doctor","Physician","Psychiatrist","Nurse"))
    {
        <li class="navigation">
            <a href="#" class="nav-parent">
                <i class='bx bx-clipboard'></i>                 <!-- Assessment -->
                <span class="link_name">Assessment</span>
                <i class='bx bx-chevron-down caret'></i>
            </a>
            <ul class="submenu">
                <li><a asp-controller="Assessment" asp-action="Index"><span>Initial Assessment</span></a></li>
                <li><a asp-controller="PsychiatricAssessment" asp-action="Index"><span>Psychiatric Assessment</span></a></li>
            </ul>
        </li>
    }

    @* Clinical Staff: show to Admin and Staff *@
    @if (HasAnyRole("Admin","Staff"))
    {
        <li class="navigation">
            <a href="/ClinicalStaff/Index/" data-label="Clinical Staff">
                <i class='bx bxs-group'></i>                    <!-- Clinical Staff -->
                <span class="sd-link-name">Clinical Staff</span>
            </a>
            <ul class="submenu">
                <li><a href="/ClinicalStaff/Index/">Clinical Staff</a></li>
            </ul>
        </li>
    }

    @* Medication: Nurses, Doctors, Pharmacist/Med staff, Admin *@
    @if (HasAnyRole("Admin","Doctor","Physician","Psychiatrist","Nurse","Pharmacist"))
    {
        <li class="navigation">
            <a href="/Medication/Index/" data-label="Medication">
                <i class='bx bxs-capsule'></i>           <!-- Billing -->
                <span class="sd-link-name">Medication</span>
            </a>
            <ul class="submenu">
                <li><a href="/Medication/Index/">Medication</a></li>
            </ul>
        </li>
        
    }

    @* Billing: Finance roles and Admin *@
    @if (HasAnyRole("Admin","FinanceOfficer","Cashier"))
    {
         <li class="navigation">
            <a href="/Billing/Index/" data-label="Billing">
                 <i class='bx bxs-wallet'></i>            <!-- Billing -->
                <span class="sd-link-name">Billing</span>
            </a>
            <ul class="submenu">
                <li><a href="/Billing/Index/">Billing</a></li>
            </ul>
        </li>
    }

    @* Canteen: Cashier, RecoveryCoach, Admin *@
    @if (HasAnyRole("Admin","Cashier","RecoveryCoach"))
    {
          <li class="navigation">
            <a href="/Canteen/Index/" data-label="Canteen">
                 <i class='bx bxs-coffee'></i>                  <!-- Canteen -->
                <span class="sd-link-name">Canteen</span>
            </a>
            <ul class="submenu">
                <li><a href="/Canteen/Index/">Canteen</a></li>
            </ul>
        </li>
    }

    @* Administration / Services: Admin + Setup roles *@
    @if (HasAnyRole("Admin","Staff"))
    {
        <li class="navigation">
            <a href="#" class="nav-parent">
                <i class='bx bxs-cog'></i>                       <!-- Administration -->
                <span class="link_name">Administration</span>
                <i class='bx bx-chevron-down caret'></i>
            </a>
            <ul class="submenu">
                <li><a asp-controller="Services" asp-action="Index"><span>Services</span></a></li>
                <li><a asp-controller="Services" asp-action="Index"><span>Setup Billing</span></a></li>
            </ul>
        </li>

        <li class="navigation">
            <a href="/User/Index/" data-label="Users">
                 <i class='bx bxs-user-account'></i>                    <!-- Users -->
                <span class="sd-link-name">Users</span>
            </a>
            <ul class="submenu">
                <li><a href="/User/Index/">Users</a></li>
            </ul>
        </li>
    }
</ul>
    }
        
        <!-- Bottom Section with DateTime and Logout -->
        <div class="sidebar-footer">
            <!-- trigger modal instead of direct form submit -->
            <a href="#" class="logout-button btn btn-link p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#logoutModal">
                <i class='bx bx-log-out'></i>
                <span>Logout</span>
            </a>
        </div>
    </div>
    <!-- Main Content Section -->
    <section class="home-section">
        <div class="home-content">
            <div class="home-content-left">
                <i class='bx bx-menu'></i>  
            </div>
            <div class="home-content-right">
                <!-- Message icon -->
                <div class="notification-icon">
                    <i class='bx bxs-message'></i>
                    <span class="notification-badge">3</span>
                </div>
                <!-- Notification Bell icon -->
                <div class="notification-icon">
                    <i class='bx bxs-bell'></i>
                    <span class="notification-badge">3</span>
                </div>
                <!-- User Info -->
                <div class="user-info-header">
                    <i class='bx bxs-user'></i>
                    <small>@roleClaim</small>
                </div>
            </div>
        </div>
        <div class="main-content">
            @RenderBody()
        </div>
    </section>

    <!-- Logout Confirmation Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Login" asp-action="Logout" method="post" id="logoutModalForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="logoutModalLabel">Confirm Logout</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to sign out?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Logout</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Global Appointment Modal -->
    @await Html.PartialAsync("_AddAppointmentModal")

    <!-- Bootstrap JS (bundle includes Popper). Required for modal to work. -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @* OR local copy:
       <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@

    @await RenderSectionAsync("Scripts", required: false)


    
    @* Loader *@
    <div id="loadingOverlay" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:9999;align-items:center;justify-content:center;">
        @* Imported from UIVerse *@
        <div class="loader"></div>
    </div>

    @* Success Message *@
    <!-- Success Indicator Modal -->
    <div class="modal fade" id="waitlistSuccessModal" tabindex="-1" aria-labelledby="waitlistSuccessLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4 text-center">
                <div class="modal-body">
                    <i class='bx bx-check-circle' style="font-size:3rem;color:#00A3B4;"></i>
                    <h5 class="mt-3 mb-2 fw-bold" id="waitlistSuccessLabel">Patient Added in the waitlist</h5>
                    <button type="button" class="btn btn-teal mt-2" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    @* FUll Calendar CDN *@
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>


</body>
</html>


<script>
    document.addEventListener('submit', function (e) {
        var overlay = document.getElementById('loadingOverlay');

        // Check if the form being submitted is inside a modal
        var form = e.target;
        var isModalForm = form.closest('.modal') !== null;

        // Only show loader if it's not a modal form
        if (overlay && !isModalForm) {
            overlay.style.display = 'flex';
        }
    }, true);

    window.addEventListener('pageshow', function () {
        const overlay = document.getElementById('loadingOverlay');
        if (overlay) overlay.style.display = 'none';
    });

    // NEW: sidebar toggle and submenu behavior (improved)
    document.addEventListener('DOMContentLoaded', function () {
        const sidebar = document.querySelector('.sidebar');
        const menuToggle = document.querySelector('.home-content-left i'); // menu icon
        if (menuToggle && sidebar) {
            menuToggle.addEventListener('click', function () {
                sidebar.classList.toggle('close');
            });
        }

        // Attach click handlers to the anchor with class "nav-parent"
        document.querySelectorAll('a.nav-parent').forEach(function (anchor) {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();

                const li = anchor.closest('li');
                if (!li) return;

                // toggle visual open state on the li
                li.classList.toggle('open');

                // toggle the submenu visibility
                const submenu = li.querySelector('.submenu');
                if (submenu) {
                    submenu.classList.toggle('show');
                }

                // close other submenus in the same level
                const allSubmenus = li.parentElement.querySelectorAll('> li > .submenu');
                allSubmenus.forEach(function (otherSubmenu) {
                    if (otherSubmenu !== submenu) {
                        otherSubmenu.classList.remove('show');
                        otherSubmenu.closest('li').classList.remove('open');
                    }
                });
            });
        });
    });
</script>
