@{
    ViewBag.Title = "Email";
    var section = ViewBag.Section as string ?? "inbox";
    var messages = ViewBag.Messages as List<SafehavenPMS.Models.Message>;
}

@if (TempData["ToastMessage"] != null)
{
    <div id="toast" class="toast-message @TempData["ToastType"]">
        @TempData["ToastMessage"]
    </div>
}


<div class="email-container">
    @* Email header panel *@
    <div class="header-panel">
        <button class="btn btn-next" id="composeBtn">Compose</button>

        @* header navigation *@
        <nav class="email-navigation g-3">
            <ul class="email-nav-list d-flex flex-row list-unstyled">
                <li class="email-nav-item @(section == "inbox" ? "active" : "")">
                    <a href="@Url.Action("Index", "Email", new { section = "inbox" })" class="email-nav-link">Inbox</a>
                </li>
                <li class="email-nav-item @(section == "sent" ? "active" : "")">
                    <a href="@Url.Action("Index", "Email", new { section = "sent" })" class="email-nav-link">Sent</a>
                </li>
                <li class="email-nav-item @(section == "archive" ? "active" : "")">
                    <a href="@Url.Action("Index", "Email", new { section = "archive" })" class="email-nav-link">Archive</a>
                </li>
            </ul>
        </nav>
        <hr class="mt-0 mb-2" />
    </div>

    <div class="email-msg-container">
        @if (messages != null && messages.Any())
        {
            foreach (var msg in messages)
            {
                <div class="email-msg-row d-flex align-items-center border @(!msg.IsRead ? "unread-message" : "read-message")">
                    <div class="col-md-4 col-12 message-header @(!msg.IsRead ? "fw-bold" : "")">
                        @(section == "sent" ? $"To: {msg.ToUser}" : $"From: {msg.FromUser}")
                    </div>
                    <div class="col-md-4 col-12 @(!msg.IsRead ? "fw-bold" : "")">@msg.Subject</div>
                    <div class="col-md-3 col-10 text-muted">@msg.SentAt.ToString("g")</div>
                    <div class="col-md-1 col-2 d-flex flex-row align-items-center justify-content-center gap-1 message-actions">
                        <!-- View Message -->
                        <button type="button" class="btn btn-link p-0 view-message-btn" 
                                data-from="@msg.FromUser" 
                                data-to="@msg.ToUser" 
                                data-subject="@msg.Subject" 
                                data-body="@msg.Body"
                                data-id="@msg.Id"
                                title="View Message">
                            <i class="bx bx-envelope fs-5"></i>
                        </button>

                        <!-- Archive Message (only in inbox) -->
                        @if (section == "inbox")
                        {
                            <form method="post" asp-action="ArchiveMessage">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@msg.Id" />
                                <button type="submit" class="btn btn-link p-0" title="Archive Message">
                                    <i class="bx bx-archive fs-5"></i>
                                </button>
                            </form>
                        }

                        <!-- Delete Message -->
                        <button type="button" class="btn btn-link p-0 text-danger delete-message-btn" 
                                data-id="@msg.Id" 
                                data-subject="@msg.Subject"
                                title="Delete Message">
                            <i class="bx bx-trash fs-5"></i>
                        </button>
                    </div>

                </div>
            }
        }
        else
        {
            <div class="nothing-follows text-center text-muted mt-3">Nothing follows.</div>
        }
    </div>
</div>

    @* Modal for composing a new message *@
    <div id="composeModal" class="compose-modal-overlay" style="display:none;">
        <div class="compose-modal-content">
            <span class="close-modal" id="closeModalBtn">&times;</span>
            <h4>New Message</h4>
            <form asp-action="SendMessage" asp-controller="Email" method="post">
                @Html.AntiForgeryToken()
                <div class="input-message">
                    <label for="to" class="form-label">To:</label>
                    <input type="text" id="to" name="To" class="form-control" placeholder="Recipient Username" required/>
                </div>
                <div class="mb-2 input-message">
                    <label for="subject" class="form-label">Subject:</label>
                <input type="text" id="subject" name="Subject" class="form-control" placeholder="Subject" required />
                </div>
                <div class="mb-2 input-message">
                    <label for="body" class="form-label">Message:</label>
                <textarea id="body" name="Body" class="form-control" rows="4" placeholder="Type your message..." required></textarea>
                </div>
                <div class="mb02 d-flex justify-content-end align-items-center">
                    <button type="submit" class="btn btn-primary">Send</button>
                </div>
            </form>
        </div>
    </div>

    @* Modal for viewing a message *@
    <div id="viewMessageModal" class="view-modal-overlay" style="display:none;">
        <div class="view-modal-content" style="width:50%;max-width:50%;min-width:350px;">
            <span class="close-modal" id="closeViewModalBtn">&times;</span>
            <h4 id="viewMsgSubject"></h4>
            <div class="mb-2"><strong>From:</strong> <span id="viewMsgFrom"></span></div>
            <div class="mb-2"><strong>To:</strong> <span id="viewMsgTo"></span></div>
            <div class="mb-2 "><strong>Message:</strong></div>
        <div id="viewMsgBody"
             style="white-space: pre-line;
            word-wrap: break-word;
            overflow-wrap: break-word;">
        </div>
            <div class="mt-3 d-flex justify-content-end">
                <button type="button" class="btn btn-primary" id="replyBtn">Reply</button>
            </div>
        </div>
    </div>

    @* Modal for replying to a message *@
    <div id="replyModal" class="reply-modal-overlay" style="display:none;">
        <div class="reply-modal-content">
            <span class="close-modal" id="closeReplyModalBtn">&times;</span>
            <h4>Reply Message</h4>
            <form asp-action="SendMessage" asp-controller="Email" method="post">
                @Html.AntiForgeryToken()
                <div class="input-message">
                    <label for="replyTo" class="form-label">To:</label>
                    <input type="text" id="replyTo" name="To" class="form-control" readonly />
                </div>
                <div class="mb-2 input-message">
                    <label for="replySubject" class="form-label">Subject:</label>
                    <input type="text" id="replySubject" name="Subject" class="form-control" placeholder="Subject" />
                </div>
                <div class="mb-2 input-message">
                    <label for="replyBody" class="form-label">Message:</label>
                    <textarea id="replyBody" name="Body" class="form-control" rows="4" placeholder="Type your reply..."></textarea>
                </div>
                <div class="mb02 d-flex justify-content-end align-items-center">
                    <button type="submit" class="btn btn-primary">Send</button>
                </div>
            </form>
    </div>
    </div>

    @* Modal for delete confirmation *@
    <div id="deleteModal" class="delete-modal-overlay" style="display:none;">
        <div class="delete-modal-content">
            <span class="close-modal" id="closeDeleteModalBtn">&times;</span>
            <h4>Confirm Delete</h4>
            <div class="mb-3">
                <p>Are you sure you want to delete this message?</p>
                <p class="text-muted"><strong>Subject:</strong> <span id="deleteMsgSubject"></span></p>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" id="cancelDeleteBtn">Cancel</button>
                <form method="post" asp-action="DeleteMessage" id="deleteForm" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteMessageId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
    </div>
</div>

@* Style for sending message *@
<style>
    /* Compose Modal Styles */
    .compose-modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.4);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .compose-modal-content {
        position: fixed;
        bottom: 0px;
        right: 10px;
        background: #fff;
        padding: 14px 22px;
        border-radius: 8px;
        height: 80%;
        min-width: 320px;
        max-width: 50%;
        width: 50%;
        box-shadow: 0 4px 24px rgba(0,0,0,0.15);
    }

    /* View Modal Styles */
    .view-modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.4);
        z-index: 1001;
            display: flex;
        align-items: center;
        justify-content: center;
    }
    .view-modal-content {
        background: #fff;
        padding: 18px 28px;
        border-radius: 10px;
        min-width: 350px;
        max-width: 50%; 
        width: 50%;
        box-shadow: 0 4px 24px rgba(0,0,0,0.18);
        position: relative;
    }

    /* Reply Modal Styles */
    .reply-modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.45);
        z-index: 1002;
            display: flex;
        align-items: center;
        justify-content: center;
    }
    .reply-modal-content {
        background: #fff;
        padding: 18px 28px;
        border-radius: 10px;
        min-width: 350px;
        max-width: 50%;
        width: 50%;
        box-shadow: 0 4px 24px rgba(0,0,0,0.18);
        position: relative;
    }

    /* Delete Modal Styles */
    .delete-modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1003;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .delete-modal-content {
        background: #fff;
        padding: 24px 32px;
        border-radius: 12px;
        min-width: 400px;
        max-width: 500px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.25);
        position: relative;
        border: 1px solid #e0e0e0;
    }

    /* Shared Modal Styles */
    .close-modal {
        position: absolute;
        top: 12px;
        right: 16px;
        font-size: 1.5rem;
        color: #888;
        cursor: pointer;
    }

    .ui-autocomplete {
        z-index: 2000 !important; /* make sure it's above modal */
        background: white;
        border: 1px solid #ccc;
        max-height: 200px;
        overflow-y: auto;
        border-radius: 4px;
    }

    .modal-content .form-label,
    .compose-modal-content .form-label,
    .reply-modal-content .form-label {
        font-weight: 500;
        margin-bottom: 4px;
        display: block;
    }
    .modal-content .form-control,
    .compose-modal-content .form-control,
    .reply-modal-content .form-control {
        width: 100%;
        padding: 6px 8px;
        margin-bottom: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 1rem;
    }
    .modal-content .btn-primary,
    .compose-modal-content .btn-primary,
    .reply-modal-content .btn-primary {
        background: #007178;
        color: #fff;
        border: none;
        padding: 8px 18px;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
    }
    .modal-content .btn-primary:hover,
    .compose-modal-content .btn-primary:hover,
    .reply-modal-content .btn-primary:hover {
        background: #005f63;
    }

    .toast-message {
    position: fixed;
    bottom: 20px;
    right: 20px;
    transform: translateX(-50%);
    background-color: #007178; /* Default teal */
    color: white;
    padding: 12px 20px;
    border-radius: 6px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    z-index: 9999;
    font-weight: 500;
    opacity: 0;
    animation: fadeInOut 3.5s ease-in-out;
}

.toast-message.success {
    background-color: #007178; /* Teal success */
}

.toast-message.error {
    background-color: #b00020; /* Red error */
}

 @@keyframes fadeInOut {
     0% { opacity: 0; transform: translateY(-10px); }
     10%, 90% { opacity: 1; transform: translateY(0); }
     100% { opacity: 0; transform: translateY(-10px); }
 }

 .unread-message {
     background-color: #f8f9fa;
     border-left: 3px solid #007178;
     padding-left: 8px;
 }

 .unread-message:hover {
     background-color: #e9ecef;
 }

    .read-message {
        background-color: #ffffff; /* White background for read messages */
        border-left: 3px solid transparent; /* No colored border */
        padding-left: 8px;
    }

    .read-message:hover {
        background-color: #f1f1f1; /* Light hover effect */
    }

    .compose-modal-content textarea{
        min-height: 120px; /* Minimum height */
        max-height: 500px; /* Maximum height */
        height: 300px; /* Default height */
        resize: vertical; /* User can resize vertically */
    }

    /* Ensure all message rows have consistent styling */
    .email-msg-row {
        transition: background-color 0.2s ease;
    }

</style>

<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>
<script>
     // Show modal when Compose is clicked
    document.addEventListener('DOMContentLoaded', function () {
        var composeBtn = document.getElementById('composeBtn');
        var modal = document.getElementById('composeModal');
        var closeModalBtn = document.getElementById('closeModalBtn');

        const toast = document.getElementById('toast');
        if (toast) {
            setTimeout(() => toast.style.display = 'none', 3500);
        }

        composeBtn.addEventListener('click', function () {
            modal.style.display = 'flex';
        });

        closeModalBtn.addEventListener('click', function () {
            modal.style.display = 'none';
        });

        // View message modal logic
        var viewModal = document.getElementById('viewMessageModal');
        var closeViewModalBtn = document.getElementById('closeViewModalBtn');
        var replyBtn = document.getElementById('replyBtn');
        var replyModal = document.getElementById('replyModal');
        var closeReplyModalBtn = document.getElementById('closeReplyModalBtn');

        // Delete confirmation modal logic
        var deleteModal = document.getElementById('deleteModal');
        var closeDeleteModalBtn = document.getElementById('closeDeleteModalBtn');
        var cancelDeleteBtn = document.getElementById('cancelDeleteBtn');

         // View message button functionality
         document.querySelectorAll('.view-message-btn').forEach(function (btn) {
             btn.addEventListener('click', function () {
                 // Show the message modal
                 document.getElementById('viewMsgSubject').textContent = btn.getAttribute('data-subject');
                 document.getElementById('viewMsgFrom').textContent = btn.getAttribute('data-from');
                 document.getElementById('viewMsgTo').textContent = btn.getAttribute('data-to');
                 document.getElementById('viewMsgBody').textContent = btn.getAttribute('data-body');
                 viewModal.style.display = 'flex';

                 // Store reply username for later
                 replyBtn.setAttribute('data-reply-to', btn.getAttribute('data-from'));
                 replyBtn.setAttribute('data-reply-subject', btn.getAttribute('data-subject'));

                 // Mark message as read
                 const messageId = btn.getAttribute('data-id');
                 if (messageId) {
                     fetch('/Email/MarkAsRead', {
                         method: 'POST',
                         headers: {
                             'Content-Type': 'application/x-www-form-urlencoded',
                             'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                         },
                         body: `id=${messageId}`
                     }).then(() => {
                         // Update the unread count badge
                         loadUnreadMessages();
                         // Update the message row styling to show as read
                         const messageRow = btn.closest('.email-msg-row');
                         if (messageRow) {
                             messageRow.classList.remove('unread-message');
                             messageRow.classList.add('read-message');
                             // Remove bold styling from text
                             const headerText = messageRow.querySelector('.message-header');
                             const subjectText = messageRow.querySelector('.col-md-4:not(.message-header):not(.text-muted)');
                             if (headerText) headerText.classList.remove('fw-bold');
                             if (subjectText) subjectText.classList.remove('fw-bold');
                         }
                     }).catch(err => console.error('Error marking message as read:', err));
                 }
             });
         });

        closeViewModalBtn.addEventListener('click', function () {
            viewModal.style.display = 'none';
        });

        replyBtn.addEventListener('click', function () {
            // Auto-populate the username and subject for reply
            document.getElementById('replyTo').value = replyBtn.getAttribute('data-reply-to');
            document.getElementById('replySubject').value = "RE: " + replyBtn.getAttribute('data-reply-subject');
            document.getElementById('replyBody').value = "";
            replyModal.style.display = 'flex';
            viewModal.style.display = 'none';
        });

         closeReplyModalBtn.addEventListener('click', function () {
             replyModal.style.display = 'none';
         });

         // Delete message button functionality
         document.querySelectorAll('.delete-message-btn').forEach(function (btn) {
             btn.addEventListener('click', function () {
                 const messageId = btn.getAttribute('data-id');
                 const messageSubject = btn.getAttribute('data-subject');
                 
                 // Populate the delete modal
                 document.getElementById('deleteMessageId').value = messageId;
                 document.getElementById('deleteMsgSubject').textContent = messageSubject;
                 
                 // Show the delete confirmation modal
                 deleteModal.style.display = 'flex';
             });
         });

         // Close delete modal
         closeDeleteModalBtn.addEventListener('click', function () {
             deleteModal.style.display = 'none';
         });

         cancelDeleteBtn.addEventListener('click', function () {
             deleteModal.style.display = 'none';
         });

         // Function to load unread message count
         function loadUnreadMessages() {
             fetch('/Email/GetUnreadCount', { 
                 headers: { 'Accept': 'application/json' } 
             })
             .then(response => response.json())
             .then(data => {
                 const msgBadge = document.getElementById('msgBadge');
                 if (msgBadge) {
                     const count = data.unreadCount || 0;
                     if (count > 0) {
                         msgBadge.textContent = count;
                         msgBadge.classList.remove('d-none');
                } else {
                         msgBadge.classList.add('d-none');
                     }
                }
            })
             .catch(err => console.error('Error fetching unread messages:', err));
         }
            });
                document.addEventListener('DOMContentLoaded', function () {
        const toInput = document.getElementById('to');
        if (toInput) {
            $(toInput).autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Email/SearchUsers',
                        data: { term: request.term },
                        success: function (data) {
                            response(data.results);
                        }
                    });
                },
                minLength: 1,
                select: function (event, ui) {
                    toInput.value = ui.item.value;
                    return false;
                }
            });
        }
    });

</script>
