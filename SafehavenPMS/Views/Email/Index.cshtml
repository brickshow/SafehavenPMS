@{
    ViewBag.Title = "Email";
    var section = ViewBag.Section as string ?? "inbox";
    var messages = ViewBag.Messages as List<SafehavenPMS.Models.Message>;
}

<div class="email-container">
    @* Email header panel *@
    <div class="header-panel">
        <button class="btn btn-next" id="composeBtn">Compose</button>

        @* header navigation *@
        <nav class="email-navigation g-3">
            <ul class="email-nav-list d-flex flex-row list-unstyled">
                <li class="email-nav-item @(section == "inbox" ? "active" : "")">
                    <a href="@Url.Action("Index", "Email", new { section = "inbox" })" class="email-nav-link">Inbox</a>
                </li>
                @* <li class="email-nav-item @(section == "sent" ? "active" : "")">
                    <a href="@Url.Action("Index", "Email", new { section = "sent" })" class="email-nav-link">Sent</a>
                </li>
                <li class="email-nav-item @(section == "archive" ? "active" : "")">
                    <a href="@Url.Action("Index", "Email", new { section = "archive" })" class="email-nav-link">Archive</a>
                </li> *@
            </ul>
        </nav>
        <hr class="mt-0 mb-2" />
    </div>

    @* Modal for composing a new message *@
    <div id="composeModal" class="modal-overlay" style="display:none;">
        <div class="modal-content">
            <span class="close-modal" id="closeModalBtn">&times;</span>
            <h4>New Message</h4>
            <form>
                <div class="input-message">
                    <label for="to" class="form-label">To:</label>
                    <input type="text" id="to" class="form-control" placeholder="Recipient Username" />
                </div>
                <div class="mb-2 input-message">
                    <label for="subject" class="form-label">Subject:</label>
                    <input type="text" id="subject" class="form-control" placeholder="Subject" />
                </div>
                <div class="mb-2 input-message">
                    <label for="body" class="form-label">Message:</label>
                    <textarea id="body" class="form-control" rows="4" placeholder="Type your message..."></textarea>
                </div>
                <div class="mb02 d-flex justify-content-end align-items-center">
                    <button type="submit" class="btn btn-primary">Send</button>
                </div>
            </form>
        </div>
    </div>

    @* Email message container  *@
    <div class="email-msg-container">
        @if (messages != null && messages.Any())
        {
            foreach (var msg in messages)
            {
                <div class="email-msg-row d-flex align-items-center">
                    <div class="col-md-4 col-12 message-header">
                        @(section == "sent" ? $"To: {msg.ToUser}" : $"From: {msg.FromUser}")
                    </div>
                    <div class="col-md-4 col-12">@msg.Subject</div>
                    <div class="col-md-3 col-10 text-muted">@msg.SentAt.ToString("g")</div>
                    <div class="col-md-1 col-2 text-end message-actions justify-content-center align-items-center">
                        @if (section == "inbox")
                        {
                            <form method="post" asp-action="ArchiveMessage" style="display:inline;">
                                <input type="hidden" name="id" value="@msg.Id" />
                                <button type="submit" title="Archive Message"><i class="bx bx-archive fs-5"></i></button>
                            </form>
                        }
                        <form method="post" asp-action="DeleteMessage" style="display:inline;">
                            <input type="hidden" name="id" value="@msg.Id" />
                            <button type="submit" title="Delete Message"><i class="text-danger bx bx-trash fs-5"></i></button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="nothing-follows text-center text-muted mt-3">Nothing follows.</div>
        }
    </div>
</div>

@* Style for sending message *@
<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.4);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-content .form-control {
        width: 100%;
        padding: 6px 8px;
        margin-bottom: 10px;
        border: 1px solid #ccc;
        border-radius: 0; /* Remove round edges */
        font-size: 1rem;
    }

    .input-message input {
        border-top: none !important;
        border-left: none !important;
        border-right: none !important;
        border-bottom: 1px solid #c3c1c1;
        border-radius: 0px;
    }

        .input-message input:focus {
            border-bottom: 2px solid #005f63 !important;
            box-shadow: 0 1px 0 0 #005f63 !important;
            transition: all 0.3s ease;
        }

    .modal-content {
        position: fixed;
        bottom: 0px;
        right: 10px;
        background: #fff;
        padding: 14px 22px;
        border-radius: 8px;
        height: 80%;
        min-width: 320px;
        max-width: 40%;
        box-shadow: 0 4px 24px rgba(0,0,0,0.15);
    }

        .modal-content form {
            height: calc(100% - 60px);
            display: flex;
            flex-direction: column;
        }

        .modal-content .mb-2:last-of-type {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .modal-content textarea#body {
            flex-grow: 1;
            min-height: 200px;
            resize: none;
            margin-bottom: 16px;
        }

    .close-modal {
        position: absolute;
        top: 12px;
        right: 16px;
        font-size: 1.5rem;
        color: #888;
        cursor: pointer;
    }

    .modal-content .form-label {
        font-weight: 500;
        margin-bottom: 4px;
        display: block;
    }

    .modal-content .form-control {
        width: 100%;
        padding: 6px 8px;
        margin-bottom: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 1rem;
    }

    .modal-content .btn-primary {
        background: #007178;
        color: #fff;
        border: none;
        padding: 8px 18px;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
    }

    .modal-content .form-control:focus {
        outline: none;
        box-shadow: none;
        border-color: #ccc;
    }

    .modal-content .btn-primary:hover {
        background: #005f63;
    }
</style>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script>
     // Show modal when Compose is clicked
    document.addEventListener('DOMContentLoaded', function () {
        var composeBtn = document.getElementById('composeBtn');
        var modal = document.getElementById('composeModal');
        var closeModalBtn = document.getElementById('closeModalBtn');

        composeBtn.addEventListener('click', function () {
            modal.style.display = 'flex';
        });

        closeModalBtn.addEventListener('click', function () {
            modal.style.display = 'none';
        });

        // SignalR script for real-time messaging
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/messageHub")
            .build();

        connection.on("ReceiveMessage", function (fromUser, subject, body) {
            alert(`New message from ${fromUser}: ${subject}`);
            location.reload();
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        document.querySelector("#composeModal form").addEventListener("submit", function (e) {
            e.preventDefault();
            const to = document.getElementById("to").value;
            const subject = document.getElementById("subject").value;
            const body = document.getElementById("body").value;

         fetch("/Email/SendMessage", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                },
                body: JSON.stringify({
                    to: to.trim(),
                    subject: subject.trim(),
                    body: body.trim()
                })
            })
            .then(async res => {
                if (res.ok) {
                    alert("✅ Message sent!");
                    modal.style.display = "none";
                    location.reload(); // optional: refresh inbox
                } else {
                    const error = await res.text();
                    alert("❌ Failed to send: " + error);
                }
            })
            .catch(err => {
                console.error(err);
                alert("❌ Error sending message.");
            });

        });
    });
</script>
