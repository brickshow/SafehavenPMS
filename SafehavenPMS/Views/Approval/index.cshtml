        transform: translateX(-10px); /* or try -12px or -8px to adjust the alignment */
    }

</style>

<script>
       function setPatientInfo(patientId, patientName, staffName) {
        console.log('setPatientInfo called with:', patientId, patientName, staffName); // Debug log
        document.getElementById('modalPatientId').value = patientId;
        document.querySelector('input[name="PatientName"]').value = patientName;
        document.querySelector('input[name="StaffName"]').value = staffName;
    }

        // Add click handler
    document.querySelectorAll('.custom-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        // remove active from all
        document.querySelectorAll('.custom-btn').forEach(b => b.classList.remove('active'));
        // add active to clicked
        this.classList.add('active');
      });
    });
</script>