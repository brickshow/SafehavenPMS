            transform: translateY(-1px);
            background-color: white;
            box-shadow: 0 2px 5px rgba(5, 133, 148, 0.3);
        }

        .custom-btn.active {
            background: linear-gradient(to right, #069FB2, #058594) !important;
            color: white !important;
            box-shadow: none;
        }
    .table-header {
        width: 100%;
        height: 50px;
        background: linear-gradient(to right, #069FB2, #058594);
        color: white;
        font-weight: 600;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
    }

    .table-responsive-custom {
        overflow: visible !important;
    }

    .dropdown-menu {
        position: absolute !important;
