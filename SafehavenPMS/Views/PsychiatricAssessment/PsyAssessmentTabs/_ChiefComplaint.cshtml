@model SafehavenPMS.ViewModel.PsychiatricAssessmentViewModel

<form asp-action="SavingChiefComplaint" asp-controller="PsychiatricAssessment" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PatientId" />

    <div class="chief-container bg-white mt-2" style="color: #015F6B;">
        <h5 class=" mb-0"><b>CHIEF COMPLAINTS</b></h5>

        <div class="form-group pt-3 p-4">
            <textarea id="ChiefComplaint" asp-for="ChiefComplaint" class="form-control chief-textarea"
                    placeholder="Enter chief complaints..." rows="10"></textarea>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn-cancel px-4" onclick="history.back();">Cancel</button>
                    <button type="submit" class="btn-next btn-primary px-4">Save</button>
                </div>
        </div>

      
    </div>
</form>

<style>
    .chief-container {
        padding: 18px 20px;
    }

    .chief-title {
        color: #0b6b6b; /* teal heading */
        font-weight: 600;
        margin-bottom: 12px;
        font-size: 16px;
    }

    .chief-textarea {
        width: 100%;
        min-height: 220px;
        border: 1px solid #d6d6d6;
        border-radius: 4px;
        padding: 14px;
        resize: vertical;
        box-shadow: none;
        font-size: 14px;
        line-height: 1.4;
    }

    .chief-textarea:focus {
        outline: none;
        border-color: rgba(11,107,107,0.8);
        box-shadow: 0 0 0 3px rgba(11,107,107,0.06);
    }

   

    .save-btn {
        background: #0b6b6b;
        color: #fff;
        padding: 10px 44px;
        border: none;
        border-radius: 2px;
        box-shadow: 0 4px 0 rgba(0,0,0,0.18);
        letter-spacing: 1px;
        font-weight: 600;
        cursor: pointer;
    }

    .save-btn:active {
        transform: translateY(2px);
        box-shadow: 0 2px 0 rgba(0,0,0,0.18);
    }

    /* responsive small screens */
    @@media (max-width: 576px) {
        .save-btn {
            padding: 10px 24px;
            font-size: 14px;
        }
    }
</style>