@model SafehavenPMS.ViewModel.PsychiatricAssessmentViewModel

<div class="card">
    <div class="card-header bg-white mt-3" style="color: #015F6B;">
            <h5 class="mb-0"><b>DIAGNOSIS</b></h5>
     </div>
    <div class="card-body pt-3 p-5">
        <form asp-action="SaveDiagnosis" asp-controller="PsychiatricAssessment" method="post" id="diagnosisForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientId" />

            <div class="mb-4">
                <div id="diagnosisList">
                    @if (Model?.PsyDiagnosisList?.Diagnosis != null)
                    {
                        @for (var i = 0; i < Model.PsyDiagnosisList.Diagnosis.Count; i++)
                        {
                            <div class="row align-items-end mb-2 diagnosis-entry">
                                <div class="col-11">
                                    <input type="text" class="form-control"
                                           name="PsyDiagnosisList.Diagnosis[@i]"  // Fixed: Use PsyDiagnosisList.Diagnosis to match controller
                                           value="@Model.PsyDiagnosisList.Diagnosis[i]"
                                           placeholder="Enter diagnosis description" />
                                </div>
                                <div class="col-1">
                                    <button type="button" class="btn btn-outline-danger" onclick="removeDiagnosis(this)">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="row align-items-end mb-2">
                    <div class="col-11">
                        <input type="text" class="form-control" id="newDiagnosis" 
                               placeholder="Enter new Diagnosis" />
                    </div>
                    <div class="col-1">
                        <button type="button" class="btn btn-teal" onclick="addDiagnosis()">
                            <i class="bx bx-plus"></i>
                        </button>
                    </div>
                </div>
            </div>

           <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn-cancel px-4" onclick="history.back();">Cancel</button>
                <button type="submit" class="btn-next btn-primary px-4">Save</button>
            </div>  
        </form>
    </div>
</div>

<style>
    .chief-container {
        padding: 18px 20px;
    }

    .chief-title {
        color: #0b6b6b; /* teal heading */
        font-weight: 600;
        margin-bottom: 12px;
        font-size: 16px;
    }

    .card {
        box-shadow: none !important;
        border: none;
    }

    .card-header {
        background: transparent;
        border-bottom: none;
    }

    .form-control {
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .btn-teal {
        background-color: #006d77;
        color: white;
    }

    .btn-teal:hover {
        background-color: #005c64;
        color: white;
    }
</style>

<script>
    function addDiagnosis() {
        const diagnosisText = document.getElementById('newDiagnosis').value;
        
        if (!diagnosisText) {
            alert('Please enter a diagnosis description');
            return;
        }

        const list = document.getElementById('diagnosisList');
        const index = list.children.length;
        
        const div = document.createElement('div');
        div.className = 'row align-items-end mb-2 diagnosis-entry';
        div.innerHTML = `
            <div class="col-11">
                <input type="text" class="form-control" 
                       name="PsyDiagnosisList.Diagnosis[${index}]"  // Fixed: Use PsyDiagnosisList.Diagnosis to match controller
                       id="PsyDiagnosisList_Diagnosis_${index}"
                       value="${diagnosisText}" />
            </div>
            <div class="col-1">
                <button type="button" class="btn btn-outline-danger" onclick="removeDiagnosis(this)">
                    <i class="bx bx-trash"></i>
                </button>
            </div>
        `;

        list.appendChild(div);
        
        // Clear input field
        document.getElementById('newDiagnosis').value = '';
    }

    function removeDiagnosis(button) {
        button.closest('.diagnosis-entry').remove();
        
        // Reindex remaining diagnoses
        const list = document.getElementById('diagnosisList');
        const entries = list.getElementsByClassName('diagnosis-entry');
        
        for (let i = 0; i < entries.length; i++) {
            const input = entries[i].querySelector('input');
            input.name = `PsyDiagnosisList.Diagnosis[${i}]`;  // Fixed: Use PsyDiagnosisList.Diagnosis to match controller
            input.id = `PsyDiagnosisList_Diagnosis_${i}`;
        }
    }
</script>