@model SafehavenPMS.ViewModel.AssessmentFormViewModel

<div class="card ">
    <div class="card-header bg-white mt-2" style="color: #015F6B;">
        <h5 class="mb-0">RECOMMENDATION</h5>
    </div>
    <div class="card-body pt-3 p-5">
        <form asp-action="SaveRecommendation" asp-controller="Assessment" method="post" id="recommendationForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientId" />

            <div class="mb-4 p-3" style="border:1px solid #e0e0e0; border-radius:8px;">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Program Type</label>
                        <select class="form-select" asp-for="Recommendation.ProgramType" required>
                            <option value="">Select Program Type</option>
                            <option value="Residential Treatment Rehabilitation">Residential Treatment Rehabilitation</option>
                            <option value="Community-based Rehabilitation">Community-based Rehabilitation</option>
                            <option value="Outpatient Program Rehabilitation">Outpatient Program Rehabilitation</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Expected Duration of Treatment</label>
                        <select class="form-select" asp-for="Recommendation.ExpectedDuration" required>
                            <option value="">Select Duration</option>
                            <option value="minimum of 3 months">minimum of 3 months</option>
                            <option value="minimum of 6 months">minimum of 6 months</option>
                            <option value="minimum of 3-6 months">minimum of 3-6 months</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="mb-4 p-3" style="border:1px solid #e0e0e0; border-radius:8px;">
                <label class="form-label fw-bold">Reason</label>
                <textarea class="form-control" asp-for="Recommendation.Reason" rows="5" placeholder="Enter reason"></textarea>
            </div>

             <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn-cancel px-4" onclick="history.back();">Cancel</button>
                <button type="submit" class="btn-next btn-primary px-4">Save</button>
            </div>
        </form>
    </div>
</div>

<style>
    .btn-teal {
        background-color: #006d77;
        color: white;
    }
    .btn-teal:hover {
        background-color: #005c64;
        color: white;
    }
    .form-label.fw-bold {
        color: black;
    }
</style>