@model SafehavenPMS.ViewModel.AssessmentFormViewModel

<div class="card">
    <div class="card-header bg-white" style="color: #015F6B;">
        <h5 class="mb-0">PROBLEM LIST</h5>
    </div>
    <div class="card-body">
        <form asp-action="SaveProblemList" asp-controller="Assessment" method="post" id="problemListForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientId" />

            <div class="mb-4">
                <div id="problemList">
                    @if (Model?.ProblemList?.Problems != null)
                    {
                        @for (var i = 0; i < Model.ProblemList.Problems.Count; i++)
                        {
                            <div class="row align-items-end mb-2 problem-entry">
                                <div class="col-11">
                                    <input type="text" class="form-control"
                                           name="ProblemList.Problems[@i]"
                                           value="@Model.ProblemList.Problems[i]"
                                           placeholder="Enter problem description" />
                                </div>
                                <div class="col-1">
                                    <button type="button" class="btn btn-outline-danger" onclick="removeProblem(this)">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="row align-items-end mb-2">
                    <div class="col-11">
                        <input type="text" class="form-control" id="newProblem" 
                               placeholder="Enter new problem" />
                    </div>
                    <div class="col-1">
                        <button type="button" class="btn btn-teal" onclick="addProblem()">
                            <i class="bx bx-plus"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-teal px-4">
                    <i class="bx bx-save me-2"></i>SAVE
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .card {
        box-shadow: none !important;
        border: none;
    }

    .card-header {
        background: transparent;
        border-bottom: none;
    }

    .form-control {
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .btn-teal {
        background-color: #006d77;
        color: white;
    }

    .btn-teal:hover {
        background-color: #005c64;
        color: white;
    }
</style>

<script>
    function addProblem() {
        const problemText = document.getElementById('newProblem').value;
        
        if (!problemText) {
            alert('Please enter a problem description');
            return;
        }

        const list = document.getElementById('problemList');
        const index = list.children.length;
        
        const div = document.createElement('div');
        div.className = 'row align-items-end mb-2 problem-entry';
        div.innerHTML = `
            <div class="col-11">
                <input type="text" class="form-control" 
                       name="ProblemList.Problems[${index}]" 
                       id="ProblemList_Problems_${index}"
                       value="${problemText}" />
            </div>
            <div class="col-1">
                <button type="button" class="btn btn-outline-danger" onclick="removeProblem(this)">
                    <i class="bx bx-trash"></i>
                </button>
            </div>
        `;

        list.appendChild(div);
        
        // Clear input field
        document.getElementById('newProblem').value = '';
    }

    function removeProblem(button) {
        button.closest('.problem-entry').remove();
        
        // Reindex remaining problems
        const list = document.getElementById('problemList');
        const entries = list.getElementsByClassName('problem-entry');
        
        for (let i = 0; i < entries.length; i++) {
            const input = entries[i].querySelector('input');
            input.name = `ProblemList.Problems[${i}]`;
            input.id = `ProblemList_Problems_${i}`;
        }
    }
</script>