@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model SafehavenPMS.ViewModel.PatientProgressNotesTabViewModel
@{
    ViewBag.Title = "Progress Notes";
}

<div class="header mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index", "ProgressNote")" class="me-2" title="Back">
                <i class="bx bx-reply fs-3 text-custom"></i>
            </a>
            <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
        </div>
    </div>
    <hr class="mt-0 mb-3" />
</div>

<div class="progressnotes-partial bg-light container-fluid p-3">
    <div class="row gx-3" style="min-height:420px;">
       

        <!-- Right column: tab content for each intervention -->
        <div class="col-lg-12 col-md-12 ">
            <div class="d-flex flex-column h-100" style="gap:12px;">
                <div class="tab-content" id="interventionTabContent">
                    @if (Model?.Interventions != null && Model.Interventions.Any())
                    {
                        var firstId = Model.SelectedInterventionId ?? Model.Interventions.First().InterventionId;
                        foreach (var interv in Model.Interventions)
                        {
                            var paneActive = firstId == interv.InterventionId ? "show active" : "";
                    <div class="tab-pane fade @paneActive" id="interv@(interv.InterventionId)" role="tabpanel" aria-labelledby="interv@(interv.InterventionId)-tab">
                        <div class="d-flex flex-column bg-white flex-md-row justify-content-between align-items-start p-3 intervention-details" style="border:1px solid #e6e9ea;">
                            <div class="flex-grow-1 me-3">
                                <h5 class="mb-1 intervention-title">@interv.Title - @interv.Frequency</h5>
                                <div class="text-muted small short-desc">@interv.Description</div>
                            </div>

                            <div class="text-end small text-muted intervention-meta" style="min-width:220px;">
                                <div class="clinician"><strong>Clinician:</strong> @interv.Clinician</div>
                                <div class="lastnote"><strong>Last Note:</strong> @interv.LastNoteDisplay</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <h6 class="mb-0" style="letter-spacing:1px; font-weight:700;">PROGRESS NOTES</h6>
                            <div>
                                <a href="@Url.Action("Create", "ProgressNote", new { patientId = Model.PatientId, interventionId = interv.InterventionId })" class="btn btn-custom">+ Add Progress Note</a>
                            </div>
                        </div>

                        <div class="card note-panel h-100 mt-2" style="border:1px solid #e6e9ea;">
                            <div class="card-body p-3 d-flex flex-column" style="gap:14px; min-height:0;">
                                <div class="row gx-3" style="min-height:250px;">
                                    <!-- Notes list (left) -->
                                    <div class="col-md-4 notes-list-col" style="max-height:420px; overflow:auto;">
                                        @if (interv.ProgressNotes != null && interv.ProgressNotes.Any())
                                        {
                                            <div class="list-group" id="noteList-@(interv.InterventionId)">
                                                @{
                                                    var firstNote = interv.ProgressNotes.OrderByDescending(x => x.CreatedAt).First();
                                                }
                                                @foreach (var note in interv.ProgressNotes.OrderByDescending(x => x.CreatedAt))
                                                {
                                                    var isFirstNote = note.ProgressNoteId == firstNote.ProgressNoteId;
                                                <a href="#" class="list-group-item list-group-item-action note-item d-flex flex-column @(isFirstNote ? "active" : "")"
                                                   data-note-id="@(note.ProgressNoteId)"
                                                   data-interv-id="@(interv.InterventionId)">
                                                    <div class="d-flex justify-content-between">
                                                        <div class="fw-semibold small">@note.CreatedAt.ToString("MMM dd, yyyy")</div>
                                                        
                                                    </div>
                                                    <div class="small text-muted">S - @note.Subjective</div>

                                                    <!-- hidden data blocks for JS (Razor will html-encode content inside) -->
                                                    <div class="note-data d-none">
                                                        <div class="note-subj">@note.Subjective</div>
                                                        <div class="note-obj">@note.Objective</div>
                                                        <div class="note-ass">@note.Assessment</div>
                                                        <div class="note-plan">@note.Plan</div>
                                                    </div>
                                                </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted small">No progress notes for this intervention.</div>
                                        }
                                    </div>

                                    <!-- SOAP display (right) -->
                                    <div class="col-md-8 soap-display-col">
                                    @if (interv.ProgressNotes != null && interv.ProgressNotes.Any())
                                        {
                                        <div class="soap-display p-3 h-100" style="border-left:1px solid #ececec;">
                                            <div class="d-flex mb-3">
                                                <div class="soap-letter fs-3 fw-bold me-3">S</div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold small text-muted">Subjective</div>
                                                    <div class="soap-content subj-content small mt-2" id="subj-@(interv.InterventionId)">@(
                                                        (interv.ProgressNotes != null && interv.ProgressNotes.Any()) ? interv.ProgressNotes.OrderByDescending(x=>x.CreatedAt).First().Subjective : "")
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex mb-3">
                                                <div class="soap-letter fs-3 fw-bold me-3">O</div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold small text-muted">Objective</div>
                                                    <div class="soap-content obj-content small mt-2" id="obj-@(interv.InterventionId)">@(
                                                        (interv.ProgressNotes != null && interv.ProgressNotes.Any()) ? interv.ProgressNotes.OrderByDescending(x=>x.CreatedAt).First().Objective : "")
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex mb-3">
                                                <div class="soap-letter fs-3 fw-bold me-3">A</div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold small text-muted">Assessment</div>
                                                    <div class="soap-content ass-content small mt-2" id="ass-@(interv.InterventionId)">@(
                                                        (interv.ProgressNotes != null && interv.ProgressNotes.Any()) ? interv.ProgressNotes.OrderByDescending(x=>x.CreatedAt).First().Assessment : "")
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex mb-3">
                                                <div class="soap-letter fs-3 fw-bold me-3">P</div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold small text-muted">Plan</div>
                                                    <div class="soap-content plan-content small mt-2" id="plan-@(interv.InterventionId)">@(
                                                        (interv.ProgressNotes != null && interv.ProgressNotes.Any()) ? interv.ProgressNotes.OrderByDescending(x=>x.CreatedAt).First().Plan : "")
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-3 text-end">
                                                <a href="@Url.Action("EditSoap", "ProgressNote", new { id = interv.InterventionId })" class="btn btn-outline-secondary btn-next">Edit</a>
                                            </div>
                                        </div>
                                             }
                                        else
                                        {
                                            <div class="text-muted small">No progress notes for this intervention.</div>
                                        }
                                    </div>
                                </div> <!-- row -->
                            </div>
                        </div>
                    </div>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-muted">No interventions available.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* general */
    .list-panel .badge { font-size:0.75rem; padding:6px 8px; }
    .note-panel h5 { font-weight:600; }
    .soap-letter { width:32px; text-align:center; }
    .soap-content { word-wrap: break-word; white-space: pre-wrap; border-radius:4px; padding:10px; background:#fafafa; border:1px solid #ececec; min-height:48px; }
    .notes-list-col .list-group-item { cursor:pointer; }
    .notes-list-col .list-group-item.active { background:#e9f7ff; color:inherit; border-color:#cfeefc; }
    .soap-display-col { background:transparent; }
    .soap-snippet { max-height:2.6em; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
    .list-scroll::-webkit-scrollbar, .notes-list-col::-webkit-scrollbar { width:10px; height:10px; }
    .list-scroll::-webkit-scrollbar-thumb, .notes-list-col::-webkit-scrollbar-thumb { background:#ddd; border-radius:6px; }

    @@media (max-width: 991px) {
        .note-panel .text-end { text-align: left !important; min-width: auto !important; margin-top:8px; }
    }
    @@media (max-width: 767px) {
        .col-lg-4, .col-lg-8 { flex: 0 0 100%; max-width: 100%; }
        .list-panel, .note-panel { margin-bottom: 12px; }
        .soap-letter { display:none; }
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tab selection + localStorage
    var tabButtons = document.querySelectorAll('#interventionTab button');
    var tabPanes = document.querySelectorAll('#interventionTabContent .tab-pane');
    var savedTabId = localStorage.getItem('activeInterventionTabId');
    var activeBtn = savedTabId ? document.getElementById(savedTabId) : (tabButtons[0] || null);
    if (activeBtn) {
        var activeTarget = activeBtn.getAttribute('data-bs-target');
        tabButtons.forEach(function(btn){ btn.classList.remove('active'); btn.setAttribute('aria-selected','false'); });
        activeBtn.classList.add('active'); activeBtn.setAttribute('aria-selected','true');
        tabPanes.forEach(function(pane){
            if ('#'+pane.id === activeTarget) pane.classList.add('show','active'); else pane.classList.remove('show','active');
        });
    }

    tabButtons.forEach(function(btn){
        btn.addEventListener('click', function(){
            localStorage.setItem('activeInterventionTabId', this.id);
        });
    });

    // Note selection handling: delegate per tab pane
    document.querySelectorAll('.tab-pane').forEach(function(pane){
        var intervId = pane.id.replace('interv','');
        var list = pane.querySelector('#noteList-' + intervId);
        if (!list) return;

        // helper to show note content in soap-display in this pane
        function showNote(noteItem) {
            if (!noteItem) return;
            // toggle active class in list
            list.querySelectorAll('.note-item').forEach(function(it){ it.classList.remove('active'); });
            noteItem.classList.add('active');

            var data = noteItem.querySelector('.note-data');
            var subj = data.querySelector('.note-subj') ? data.querySelector('.note-subj').innerText : '';
            var obj = data.querySelector('.note-obj') ? data.querySelector('.note-obj').innerText : '';
            var ass = data.querySelector('.note-ass') ? data.querySelector('.note-ass').innerText : '';
            var plan = data.querySelector('.note-plan') ? data.querySelector('.note-plan').innerText : '';

            var subjEl = pane.querySelector('#subj-' + intervId);
            var objEl  = pane.querySelector('#obj-' + intervId);
            var assEl  = pane.querySelector('#ass-' + intervId);
            var planEl = pane.querySelector('#plan-' + intervId);

            if (subjEl) subjEl.textContent = subj || '';
            if (objEl) objEl.textContent = obj || '';
            if (assEl) assEl.textContent = ass || '';
            if (planEl) planEl.textContent = plan || '';

            // show edit link if exists (construct edit url)
            var editBtn = pane.querySelector('.edit-note-btn');
            if (editBtn) {
                editBtn.classList.remove('d-none');
                var noteId = noteItem.getAttribute('data-note-id');
                editBtn.href = '@Url.Action("EditSoap","ProgressNote")/'.replace(/\/$/, '') + '?id=' + noteId;
            }
            var viewFull = pane.querySelector('.view-full-btn');
            if (viewFull) viewFull.classList.remove('d-none');
            // store last selected per intervention
            localStorage.setItem('activeNoteForInterv-' + intervId, noteItem.getAttribute('data-note-id'));
        }

        // click handler
        list.addEventListener('click', function(e){
            var item = e.target.closest('.note-item');
            if (!item) return;
            e.preventDefault();
            showNote(item);
        });

        // restore last selected note if present, otherwise select first
        var savedNote = localStorage.getItem('activeNoteForInterv-' + intervId);
        var restoreItem = savedNote ? list.querySelector('.note-item[data-note-id="' + savedNote + '"]') : list.querySelector('.note-item');
        if (restoreItem) showNote(restoreItem);
    });
});
</script>
