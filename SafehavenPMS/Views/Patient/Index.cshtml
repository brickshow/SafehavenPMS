@model IEnumerable<SafehavenPMS.Models.Patient>

@{
    ViewBag.Title = "Patient List";
}

<div class="header">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center g-4">
            <div class="d-flex justify-content-center align-items-center">
                <i class='bx bxs-user fs-2 me-2'></i>
                <h5 class="text-custom mb-0">Patients</h5>
            </div>
            <div class="top-content m-2 d-flex justify-content-between align-content-center">
                <div class="top-left-corner d-flex flex-row align-items-center gap-2">
                    @* Search bar *@
                    <form asp-controller="Patient" asp-action="Search" method="get" class="d-flex flex-row justify-content-center m-1 gap-2">
                        <div class="search-input-wrapper d-flex flex-row gap-2">
                            <i class='bx bx-search search-icon'></i>
                            <input name="searchQuery" class="form-control search-input" placeholder="Search patients..." />
                        </div>
                        <button type="submit" class="btn-custom" style="height:30px">Search</button>
                    </form>
                    <!-- Filter by status -->
                    <div class="status">
                        <form asp-controller="Patient" asp-action="FilterStatus" method="get" class="d-flex justify-content-center align-items-center">
                            <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 10)" />
                            <input type="hidden" name="searchQuery" value="@ViewBag.SearchQuery" />
                            <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
                            <select name="status" class="form-select custom-dropdown" onchange="this.form.submit()">
                                <option value="">All</option>
                                <option value="Active" selected="@(ViewBag.Status == "Active")">🟩 Active</option>
                                <option value="Waitlisted" selected="@(ViewBag.Status == "Waitlisted")">🟧 Waitlisted</option>
                                <option value="Pending Assesment" selected="@(ViewBag.Status == "Pending Assesment")">🟪 Pending Assesment</option>
                                <option value="Pending Approval" selected="@(ViewBag.Status == "Pending Approval")">🟦 Pending Approval</option>
                                <option value="Admitted" selected="@(ViewBag.Status == "Admitted")">🟪 Admitted</option>
                                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">🟥 Inactive</option>
                            </select>

                        </form>
                    </div>
                    <!-- Sort by -->
                    <div class="sort-by d-flex align-items-center">
                        <form asp-controller="Patient" asp-action="SortBy" method="get" id="sortForm">
                            <input type="hidden" name="sortOrder" value="@(ViewBag.SortOrder == "descending" ? "ascending" : "descending")" />
                            <button type="submit" class="sort-button d-flex align-items-center justify-content-between">
                                <span class="me-2">Sort by</span>
                                <div class="number-box d-flex align-items-center gap-1">
                                    <div class="numbers d-flex flex-column justify-content-center align-items-center">
                                        <span class="number">A</span>
                                        <span class="number">Z</span>
                                    </div>
                                    <i class='bx bx-up-arrow-alt @(ViewBag.SortOrder == "descending" ? "rotate-180" : "")'></i>
                                </div>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <a href="@Url.Action("AddNewPatient", "Patient")" class="btn-custom text-decoration-none btn-primary">
            <i class='bx bx-user-plus me-1'></i>
            New Patient
        </a>
    </div>
    <hr class="mt-0 mb-2" />
</div>

ccc