@using SafehavenPMS.Enum
@model IEnumerable<SafehavenPMS.Models.Patient>

@{
    ViewBag.Title = "Patients";
}

<div class="header">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center g-4">
            <div class="d-flex justify-content-center align-items-center">
                <i class='bx bxs-user fs-2 me-2'></i>
                <h5 class="text-custom mb-0">Patients</h5>
            </div>
            <div class="top-content m-2 d-flex justify-content-between align-content-center">
                <div class="top-left-corner d-flex flex-row align-items-center gap-2">
                    @* Search bar *@
                    <form asp-controller="Patient" asp-action="Search" method="get" class="d-flex flex-row justify-content-center m-1 gap-2">
                        <div class="search-input-wrapper d-flex flex-row gap-2">
                            <i class='bx bx-search search-icon'></i>
                            <input name="searchQuery" class="form-control search-input" placeholder="Search patients..." />
                        </div>
                        <button type="submit" class="btn-custom" style="height:30px">Search</button>
                    </form>

                    
                </div>
            </div>
        </div>
        <a href="@Url.Action("AddNewPatient", "Patient")" class="btn-custom text-decoration-none btn-primary">
            <i class='bx bx-user-plus me-1'></i>
            New Patient Intake
        </a>
    </div>
    <hr class="mt-0 mb-2" />
</div>

