@model SafehavenPMS.ViewModel.ClinicalStaffProfileViewModel

@{
    //Extract Patient records
    var patient = Model.Patients.FirstOrDefault();

    //Calculate age
    int? age = null;

    if (patient?.DateOfBirth != null)
    {
        var today = DateTime.Today;
        var birthDate = patient.DateOfBirth;
        age = today.Year - birthDate.Year;

        // Subtract 1 if birthday hasn't occurred yet this year
        if (birthDate.Date > today.AddYears(-age.Value))
        {
            age--;
        }
    }
}


<div class="container rounded border p-4 bg-white">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bx bxs-user fs-5 text-dark"></i>
            <h6 class="mb-0 fw-bold text-dark">About Patient</h6>
        </div>
        <a href="#" class="text-decoration-none fw-semibold text-info">Edit</a>
    </div>

    <!-- Personal Information -->
    <h6 class="text-info fw-semibold mb-3" style="color:#015F6B">Personal Information</h6>
    <div class="row mb-4">
        <div class="col-md-9">
            <div class="row g-3">
                <div class="col-md-4">
                    <p class="text-muted mb-1">First Name</p>
                    <p class="fw-semibold">@patient?.Firstname</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted mb-1">Middle Name</p>
                    <p class="fw-semibold">@patient?.Lastname</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted mb-1">Last Name</p>
                    <p class="fw-semibold">@patient?.Lastname</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted mb-1">Birthdate</p>
                    <p class="fw-semibold">@patient?.DateOfBirth.ToShortTimeString()</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted mb-1">Age</p>
                    <p class="fw-semibold">@age</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted mb-1">Marital Status</p>
                    <p class="fw-semibold">@patient.MaritalStatus</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted mb-1">Employment/Occupation</p>
                    <p class="fw-semibold">@patient.Occupation</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted mb-1">Religion</p>
                    <p class="fw-semibold">@patient.Religion</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted mb-1">Sex</p>
                    <p class="fw-semibold">@patient.Sex</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted mb-1">Phone Number</p>
                    <p class="fw-semibold">@patient.PhoneNumber</p>
                </div>
            </div>
        </div>

        <!-- Profile Picture -->
        <div class="col-md-3 d-flex flex-column align-items-center text-center">
            <img src="@(string.IsNullOrEmpty(patient.PhotoUrl) ? "/Images/default.png" : patient.PhotoUrl)" class="rounded-circle mb-2" style="width: 100px; height: 100px; object-fit: cover;" alt="Profile" />
            <button class="btn btn-outline-primary btn-sm">Change Picture</button>
        </div>
    </div>

    <!-- Home Address -->
    <h6 class="text-info fw-semibold mb-3">Home Address</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <p class="text-muted mb-1">Case No.</p>
            <p class="fw-semibold">09-39923</p>
        </div>
        <div class="col-md-4">
            <p class="text-muted mb-1">Date of Intake</p>
            <p class="fw-semibold">January 1, 2022</p>
        </div>
        <div class="col-md-4">
            <p class="text-muted mb-1">Date of Referral</p>
            <p class="fw-semibold">January 1, 2923</p>
        </div>
        <div class="col-md-4">
            <p class="text-muted mb-1">Referred By</p>
            <p class="fw-semibold">Male</p>
        </div>
        <div class="col-md-4">
            <p class="text-muted mb-1">Affiliation</p>
            <p class="fw-semibold">Male</p>
        </div>
    </div>

    <!-- Intake Details -->
    <h6 class="text-info fw-semibold mb-3">Intake Details</h6>
    <div class="row g-3">
        <div class="col-md-4">
            <p class="text-muted mb-1">Date of Intake</p>
            <p class="fw-semibold">January 1, 2022</p>
        </div>
        <div class="col-md-4">
            <p class="text-muted mb-1">Date of Referral</p>
            <p class="fw-semibold">January 1, 2923</p>
        </div>
        <div class="col-md-4">
            <p class="text-muted mb-1">Referred By</p>
            <p class="fw-semibold">Male</p>
        </div>
        <div class="col-md-4">
            <p class="text-muted mb-1">Affiliation</p>
            <p class="fw-semibold">Male</p>
        </div>
    </div>
</div>
    