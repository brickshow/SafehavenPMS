@model SafehavenPMS.ViewModel.PatientProfile.PatientPersonalInfoTabViewModel

@if (Model == null)
{
    <div class="alert alert-warning">No patient data available.</div>
}
else
{
    <div class="container-fluid rounded p-4 bg-white w-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <p class="fw-semibold mb-3" style="color:#015F6B">Personal Information</p>
            </div>
            <a href="@Url.Action("Edit", "Patient")" class="text-decoration-none fw-semibold text-info">Edit</a>
        </div>

        <hr />
        <div class="row mb-4">
            <div class="col-md-10">
                <div class="row g-3">
                    <div class="col-md-3">
                        <p class="text-muted mb-1">First Name</p>
                        <p class="fw-semibold">@Model?.FirstName</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Middle Name</p>
                        <p class="fw-semibold">@Model?.MiddleName</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Last Name</p>
                        <p class="fw-semibold">@Model?.LastName</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Birthdate</p>
                        <p class="fw-semibold">@Model?.DateOfBirth</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Age</p>
                        <p class="fw-semibold">@Model?.Age</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Marital Status</p>
                        <p class="fw-semibold">@Model?.MaritalStatus</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Employment/Occupation</p>
                        <p class="fw-semibold">@Model?.Occupation</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Religion</p>
                        <p class="fw-semibold">@Model?.Religion</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Sex</p>
                        <p class="fw-semibold">@Model?.Sex</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Phone Number</p>
                        <p class="fw-semibold">@Model?.PhoneNumber</p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted mb-1">Address</p>
                        <p class="fw-semibold">@Model?.Address</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="border overflow-hidden mb-2" style="width: 150px; height: 150px; border-radius:6px">
                    <img id="imagePreview" src="@(string.IsNullOrEmpty(Model?.PhotoUrl) ? Url.Content("~/Images/default.png") : Model.PhotoUrl)" alt="Profile" class="w-100 h-100 object-fit-cover">
                </div>
            </div>
        </div>

        <h6 class="fw-semibold mb-3" style="color:#015F6B">Family Constellation</h6>
        <hr />

        @if (Model.FamilyConstellation != null && Model.FamilyConstellation.Any())
        {
            <div class="table-responsive">
                <table class="table table-borderless">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Relationship</th>
                            <th>Age</th>
                            <th>Comments</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.FamilyConstellation)
                        {
                            if (!string.IsNullOrWhiteSpace(member.Name) ||
                                !string.IsNullOrWhiteSpace(member.Relationship) ||
                                member.Age != null ||
                                !string.IsNullOrWhiteSpace(member.Comments))
                            {
                                <tr>
                                    <td>@member.Name</td>
                                    <td>@member.Relationship</td>
                                    <td>@member.Age</td>
                                    <td>@member.Comments</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No family members listed.</p>
        }
    </div>
}

<style>
    .container-fluid {
        width: 100%;
    }
    .change-picture-btn {
        width: 180px;
        padding: 8px 24px;
        border: 2px solid #008B9B;
        border-radius: 6px;
        background: transparent;
        color: #008B9B;
        font-weight: 500;
        transition: all 0.3s ease;
        text-align: center;
    }
    .change-picture-btn:hover {
        background-color: #008B9B;
        color: white;
        transform: translateY(-1px);
    }
</style>
