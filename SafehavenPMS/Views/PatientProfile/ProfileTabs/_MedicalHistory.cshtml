@model SafehavenPMS.ViewModel.PatientMedicalHistoryTabViewModel
@{
    var canUpload = Model?.CanUpload ?? false;
}
<div class="mb-3">
    @if (canUpload)
    {
        <div id="mh-upload-area" style="border:2px dashed #079; padding:22px; text-align:center; border-radius:8px; background:#f5fbfd; cursor:pointer;">
            <strong>Drop files here</strong> or click to browse
            <br /><small>Any file type (max 50MB)</small>
            <input id="mhFileInput" type="file" multiple style="display:none;" />
        </div>
        <div id="mh-progress" class="mt-2" style="display:none;">
            <div class="progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width:0%">0%</div>
            </div>
        </div>
    }
</div>

<h5>Uploaded Documents</h5>

<div id="mh-doc-grid" style="display:flex; flex-wrap:wrap; gap:16px;">
    @if (Model?.Documents == null || !Model.Documents.Any())
    {
        <div class="text-muted">No documents uploaded.</div>
    }
    else
    {
        foreach (var d in Model.Documents)
        {
            bool isImage = d.ContentType?.StartsWith("image/") == true;
            <div class="mh-card" style="flex:1 1 230px; max-width:250px; background:#fff; border:1px solid #d9e4e7; border-radius:10px; padding:12px;">
                <div style="font-size:.75rem; font-weight:600; color:#555; word-break:break-word;">@d.FileName</div>
                <div style="margin:10px 0; height:130px; display:flex; align-items:center; justify-content:center; background:#f1f6f7; border-radius:6px; overflow:hidden;">
                    @if (isImage)
                    {
                        <img src="@d.Url" alt="@d.FileName" style="max-width:100%; max-height:100%; object-fit:contain;" />
                    }
                    else if (d.ContentType == "application/pdf")
                    {
                        <i class="bx bxs-file-pdf" style="font-size:2.2rem; color:#c22;"></i>
                    }
                    else
                    {
                        <i class="bx bxs-file" style="font-size:2rem; color:#555;"></i>
                    }
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <a class="btn btn-sm btn-outline-primary" target="_blank" href="@d.Url">Open</a>
                    <span style="font-size:.55rem; color:#888;">@d.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
        }
    }
</div>

@if (canUpload)
{
<script>
(() => {
    const area = document.getElementById('mh-upload-area');
    const input = document.getElementById('mhFileInput');
    const grid = document.getElementById('mh-doc-grid');
    const progWrap = document.getElementById('mh-progress');
    const progBar = progWrap?.querySelector('.progress-bar');
    const patientId = @Model.PatientId;

    if (!area) return;

    const pick = () => input.click();
    area.addEventListener('click', pick);
    area.addEventListener('dragover', e => { e.preventDefault(); area.style.background='#e9f8fb'; });
    area.addEventListener('dragleave', e => { e.preventDefault(); area.style.background='#f5fbfd'; });
    area.addEventListener('drop', e => {
        e.preventDefault();
        area.style.background='#f5fbfd';
        if (e.dataTransfer.files?.length) handleFiles(e.dataTransfer.files);
    });
    input.addEventListener('change', e => handleFiles(e.target.files));

    function handleFiles(list){
        if(!list) return;
        [...list].forEach(uploadFile);
    }
    async function uploadFile(file){
        progWrap.style.display='block';
        setProgress(0);
        const fd=new FormData();
        fd.append('patientId', patientId);
        fd.append('file', file);
        try{
            const r=await fetch('/PatientProfile/UploadMedicalHistoryDocument',{method:'POST',body:fd});
            if(!r.ok){console.error('upload failed');return;}
            const d=await r.json();
            addCard(d);
        }catch(err){console.error(err);}
        finally{
            setProgress(100);
            setTimeout(()=>{progWrap.style.display='none'; setProgress(0);},600);
        }
    }
    function setProgress(p){ if(!progBar) return; progBar.style.width=p+'%'; progBar.textContent=p+'%'; }
    function addCard(d){
        if(grid.querySelector('.text-muted')) grid.innerHTML='';
        const isImage = (d.contentType||'').startsWith('image/');
        const card=document.createElement('div');
        card.className='mh-card';
        card.style.cssText="flex:1 1 230px; max-width:250px; background:#fff; border:1px solid #d9e4e7; border-radius:10px; padding:12px;";
        card.innerHTML=`
            <div style="font-size:.75rem;font-weight:600;color:#555;word-break:break-word;">${d.fileName}</div>
            <div style="margin:10px 0;height:130px;display:flex;align-items:center;justify-content:center;background:#f1f6f7;border-radius:6px;overflow:hidden;">
                ${isImage ? `<img src="${d.url}" style="max-width:100%;max-height:100%;object-fit:contain;">`
                : (d.contentType==='application/pdf'
                    ? '<i class="bx bxs-file-pdf" style="font-size:2.2rem;color:#c22;"></i>'
                    : '<i class="bx bxs-file" style="font-size:2rem;color:#555;"></i>')}
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <a class="btn btn-sm btn-outline-primary" target="_blank" href="${d.url}">Open</a>
                <span style="font-size:.55rem;color:#888;">now</span>
            </div>`;
        grid.prepend(card);
    }
})();
</script>
}