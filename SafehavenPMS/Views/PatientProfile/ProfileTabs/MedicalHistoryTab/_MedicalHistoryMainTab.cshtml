@model SafehavenPMS.ViewModel.AssessmentFormViewModel
@{
    ViewBag.Title = "Medical History";
}

<div class="row g-1">
    <!-- Vertical navigation -->
    <div class="col-md-2">
        <div class="nav flex-column nav-tabs mh-tabs" id="medHistoryTabs" role="tablist">
            <div class="nav-link active" id="history-present-tab" data-bs-toggle="tab" data-bs-target="#history-present" role="tab" aria-selected="true">
                <div class="d-flex align-items-center">
                    <div class="tab-indicator"></div>
                    <span>History of Present Illness</span>
                </div>
            </div>
            <div class="nav-link" id="drug-history-tab" data-bs-toggle="tab" data-bs-target="#drug-history" role="tab" aria-selected="false">
                <div class="d-flex align-items-center">
                    <div class="tab-indicator"></div>
                    <span>History of Drug Use</span>
                </div>
            </div>
            <div class="nav-link" id="medical-history-tab-inner" data-bs-toggle="tab" data-bs-target="#medical-history" role="tab" aria-selected="false">
                <div class="d-flex align-items-center">
                    <div class="tab-indicator"></div>
                    <span>Past Medical History</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="col-md-10">
        <div class="tab-content" id="medHistoryTabContent">
            <div class="tab-pane fade show active p-4" id="history-present" role="tabpanel" aria-labelledby="history-present-tab">
                @await Html.PartialAsync("~/Views/PatientProfile/ProfileTabs/MedicalHistoryTab/_HistoryPresentProfile.cshtml", Model)
            </div>

            <div class="tab-pane fade p-4" id="drug-history" role="tabpanel" aria-labelledby="drug-history-tab">
                @await Html.PartialAsync("~/Views/PatientProfile/ProfileTabs/MedicalHistoryTab/_HistoryOfDrugUse.cshtml", Model)
            </div>

               <div class="tab-pane fade show p-4" id="medical-history" role="tabpanel" aria-labelledby="medical-history-tab">
                @await Html.PartialAsync("~/Views/PatientProfile/ProfileTabs/MedicalHistoryTab/_PastMedicalHistory.cshtml", Model)
            </div>
        </div>
    </div>
</div>

<style>
    .mh-tabs { border: none; height: 100%; }
    .mh-tabs .nav-link {
        border: none; border-radius: 0; margin-bottom: 2px; text-align: left;
        padding: 12px 15px; color: #495057; background-color: #fff; transition: all 0.2s ease;
        width: 100%; position: relative; cursor: pointer;
    }
    .mh-tabs .nav-link .tab-indicator {
        width:4px; position:absolute; left:0px; top:0; bottom:0; background:transparent; transition:background-color .2s ease;
    }
    .mh-tabs .nav-link.active { background:#006d77; color:#fff; }
    .mh-tabs .nav-link.active .tab-indicator { background:#00a3b5; }
    .mh-tabs .nav-link:hover { background:#f8f9fa; }
    .tab-content {
        background:#fff; border:1px solid #eee; min-height:500px; box-shadow:0 2px 4px rgba(0,0,0,.05);
    }
    .fw-semibold { font-weight:600; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const nav = document.getElementById('medHistoryTabs');
        const panes = document.getElementById('medHistoryTabContent');
        const KEY = 'medHistoryActiveTab';

        const stored = localStorage.getItem(KEY);
        if (stored) {
            nav.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
            panes.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('show', 'active'));
            const link = nav.querySelector(`[data-bs-target="${stored}"]`);
            const pane = panes.querySelector(stored);
            if (link && pane) {
                link.classList.add('active');
                pane.classList.add('show', 'active');
            }
        }

        nav.querySelectorAll('.nav-link').forEach(l => {
            l.addEventListener('click', () => {
                const target = l.getAttribute('data-bs-target');
                if (target) localStorage.setItem(KEY, target);
            });
        });
    });
</script>