@model SafehavenPMS.ViewModel.PatientOverViewTabViewModel

<div class="row bg-light">
    <!-- LEFT column -->
    <div class="col-lg-6">
        <div class="mb-3">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 fw-semibold" style="color:#015F6B; font-size: 1.2rem;">Food Allergies</h6>
                        <small class="text-muted">List of known food allergies</small>
                    </div>
                    <a class="text-muted small" href="@Url.Action("EditInitialAssessmentForm", "Assessment")">View</a>
                </div>
                <div class="card-body pt-0">
                    @if (Model?.FoodAllergies != null && Model.FoodAllergies.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 m-3 mt-0 mb-0">
                            @foreach (var item in Model.FoodAllergies)
                            {
                                <span class="badge bg-light text-dark border rounded-pill">@item</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No food allergies recorded</div>
                    }
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 fw-semibold" style="color:#015F6B; font-size: 1.2rem;">Drug Allergies</h6>
                        <small class="text-muted">Known drug reactions</small>
                    </div>
                    <a class="text-muted small" href="@Url.Action("EditInitialAssessmentForm", "Assessment")">View</a>
                </div>
                <div class="card-body pt-0">
                    @if (Model?.DrugAllergies != null && Model.DrugAllergies.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 m-3 mt-0 mb-0">
                            @foreach (var item in Model.DrugAllergies)
                            {
                                <span class="badge bg-light text-dark border rounded-pill">@item</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No drug allergies recorded</div>
                    }
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 fw-semibold" style="color:#015F6B; font-size: 1.2rem;">Active Medications</h6>
                        <small class="text-muted">Current prescriptions</small>
                    </div>
                    <a class="text-muted small" href="#">View all</a>
                </div>
                <div class="card-body pt-0 fw-semibold">
                    @if (Model?.ActiveMedications != null && Model.ActiveMedications.Any())
                    {
                        <div class="text-truncate m-3 mt-0 mb-0">@string.Join(", ", Model.ActiveMedications)</div>
                    }
                    else
                    {
                        <div class="text-muted">No active medications</div>
                    }
                </div>
            </div>
        </div>

        <!-- Replace TODAY'S NOTES with PROBLEM LIST -->
        <div>
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 fw-semibold" style="color:#015F6B; font-size: 1.2rem;">Problem List</h6>
                        <small class="text-muted">Only active problems</small>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="text-muted small" href="#">View</a>
                    </div>
                </div>

                <div class="card-body pt-0">
                    @if (Model?.ProblemList != null && Model.ProblemList.Any())
                    {
                        <ul class="list-group list-group-flush m-3 mt-0 mb-0">
                            @foreach (var problem in Model.ProblemList)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="fw-semibold">@problem</div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted">No problems have been recorded.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT column -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0 fw-semibold" style="color:#015F6B; font-size: 1.2rem;">Treatment Team</h6>
                </div>

                <div>
                    @if (Model?.TreatmentTeams != null && Model.TreatmentTeams.Any())
                    {
                        @foreach (var member in Model.TreatmentTeams)
                        {
                            <div class="d-flex align-items-center justify-content-between mb-2 p-2 border rounded">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                                        <i class="bx bx-user fs-4 text-muted"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@member.FullName</div>
                                        <div class="small text-muted">@member.Position</div>
                                    </div>
                                </div>
                                <a class="small text-decoration-none" href="@Url.Action("Profile", "ClinicalStaff", new { id = member.ClinicalStaffId })">View Profile</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">No team members assigned</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card { border: 1px solid rgba(0,0,0,0.06); border-radius:6px; }
    .badge { padding:.4rem .6rem; font-size:.85rem; }
    .list-group-item { border: none; border-bottom: 1px solid rgba(0,0,0,0.04); }
    @@media (max-width:991px) {
        .col-lg-8, .col-lg-4 { flex:0 0 100%; max-width:100%; }
    }
</style>