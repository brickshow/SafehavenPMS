    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var triggerTabList = [].slice.call(document.querySelectorAll('#problemTab button'));
            var tabPanes = document.querySelectorAll('#problemTabContent .tab-pane');

            // Function to update problem item highlighting
            function updateProblemHighlight(selectedButton) {
                document.querySelectorAll('.nav-item .d-flex').forEach(function(item) {
                    item.classList.remove('bg-lightblue');
                    item.style.background = "#fff";
                });
                if (selectedButton) {
                    var dFlex = selectedButton.closest('.nav-item').querySelector('.d-flex');
                    dFlex.classList.add('bg-lightblue');
                    dFlex.style.background = "#D6F2F7"; // Force full lightblue background
                    // Also set all children to transparent so the parent color shows through
                    dFlex.querySelectorAll('*').forEach(function(child) {ss
                        child.style.background = "transparent";
                    });
                }
            }

            function showTabPane(tabId) {
                tabPanes.forEach(function(pane) {
                    if ('#' + pane.id === tabId) {
                        pane.classList.add('show', 'active');
                    } else {
                        pane.classList.remove('show', 'active');
                    }
                });
            }

            triggerTabList.forEach(function (triggerEl) {
                var tabTrigger = new bootstrap.Tab(triggerEl);

                triggerEl.addEventListener('click', function (event) {
                    event.preventDefault();
                    tabTrigger.show();
                    updateProblemHighlight(this);
                    showTabPane(this.getAttribute('data-bs-target'));
                });

                // Initialize the first item as active
                if (triggerEl.getAttribute('aria-selected') === 'true') {
                    updateProblemHighlight(triggerEl);
                }
            });

            // Make the whole problem clickable except the dropdown
            document.querySelectorAll('#problemTab .d-flex').forEach(function(item) {
                item.addEventListener('click', function(e) {
                    if (e.target.closest('.dropdown')) return;
                    var btn = item.querySelector('button');
                    var tabTrigger = new bootstrap.Tab(btn);
                    tabTrigger.show();
                    updateProblemHighlight(btn);
                    showTabPane(btn.getAttribute('data-bs-target'));
                });
            });

            // On load, set all to white except the active one
            document.querySelectorAll('.nav-item .d-flex').forEach(function(item) {
                item.classList.remove('bg-lightblue');
                item.style.background = "#fff";
            });
            var activeBtn = document.querySelector('#problemTab button.active') || document.querySelector('#problemTab button');
            if (activeBtn) {
                var dFlex = activeBtn.closest('.nav-item').querySelector('.d-flex');
                dFlex.classList.add('bg-lightblue');
                dFlex.style.background = "#D6F2F7";
                dFlex.querySelectorAll('*').forEach(function(child) {
                    child.style.background = "transparent";
                });
            }
        });

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('[data-bs-target="#addInterventionModal"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var activeTabBtn = document.querySelector('#problemTab button.active');
                if (!activeTabBtn) activeTabBtn = document.querySelector('#problemTab button');
                var problemId = activeTabBtn.getAttribute('data-bs-id');
                document.querySelector('#addInterventionModal input[name="problemId"]').value = problemId;
            });
        });
    });

    document.addEventListener('DOMContentLoaded', function() {
        var tabButtons = document.querySelectorAll('#problemTab button');
        var tabPanes = document.querySelectorAll('#problemTabContent .tab-pane');

        // Restore active tab from localStorage
        var savedTabId = localStorage.getItem('activeProblemTabId');
        var activeBtn = savedTabId ? document.getElementById(savedTabId) : tabButtons[0];
        var activeTarget = activeBtn.getAttribute('data-bs-target');

        tabButtons.forEach(function(btn) {
            btn.classList.remove('active');
            btn.setAttribute('aria-selected', 'false');
        });
        activeBtn.classList.add('active');
        activeBtn.setAttribute('aria-selected', 'true');

        tabPanes.forEach(function(pane) {
            if ('#' + pane.id === activeTarget) {
                pane.classList.add('show', 'active');
            } else {
                pane.classList.remove('show', 'active');
            }
        });

        // Highlight sidebar: all white except active
        document.querySelectorAll('.nav-item .d-flex').forEach(function(item) {
            item.classList.remove('bg-lightblue');
            item.style.background = "#fff";
        });
        var dFlex = activeBtn.closest('.nav-item').querySelector('.d-flex');
        dFlex.classList.add('bg-lightblue');
        dFlex.style.background = "#D6F2F7";
        dFlex.querySelectorAll('*').forEach(function(child) {
            child.style.background = "transparent";
        });

        // Save tab on click
        tabButtons.forEach(function(btn) {
            btn.addEventListener('click', function() {
                localStorage.setItem('activeProblemTabId', this.id);
            });
        });
    });
    </script>

