@model SafehavenPMS.ViewModel.PatientProfile.PatientTreatmentPlanTabViewModel

@{
    var activeProblem = Model.Problems.FirstOrDefault(); // Default to first
}
<div class="treatmentplan-partial container-fluid p-3" style="background:transparent;">
    <div class="row gx-3" style="min-height:600px;">
        <!-- Problem List Sidebar -->
        <div class="col-lg-4 col-md-12 mb-3 mb-lg-0">
            <div class="card list-panel h-100 shadow-sm" style="border:1px solid #e6e9ea;">
                <div class="card-body p-3 d-flex flex-column" style="gap:12px;">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Problem List</h5>
                        <button type="button" class="btn btn-link text-teal fw-semibold small p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#AddProblemModal">+ Add</button>
                    </div>
                    <div class="list-scroll" style="overflow:auto; flex:1;">
                        <ul class="nav flex-column" id="problemTab" role="tablist">
                            @for (int i = 0; i < Model.Problems.Count; i++)
                            {
                                var problem = Model.Problems[i];
                                <li class="nav-item" role="presentation">
                                    <div class="d-flex align-items-center justify-content-between px-2 py-2 problem-list-row" style="border:1px solid #e5e5e5;">
                                        <button
                                            class="w-100 border-0 text-start p-0 m-0"
                                            id="problem@(i+1)-tab"
                                            data-bs-toggle="tab"
                                            data-bs-target="#problem@(i+1)"
                                            data-bs-id="@problem.PsyProblemListId"
                                            type="button"
                                            role="tab"
                                            aria-controls="problem@(i+1)"
                                            aria-selected="false"
                                            style="outline:none; text-decoration:none; color:inherit;">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="me-2">
                                                    <div class="fw-bold">@problem.Problems</div>
                                                    <div class="small text-muted">@problem.Status</div>
                                                </div>
                                            </div>
                                        </button>
                                        <div class="dropdown ms-2" style="position:relative;">
                                            <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" class="d-flex align-items-center px-2">
                                                <i class="bx bx-dots-vertical fs-5 text-muted"></i>
                                            </a>
                                            <ul class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 px-2 py-2 rounded-3" style="min-width: 180px;">
                                                <li class="px-2 text-muted fw-semibold small">Options</li>
                                                <li>
                                                    <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                    data-bs-toggle="modal" data-bs-target="#EditProblemModal-@problem.PsyProblemListId">
                                                        Edit Problem
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                    data-bs-toggle="modal" data-bs-target="#MarkProblemResolvedModal-@problem.PsyProblemListId">
                                                        Mark as Resolved
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                    data-bs-toggle="modal" data-bs-target="#MarkProblemInactiveModal-@problem.PsyProblemListId">
                                                        Mark as Inactive
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                    data-bs-toggle="modal" data-bs-target="#MarkProblemActiveModal-@problem.PsyProblemListId">
                                                        Mark as Active
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab content -->
        <div class="col-lg-8 col-md-12">
            <div class="d-flex flex-column h-100" style="gap:12px;">
                <div class="tab-content" id="problemTabContent">
                    @for (int i = 0; i < Model.Problems.Count; i++)
                    {
                        var problem = Model.Problems[i];
                        var paneActive = i == 0 ? "show active" : "";
                    <div class="tab-pane fade @paneActive" id="problem@(i+1)" role="tabpanel" aria-labelledby="problem@(i+1)-tab">
                        <div class="d-flex flex-column bg-white flex-md-row justify-content-between align-items-start p-3 intervention-details" style="border:1px solid #e6e9ea;">
                            <div class="flex-grow-1 me-3">
                                <h5 class="mb-1 intervention-title">@problem.Problems</h5>
                                <div class="text-muted small short-desc">@problem.Status</div>
                            </div>
                            <div class="text-end small text-muted intervention-meta" style="min-width:220px;">
                                <div><strong>Noted by:</strong> sjdsajhdjah</div>
                                <div><strong>Date Diagnosed:</strong> @problem.DateAdded?.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>

                        <div class="mt-4 bg-white p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h4 class="fw-semibold mb-0">Interventions</h4>
                                <div>
                                    <button type="button" class="btn btn-custom text-white fw-semibold"
                                        style="background:#0097A7; border-radius:10px; min-width:160px;"
                                        data-bs-toggle="modal"
                                        data-bs-target="#addInterventionModal">
                                        Add Intervention
                                    </button>
                                    <a class="btn btn-custom text-white fw-semibold ms-2"
                                        style="background:#0097A7; border-radius:10px; min-width:160px;"
                                        href="@Url.Action("AddMedicationOrder", "Medication", new { patientId = ViewBag.PatientId, problemId = problem.PsyProblemListId })">
                                        Add Medication
                                    </a>
                                </div>
                            </div>
                            <div class="bg-white rounded-3 shadow-sm p-3">
                                <table class="table mb-0 align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width:40px; color:rgb(117, 116, 116);">#</th>
                                            <th style="color:rgb(117, 116, 116);">Description</th>
                                            <th style="color:rgb(117, 116, 116);">Frequency</th>
                                            <th style="color:rgb(117, 116, 116);">Status</th>
                                            <th style="color:rgb(117, 116, 116);">Clinician</th>
                                            <th style="width:40px; color:rgb(117, 116, 116);"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (problem.Interventions == null || problem.Interventions.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-5">
                                                    This patient has no added interventions yet.<br />
                                                    <a href="#" class="text-teal fw-semibold small text-decoration-none" data-bs-toggle="modal" data-bs-target="#addInterventionModal">+ Add Now</a>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int idx = 1;
                                            foreach (var intervention in problem.Interventions)
                                            {
                                                var isMedication = intervention?.MedicationOrderId.HasValue == true;
                                                <tr>
                                                    <td class="fw-semibold">@idx</td>
                                                    <td>
                                                        @if (isMedication)
                                                        {
                                                            <div class="fw-bold">Medication</div>
                                                            <div class="text-muted small" style="font-size:1.05em;">@intervention.MedicationName</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="fw-bold" style="font-size:1.05em;">@intervention?.ServiceModalityName</div>
                                                            <div class="text-muted small">@intervention.Description</div>
                                                        }
                                                    </td>
                                                    <td class="fw-normal">
                                                        @if (isMedication)
                                                        {
                                                            @intervention.ScheduledType
                                                        }
                                                        else
                                                        {
                                                            @intervention.Frequency
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="fw-normal">
                                                            @if (isMedication)
                                                            {
                                                                if (intervention?.Status == "NotStarted")
                                                                {
                                                                    @:Not Started
                                                                }
                                                                else if (intervention?.Status == "Active")
                                                                {
                                                                    @:Active
                                                                }
                                                                else
                                                                {
                                                                    @(intervention?.Status ?? "")
                                                                }
                                                            }
                                                            else
                                                            {
                                                                if (intervention?.Status == "NotStarted")
                                                                {
                                                                    @:Not Started
                                                                }
                                                                else if (intervention?.Status == "Active")
                                                                {
                                                                    @:Active
                                                                }
                                                                else
                                                                {
                                                                    @(intervention?.Status ?? "")
                                                                }
                                                            }
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <img src="~/Images/default.png" alt="Clinician" class="rounded-circle" style="width:36px;height:36px;object-fit:cover;" />
                                                    </td>
                                                    <td>
                                                        <div class="dropdown">
                                                            <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                                <i class="bx bx-dots-vertical fs-5 text-muted"></i>
                                                            </a>
                                                            <ul class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 px-2 py-2 rounded-3">
                                                                <li class="px-2 text-muted fw-semibold small">Options</li>
                                                                @* ...existing dropdown logic... *@
                                                                @if (isMedication)
                                                                {
                                                                    @if(intervention.Status == "Active")
                                                                    {
                                                                        <li>
                                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                                                href="#"
                                                                                data-bs-toggle="modal"
                                                                                data-bs-target="#confirmDiscontinueMedicationModal-@intervention.MedicationOrderId">
                                                                                    Discontinue Medication
                                                                            </a>
                                                                        </li>
                                                                        <li>
                                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                                            href="#"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#confirmCompleteMedicationModal-@intervention.MedicationOrderId">
                                                                                Mark as Completed
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                    else if(intervention.Status == "NotStarted")
                                                                    {
                                                                        <li>
                                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                                            href="#"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#confirmDeleteMedicationModal-@intervention.MedicationOrderId">
                                                                                Remove Medication
                                                                            </a>
                                                                        </li>
                                                                    }else{
                                                                        <li>
                                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                                            href="#"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#confirmActivateMedicationModal-@intervention.MedicationOrderId">
                                                                                Mark as Active
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                   @if(intervention.Status == "Active")
                                                                    {
                                                                        <li>
                                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                                            href="#"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#confirmDiscontinueInterventionModal-@intervention.InterventionId">
                                                                                Discontinue
                                                                            </a>
                                                                        </li>
                                                                        <li>
                                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                                            href="#"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#confirmCompleteInterventionModal-@intervention.InterventionId">
                                                                                Mark as Completed
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                    else if(intervention.Status == "Not Started")
                                                                    {
                                                                        <li>
                                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                                            href="#"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#confirmDeleteInterventionModal-@intervention.InterventionId">
                                                                                Remove Intervention
                                                                            </a>
                                                                        </li>
                                                                    }else{
                                                                        <li>
                                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                                               href="@Url.Action("StartMedicationOrder", "Medication", new { id = intervention.MedicationOrderId })">
                                                                                Mark as Active
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                }
                                                            </ul>
                                                        </div>
                                                    </td>
                                                </tr>
                                                idx++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Problem Modal -->
<div class="modal fade" id="AddProblemModal" tabindex="-1" aria-labelledby="addProblemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:10px;">
            <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                <h5 class="modal-title fw-bold" id="addProblemModalLabel">Add Problem</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="AddProblem" asp-controller="TreatmentPlan" method="post">
                    <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                    <input type="hidden" name="psychiatricAssessmentId" value="@Model.Problems.FirstOrDefault()?.InitialAssessmentFormId" />
                    <div class="mb-3">
                        <label for="problemDescription" class="form-label fw-semibold">Problem</label>
                        <input type="text" name="problemText" class="form-control" id="problemDescription" placeholder="Enter problem" required />
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Problem Modal -->
@foreach (var problem in Model.Problems)
{
    <div class="modal fade" id="EditProblemModal-@problem.PsyProblemListId" tabindex="-1" aria-labelledby="editProblemModalLabel-@problem.PsyProblemListId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:10px;">
                <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                    <h5 class="modal-title fw-bold" id="editProblemModalLabel-@problem.PsyProblemListId">Edit Problem</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="EditProblem" asp-controller="TreatmentPlan" method="post">
                        <input type="hidden" name="PsyProblemListId" value="@problem.PsyProblemListId" />
                        <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                        <div class="mb-3">
                            <label for="editProblemDescription-@problem.PsyProblemListId" class="form-label fw-semibold">Problem</label>
                            <input type="text" name="problemText" class="form-control" id="editProblemDescription-@problem.PsyProblemListId" value="@problem.Problems" required />
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Save</button>
                        </div>
                    </form>
                </div>
            </div>  
        </div>
    </div>
}

<!-- Mark as Resolved Modal -->
@foreach (var problem in Model.Problems)
{
    <div class="modal fade" id="MarkProblemResolvedModal-@problem.PsyProblemListId" tabindex="-1" aria-labelledby="markProblemResolvedModalLabel-@problem.PsyProblemListId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:10px;">
                <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                    <h5 class="modal-title fw-bold" id="markProblemResolvedModalLabel-@problem.PsyProblemListId">Mark as Resolved</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="MarkProblemResolved" asp-controller="TreatmentPlan" method="post">
                        <input type="hidden" name="PsyProblemListId" value="@problem.PsyProblemListId" />
                        <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                        <p class="fw-semibold mb-0">Are you sure you want to mark this problem as resolved?</p>
                        <div class="mt-2 text-muted">
                            <strong>Problem:</strong> @problem.Problems
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:8px; min-width:100px;">Cancel</button>
                            <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Mark as Inactive Modal -->
@foreach (var problem in Model.Problems)
{
    <div class="modal fade" id="MarkProblemInactiveModal-@problem.PsyProblemListId" tabindex="-1" aria-labelledby="markProblemInactiveModalLabel-@problem.PsyProblemListId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:10px;">
                <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                    <h5 class="modal-title fw-bold" id="markProblemInactiveModalLabel-@problem.PsyProblemListId">Mark as Inactive</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="MarkProblemInactive" asp-controller="TreatmentPlan" method="post">
                        <input type="hidden" name="PsyProblemListId" value="@problem.PsyProblemListId" />
                        <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                        <p class="fw-semibold mb-0">Are you sure you want to mark this problem as inactive?</p>
                        <div class="mt-2 text-muted">
                            <strong>Problem:</strong> @problem.Problems
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:8px; min-width:100px;">Cancel</button>
                            <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Mark as Active Modal -->
@foreach (var problem in Model.Problems)
{
    <div class="modal fade" id="MarkProblemActiveModal-@problem.PsyProblemListId" tabindex="-1" aria-labelledby="markProblemActiveModalLabel-@problem.PsyProblemListId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:10px;">
                <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                    <h5 class="modal-title fw-bold" id="markProblemActiveModalLabel-@problem.PsyProblemListId">Mark as Active</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="MarkProblemActive" asp-controller="TreatmentPlan" method="post">
                        <input type="hidden" name="PsyProblemListId" value="@problem.PsyProblemListId" />
                        <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                        <p class="fw-semibold mb-0">Are you sure you want to mark this problem as active?</p>
                        <div class="mt-2 text-muted">
                            <strong>Problem:</strong> @problem.Problems
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:8px; min-width:100px;">Cancel</button>
                            <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

    <!-- Add Intervention Modal -->
    <div class="modal fade" id="addInterventionModal" tabindex="-1" aria-labelledby="addInterventionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg"> <!-- Changed to modal-lg -->
            <div class="modal-content" style="border-radius:10px;">
                <div class="modal-header" style="background:#00798A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                    <h5 class="modal-title fw-bold" id="addInterventionModalLabel">Add Intervention</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4"> <!-- Added more padding -->
                    <form asp-action="AddIntervention" asp-controller="TreatmentPlan" method="post">
                        <input type="hidden" name="problemId" value="@activeProblem?.PsyProblemListId" />
                        <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Service</label>
                            <select name="ServiceModality" id="ServiceModality" class="form-select">
                                <option value="" selected disabled>Select Service (Modality)</option>
                                @{
                                    var services = ViewBag.Services as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                                                   ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
                                }
                                @foreach (var service in services)
                                {
                                    <option value="@service.Value">@service.Text</option>
                                }
                            </select>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">Duration/Frequency</label>
                                <input type="text" name="DurationFrequency" class="form-control" placeholder="e.g. 1 hour weekly" required/>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">Start Date</label>
                                <input type="date" name="StartDate" class="form-control" />
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="Description" class="form-control" rows="3" placeholder="Enter intervention description" required></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:8px; min-width:100px;">Cancel</button>
                            <button type="submit" class="btn" style="background:#00798A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Add</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

<!-- Confirmation Modal for Discontinue Medication -->
@foreach (var problem in Model.Problems)
{
    if (problem.Interventions != null)
    {
        foreach (var intervention in problem.Interventions.Where(i => i.MedicationOrderId.HasValue))
        {
            <div class="modal fade" id="confirmDiscontinueMedicationModal-@intervention.MedicationOrderId" tabindex="-1" aria-labelledby="confirmDiscontinueMedicationLabel-@intervention.MedicationOrderId" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="border-radius:10px;">
                        <div class="modal-header" style="background:#0097A7; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
