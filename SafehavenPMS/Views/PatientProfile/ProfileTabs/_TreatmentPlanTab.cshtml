@model SafehavenPMS.ViewModel.PatientProfile.PatientTreatmentPlanTabViewModel

@{
    var activeProblem = Model.Problems.FirstOrDefault(); // Default to first
}

    <div class="row" style="min-height:600px;">
        <!-- Problem List Sidebar -->
        <div class="col-md-4 border-end px-4 py-3 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3 gap-3">
                <h5 class="fw-bold mb-0">Problem List</h5>
                <button type="button" class="btn btn-link text-teal fw-semibold small p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#AddProblemModal">+ Add</button>
            </div>

            <!-- Nav tabs -->
            <ul class="nav flex-column" id="problemTab" role="tablist">
                @for (int i = 0; i < Model.Problems.Count; i++)
                {
                    var problem = Model.Problems[i];
                    var isActive = i == 0 ? "active" : "";
                    <li class="nav-item position-relative" role="presentation" style="margin-bottom:10px; overflow:visible;">
                        <div class="d-flex align-items-center justify-content-between rounded-3 @(isActive == "active" ? "bg-lightblue" : "bg-light") px-3 py-3 nav-links cursor-pointer"
                             style="border: 1px solid #e5e5e5;"
                             data-tab="#problem@(i+1)">
                            <button
                                class="w-100 bg-transparent border-0 text-start p-0 m-0"
                                id="problem@(i+1)-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#problem@(i+1)"
                                data-bs-id="@problem.PsyProblemListId"
                                type="button"
                                role="tab"
                                aria-controls="problem@(i+1)"
                                aria-selected="@(isActive == "active" ? "true" : "false")"
                                style="outline:none;">
                                <div class="d-flex align-items-center gap-5">
                                    <span class="fw-semibold" style="font-size:1.1em;">@problem.Problems</span>
                                    <span class="badge bg-active ms-2">@problem.Status</span>
                                </div>
                                
                            </button>
                            <div class="dropdown ms-2" style="position:absolute; right:10px; top:10px;">
                                <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" class="d-flex align-items-center px-2">
                                    <i class="bx bx-dots-vertical fs-5 text-muted"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 px-2 py-2 rounded-3"
                                    style="min-width: 220px; z-index:1060; position:absolute;">
                                    <li class="px-2 fw-semibold small">Options</li>
                                    <li>
                                        <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                        data-bs-toggle="modal" data-bs-target="#EditProblemModal-@problem.PsyProblemListId"
                                        style="color:Black;">
                                            Edit Problem
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                        data-bs-toggle="modal" data-bs-target="#MarkProblemResolvedModal-@problem.PsyProblemListId"
                                        style="color:Black;">
                                            Mark as Resolved
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                        data-bs-toggle="modal" data-bs-target="#MarkProblemInactiveModal-@problem.PsyProblemListId"
                                        style="color:Black;">
                                            Mark as Inactive
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                        data-bs-toggle="modal" data-bs-target="#MarkProblemActiveModal-@problem.PsyProblemListId"
                                        style="color:Black;">
                                            Mark as Active
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>

        <!-- Tab content -->
        <div class="col-md-8 bg-white">
            <div class="tab-content" id="problemTabContent">
                @for (int i = 0; i < Model.Problems.Count; i++)
                {
                    var problem = Model.Problems[i];
                    <div class="tab-pane fade @(i == 0 ? "show active" : "")"
                        id="problem@(i+1)"
                        role="tabpanel"
                        aria-labelledby="problem@(i+1)-tab">
                        <div class="mt-3">
                            <div class="d-flex align-items-center mb-2">
                                <h5 class="fw-bold mb-0">@problem.Problems</h5>
                                <span class="badge bg-active ms-2">@problem.Status</span>
                            </div>
                            <div class="small text-muted mb-3">
                                Noted by: <span class="fw-semibold">-</span>
                            </div>
                            <hr />
                        </div>

                        @* <!-- Goal Section -->
                        <div class="mt-3 bg-light p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-3">
                                    <h4 class="fw-bold mb-0">Goal</h4>
                                    <a href="#" class="text-teal fw-semibold small text-decoration-none"
                                    data-bs-toggle="modal"
                                    data-bs-target="#addGoalModal"
                                    onclick="document.getElementById('PsyProblemListId').value='@problem.PsyProblemListId'">
                                        + Add
                                    </a>
                                </div>
                                <div>
                                    <select class="form-select form-select-sm w-auto ms-auto" style="font-size:0.95em;" aria-label="Goal Status">
                                        <option value="inprogress">Goal Status</option>
                                        <option value="completed">Completed</option>
                                        <option value="discontinued">Discontinued</option>
                                    </select>
                                </div>
                            </div>
                            @if (problem.Goals == null || !problem.Goals.Any())
                            {
                                <div class="text-center text-muted py-5 bg-white">
                                    This patient has no active goals yet.<br />
                                    <a href="#" class="text-teal fw-semibold small text-decoration-none" data-bs-toggle="modal" data-bs-target="#addGoalModal" onclick="document.getElementById('PsyProblemListId').value='@problem.PsyProblemListId'">+ Add Now</a>
                                </div>
                            }
                            else
                            {
                                @foreach (var goal in problem.Goals)
                                {
                                    // Set status text and background class
                                    var statusText = goal.Status;
                                    var statusClass = "bg-inprogress";
                                    if (!string.IsNullOrEmpty(goal.Status))
                                    {
                                        switch (goal.Status.Trim().ToLower())
                                        {
                                            case "completed":
                                                statusText = "Completed";
                                                statusClass = "bg-completed";
                                                break;
                                            case "discontinue":
                                            case "discontinued":
                                                statusText = "Discontinue";
                                                statusClass = "bg-discontinued";
                                                break;
                                            default:
                                                statusText = "In Progress";
                                                statusClass = "bg-inprogress";
                                                break;
                                        }
                                    }

                                    <div class="p-3 rounded-3 mb-2 bg-white shadow-sm">
                                        <div class="d-flex justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <span class="fw-bold">@goal.Description</span>
                                                <span class="badge @statusClass ms-2">@statusText</span>
                                                <i class="bi bi-three-dots-vertical ms-auto"></i>
                                            </div>
                                            <div class="dropdown" data-bs-display="static">
                                                <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bx bx-dots-vertical fs-5 text-muted"></i>
                                                </a>
                                                <ul class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 px-2 py-2 rounded-3" style="min-width: 220px;">
                                                    <li class="px-2 text-muted fw-semibold small">Options</li>
                                                    <li>
                                                        <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#EditGoalModal-@goal.GoalId">
                                                            <span class="badge-dot bg-info"></span>
                                                            Edit Goal
                                                        </a>
                                                    </li>
                                                    <li>
                                                         <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#MarkAsCompletedModal-@goal.GoalId">
                                                            <span class="badge-dot bg-success"></span>
                                                            Mark as Completed
                                                        </a>
                                                    </li>
                                                    <li>
                                                         <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#DiscontinueGoalModal-@goal.GoalId">
                                                            <span class="badge-dot bg-danger"></span>
                                                            Discontinue
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="small text-muted mt-1">
                                                Noted by: <span class="fw-semibold">@goal.NotedBy</span>
                                                <span class="ms-3">Target Date: @goal.TargetDate?.ToShortDateString()</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div> *@

                       <!-- Interventions Section -->
                        <div class="mt-4 bg-light p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h4 class="fw-bold mb-0">INTERVENTIONS</h4>
                                <div>
                                    <button type="button" class="btn btn-custom text-white fw-semibold" style="background:#0097A7; border-radius:10px; min-width:160px;" data-bs-toggle="modal" data-bs-target="#addInterventionModal">Add Intervention</button>
                                    <a class="btn btn-custom text-white fw-semibold ms-2" 
                                        style="background:#0097A7; border-radius:10px; min-width:160px;" 
                                        href="@Url.Action("AddMedicationOrder", "Medication", new { patientId = ViewBag.PatientId, problemId = problem.PsyProblemListId })">
                                        Add Medication
                                    </a>
                                </div>
                            </div>
                            <div class="bg-white rounded-3 shadow-sm p-3">
                                <table class="table mb-0 align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width:40px;">#</th>
                                            <th>Description</th>
                                            <th>Frequency</th>
                                            <th>Status</th>
                                            <th>Clinician</th>
                                            <th style="width:40px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (problem.Interventions == null || problem.Interventions.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-5">
                                                    This patient has no added interventions yet.<br />
                                                    <a href="#" class="text-teal fw-semibold small text-decoration-none" data-bs-toggle="modal" data-bs-target="#addInterventionModal">+ Add Now</a>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int idx = 1;
                                            foreach (var intervention in problem.Interventions)
                                            {
                                                var isMedication = intervention?.MedicationOrderId.HasValue == true;
                                                <tr>
                                                    <td class="fw-semibold">@idx</td>
                                                    <td>
                                                        @if (isMedication)
                                                        {
                                                            <div class="fw-bold">Medication</div>
                                                            <div class="text-muted small" style="font-size:1.05em;">@intervention.MedicationName</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="fw-bold" style="font-size:1.05em;">@intervention?.ServiceTypeName - @intervention.UnitPerDose @intervention?.ServiceModalityName</div>
                                                            <div class="text-muted small">@intervention.Description</div>
                                                        }
                                                    </td>
                                                    <td class="fw-semibold">
                                                        @if (isMedication)
                                                        {
                                                            @intervention.ScheduledType
                                                        }
                                                        else
                                                        {
                                                            @intervention.Frequency
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="fw-semibold">@intervention.Status</span>
                                                    </td>
                                                    <td>
                                                        <img src="~/Images/default.png" alt="Clinician" class="rounded-circle" style="width:36px;height:36px;object-fit:cover;" />
                                                    </td>
                                                    <td>
                                                        <div class="dropdown">
                                                            <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                                <i class="bx bx-dots-vertical fs-5 text-muted"></i>
                                                            </a>
                                                            <ul class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 px-2 py-2 rounded-3">
                                                                <li class="px-2 text-muted fw-semibold small">Options</li>

                                                                @if (isMedication)
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                                                                           href="@Url.Action("EditMedicationOrder", "Medication", new { id = intervention.MedicationOrderId })">
                                                                            Edit Medication
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <form asp-action="RemoveMedicationOrder" asp-controller="Medication" method="post" class="m-0">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="id" value="@intervention.MedicationOrderId" />
                                                                            <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2 border-0 bg-transparent">Remove Medication</button>
                                                                        </form>
                                                                    </li>
                                                                }
                                                                else
                                                                {
                                                                    <li>
                                                                        <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2">
                                                                            Edit Intervention
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2">
                                                                            Remove
                                                                        </a>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </td>
                                                </tr>
                                                idx++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

@* Modal in adding problem *@

<!-- #region Modal For Goal-->

    @* Add Goal Modal *@
    <div class="modal fade" id="addGoalModal" tabindex="-1" aria-labelledby="addGoalModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:10px;">
                <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                    <h5 class="modal-title fw-bold" id="addGoalModalLabel">Add Goal</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="AddGoal" asp-controller="TreatmentPlan" method="post">
                        <input type="hidden" name="PsyProblemListId" id="PsyProblemListId" />
                        <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                        <div class="mb-3">
                            <label for="goalDescription" class="form-label fw-semibold">Goal</label>
                            <input type="text" name="description" class="form-control" id="description" placeholder="Enter goal" />
                        </div>
                        <div class="mb-4">
                            <label for="targetDate" class="form-label fw-semibold">Target Date</label>
                            <input type="date" name="targetDate" class="form-control" id="targetDate" />
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Add</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Goal Modal -->
    @foreach (var problem in Model.Problems)
    {
        if (problem.Goals != null)
        {
            foreach (var goal in problem.Goals)
            {
                <div class="modal fade" id="EditGoalModal-@goal.GoalId" tabindex="-1" aria-labelledby="editGoalModalLabel-@goal.GoalId" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border-radius:10px;">
                            <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                                <h5 class="modal-title fw-bold" id="editGoalModalLabel-@goal.GoalId">Edit Goal</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form asp-action="EditGoal" asp-controller="TreatmentPlan" method="post">
                                    <input type="hidden" name="goalId" value="@goal.GoalId" />
                                    <input type="hidden" name="PsyProblemListId" value="@problem.PsyProblemListId" />
                                    <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                                    <div class="mb-3">
                                        <label for="editDescription-@goal.GoalId" class="form-label fw-semibold">Goal</label>
                                        <input type="text" name="description" class="form-control" id="editDescription-@goal.GoalId" value="@goal.Description" placeholder="Enter goal" />
                                    </div>
                                    <div class="mb-4">
                                        <label for="editTargetDate-@goal.GoalId" class="form-label fw-semibold">Target Date</label>
                                        <input type="date" name="targetDate" class="form-control" id="editTargetDate-@goal.GoalId" value="@(goal.TargetDate.HasValue ? goal.TargetDate.Value.ToString("yyyy-MM-dd") : "")" />
                                    </div>
                                    <div class="d-flex justify-content-end">
                                        <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Save</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }

    @* Mark As Completed Confirmation Modal *@
    @foreach (var problem in Model.Problems)
    {
        if (problem.Goals != null)
        {
            foreach (var goal in problem.Goals)
            {
                <div class="modal fade" id="MarkAsCompletedModal-@goal.GoalId" tabindex="-1" aria-labelledby="markAsCompletedModalLabel-@goal.GoalId" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border-radius:10px;">
                            <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                                <h5 class="modal-title fw-bold" id="markAsCompletedModalLabel-@goal.GoalId">Mark Goal as Completed</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form asp-action="MarkGoalAsCompleted" asp-controller="TreatmentPlan" method="post">
                                    <input type="hidden" name="goalId" value="@goal.GoalId" />
                                    <input type="hidden" name="PsyProblemListId" value="@problem.PsyProblemListId" />
                                    <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                                    <div class="mb-3">
                                        <p class="fw-semibold mb-0">Are you sure you want to mark this goal as completed?</p>
                                        <div class="mt-2 text-muted">
                                            <strong>Goal:</strong> @goal.Description <br />
                                            <strong>Target Date:</strong> @(goal.TargetDate.HasValue ? goal.TargetDate.Value.ToString("yyyy-MM-dd") : "-")
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:8px; min-width:100px;">Cancel</button>
                                        <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Confirm</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }

    @* Discontinue Goal Confirmation Modal *@
    @foreach (var problem in Model.Problems)
    {
        if (problem.Goals != null)
        {
            foreach (var goal in problem.Goals)
            {
                <div class="modal fade" id="DiscontinueGoalModal-@goal.GoalId" tabindex="-1" aria-labelledby="discontinueGoalModalLabel-@goal.GoalId" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border-radius:10px;">
                            <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                                <h5 class="modal-title fw-bold" id="discontinueGoalModalLabel-@goal.GoalId">Discontinue Goal</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form asp-action="DiscontinueGoal" asp-controller="TreatmentPlan" method="post">
                                    <input type="hidden" name="goalId" value="@goal.GoalId" />
                                    <input type="hidden" name="PsyProblemListId" value="@problem.PsyProblemListId" />
                                    <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                                    <div class="mb-3">
                                        <p class="fw-semibold mb-0">Are you sure you want to discontinue this goal?</p>
                                        <div class="mt-2 text-muted">
                                            <strong>Goal:</strong> @goal.Description <br />
                                            <strong>Target Date:</strong> @(goal.TargetDate.HasValue ? goal.TargetDate.Value.ToString("yyyy-MM-dd") : "-")
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:8px; min-width:100px;">Cancel</button>
                                        <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Confirm</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
<!-- #endregion -->


<!-- Add Problem Modal -->
<div class="modal fade" id="AddProblemModal" tabindex="-1" aria-labelledby="addProblemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:10px;">
            <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                <h5 class="modal-title fw-bold" id="addProblemModalLabel">Add Problem</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="AddProblem" asp-controller="TreatmentPlan" method="post">
                    <input type="hidden" name="patientId" value="@ViewBag.PatientId" />
                    <input type="hidden" name="psychiatricAssessmentId" value="@Model.Problems.FirstOrDefault()?.InitialAssessmentFormId" />
                    <div class="mb-3">
                        <label for="problemDescription" class="form-label fw-semibold">Problem</label>
                        <input type="text" name="problemText" class="form-control" id="problemDescription" placeholder="Enter problem" required />
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn" style="background:#00646A; color:#fff; border-radius:8px; min-width:120px; font-weight:600;">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Problem Modal -->
@foreach (var problem in Model.Problems)
{
    <div class="modal fade" id="EditProblemModal-@problem.PsyProblemListId" tabindex="-1" aria-labelledby="editProblemModalLabel-@problem.PsyProblemListId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:10px;">
                <div class="modal-header" style="background:#00646A; color:#fff; border-top-left-radius:10px; border-top-right-radius:10px;">
                    <h5 class="modal-title fw-bold" id="editProblemModalLabel-@problem.PsyProblemListId">Edit Problem</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="EditProblem" asp-controller="TreatmentPlan" method="post">
