                document.querySelectorAll('.problem-list-row').forEach(function(row) {
                    row.classList.remove('active', 'bg-lightblue');
                    row.style.background = "#fff";
                });
            });
        });

        // Remove highlight on row click
        document.querySelectorAll('#problemTab .problem-list-row').forEach(function(row) {
            row.addEventListener('click', function(e) {
                if (e.target.closest('.dropdown')) return;
                document.querySelectorAll('.problem-list-row').forEach(function(r) {
