@model SafehavenPMS.ViewModel.PatientProfile.PatientClinicalFormTabViewModel
@{
    string CardColor(string status) =>
        status switch
        {
            "Completed" => "#D6F2F7",
            "In Progress" => "#F7E7D8",
            "Archived" => "#E5E5E5",
            "Not Started" => "#EFEFEF",
            _ => "#EFEFEF"
        };

    // Filter: keep all except forms that are Not Started (unless it's the Intake Form)
    var displayedForms = Model?.Forms?
        .Where(f => f.Status != "Not Started" || f.FormType == "Intake Form")
        .ToList() ?? new List<SafehavenPMS.ViewModel.PatientProfile.ClinicalFormCardViewModel>();
}
<!-- Clinical Forms List UI -->
<div style="background:#069FB2;color:#fff;border-radius:10px 10px 0 0;padding:18px 0;text-align:center;font-size:1.4rem;font-weight:700;">
    @displayedForms.Count Form(s)
</div>
<div style="padding:20px;">
    <div style="display:flex;flex-wrap:wrap;gap:24px;">
        @foreach (var f in displayedForms)
        {
            <div style="flex:1 1 45%;min-width:340px;background:@CardColor(f.Status);border-radius:12px;padding:22px 28px;">
                <div style="font-weight:700;font-size:1.15rem;">@f.FormType</div>
                <div style="margin-top:10px;font-size:.95rem;color:#333;line-height:1.4;">
                    Date Created:
                    <span style="font-weight:600;">
                        @(f.CreatedAt?.ToString("yyyy-MM-dd") ?? "--")
                    </span>
                    &nbsp;&nbsp; Clinician:
                    <span style="font-weight:600;">@f.Clinician</span>
                    &nbsp;&nbsp; Status:
                    <span style="font-weight:600;">@f.Status</span>
                </div>
                <div class="mt-3">
                    <a href="@f.ActionUrl" class="btn btn-sm btn-primary">
                        @(f.Exists ? "Open" : "Start")
                    </a>
                </div>
            </div>
        }
        @if (!displayedForms.Any())
        {
            <div class="text-muted">No clinical forms available.</div>
        }
    </div>
</div>
