@model SafehavenPMS.ViewModel.PatientProfilePageViewModel
@{
    ViewBag.Title = "Patient Profile";
}

@* Header: Patient Name + Status *@
<div>
    <div class="d-flex justify-content-start align-items-start mb-3">
        <div class="d-flex align-items-center">
            <a href="javascript:history.back()" class="me-2 text-decoration-none text-muted"><i class="text-custom bx bx-reply fs-1"></i></a>

            <img src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/Images/default.png") : Model.AvatarUrl)"
                 class="rounded-circle me-3"
                 style="width: 60px; height: 60px; object-fit: cover;"/>

            <div>
                <h4 class="mb-0 fw-bold text-custom">@(!string.IsNullOrWhiteSpace(Model.PatientName) ? Model.PatientName : "-")</h4>
                <span class="text-muted">Patient - @(!string.IsNullOrWhiteSpace(Model.PatientRefId.ToString()) ? Model.PatientId.ToString() : "-")</span>
            </div>
        </div>

    </div>

    <div>
        <ul class="nav nav-tabs mb-4" id="profileTabs" role="tablist">
            <li class="nav-item">           
                <a class="nav-link active" id="overview-tab" data-bs-toggle="tab" href="#tab-overview" role="tab" aria-controls="tab-overview" aria-selected="true">Overview</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="personal-tab" data-bs-toggle="tab" href="#tab-personal" role="tab" aria-controls="tab-personal" aria-selected="false">Personal</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="clinical-doc-tab" data-bs-toggle="tab" href="#tab-clinical-doc" role="tab" aria-controls="tab-clinical-doc" aria-selected="false">Clinical Documentation</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="medical-history-tab" data-bs-toggle="tab" href="#tab-medical-history" role="tab" aria-controls="tab-medical-history" aria-selected="false">Medical History</a>
            </li>
            @if(Model.TreatmentPlanTab != null)
             {
                 <li class="nav-item">
                    <a class="nav-link" id="treatment-tab" data-bs-toggle="tab" href="#tab-treatment" role="tab" aria-controls="tab-treatment" aria-selected="false">Treatment Plan</a>
                </li>
                 <li class="nav-item">
                    <a class="nav-link" id="progress-note-tab" data-bs-toggle="tab" href="#tab-progress-note" role="tab" aria-controls="tab-progress-note" aria-selected="false">Progress Note</a>
                </li>
             }
            <li class="nav-item">
                <a class="nav-link" id="activity-tab" data-bs-toggle="tab" href="#tab-activity" role="tab" aria-controls="tab-activity" aria-selected="false">Activity Logs</a>
            </li>
        </ul>
    </div>
</div>

<div class="tab-content" id="tabContentArea">
    <div class="tab-pane fade show active" id="tab-overview" role="tabpanel" aria-labelledby="overview-tab">
        @await Html.PartialAsync("ProfileTabs/_OverviewTab", Model.OverViewTab)
    </div>
    <div class="tab-pane fade" id="tab-personal" role="tabpanel" aria-labelledby="personal-tab">
        @await Html.PartialAsync("ProfileTabs/_PatientProfileTab", Model.PersonalInfoTab)
    </div>
    <div class="tab-pane fade" id="tab-treatment" role="tabpanel" aria-labelledby="treatment-tab">
        @* Add treatment partial here *@
        @await Html.PartialAsync("ProfileTabs/_TreatmentPlanTab", Model.TreatmentPlanTab)
    </div>
    <div class="tab-pane fade" id="tab-progress-note" role="tabpanel" aria-labelledby="progress-note-tab">
        @* Add case documentation partial here *@
        @await Html.PartialAsync("ProfileTabs/_ProgressNotes", Model.ProgressNotesTab)
    </div>
    <div class="tab-pane fade" id="tab-prescription" role="tabpanel" aria-labelledby="prescription-tab">
        @* Add prescription & medication partial here *@
    </div>
    <div class="tab-pane fade" id="tab-billing" role="tabpanel" aria-labelledby="billing-tab">
        @* Add billing partial here *@
    </div>
    <div class="tab-pane fade" id="tab-activity" role="tabpanel" aria-labelledby="activity-tab">
        @* Add activity logs partial here *@
    </div>
</div>

@* Styles *@
<style>
    .upload-button {
        background-color: white;
        color: #00A3B4;
        margin: 5px;
        border: 2px solid #00A3B4;
        padding: 0.5rem 1.5rem;
        border-radius: 6px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        transition: all 0.3s ease;
    }

        .upload-button:hover {
            background-color: #00A3B4;
            color: white;
            transform: translateY(-1px);
        }

    .nav-tabs .nav-link {
        color: #767676;
        background-color: transparent;
        border: none;
        font-weight: normal;
    }

        .nav-tabs .nav-link.active {
            color: #00A3B4;
            background-color: transparent;
            border: none;
            border-bottom: 3px solid #00A3B4;
            font-weight: bold;
        }
</style>

<script>
    // Save active tab to localStorage
    document.querySelectorAll('a[data-bs-toggle="tab"]').forEach(function(tab) {
        tab.addEventListener('shown.bs.tab', function (e) {
            localStorage.setItem('activeProfileTab', e.target.id);
        });
    });

    // Restore active tab from localStorage
    document.addEventListener('DOMContentLoaded', function () {
        var activeTabId = localStorage.getItem('activeProfileTab');
        if (activeTabId) {
            var tabTrigger = document.getElementById(activeTabId);
            if (tabTrigger) {
                var tab = new bootstrap.Tab(tabTrigger);
                tab.show();
            }
        }
    });
</script>