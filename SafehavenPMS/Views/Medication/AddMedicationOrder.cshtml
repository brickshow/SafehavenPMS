@model SafehavenPMS.ViewModel.AddMedicationOrderViewModel

@{
    ViewBag.Title = "Add Medication Order";
}

@* Content Header *@
<div class="header-content">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <i class="bx bxs-group fs-2 me-2" title="Staff"></i>
            <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
        </div>
    </div>
    <hr class="mt-0 mb-2" />
</div>



<div class="container mt-4 w-50">
    <div class="card">
        <div class="card-header bg-teal text-white" style="background-color: #058594; font-size: 18px; font-weight: bold;">
            Patient Medication Details
        </div>
        <div class="card-body">

            <!-- GET form: reload on medicine change -->
            <form method="get" asp-action="AddMedicationOrder" class="mb-3">
                
                <div class="form-group row mb-3">
                    <label asp-for="SelectedMedicineId" class="col-sm-3 col-form-label">Medicine Name</label>
                    <div class="col-sm-9">
                        <select asp-for="SelectedMedicineId" name="medicineId" class="form-control" onchange="this.form.submit()"
                                asp-items="@(new SelectList(Model.Medicines, "MedicineId", "GenericName", Model.SelectedMedicineId))">
                            <option value="">Select Medicine</option>
                        </select>
                        <span asp-validation-for="SelectedMedicineId" class="text-danger"></span>
                    </div>
                </div>
            </form>
            <!-- POST form: save medication order -->
            <form asp-action="AddMedicationOrder" method="post">
                @Html.AntiForgeryToken()

                <!-- hidden values to persist patient + medicine -->
                <input type="hidden" asp-for="SelectedMedicineId" />
                <input type="hidden" asp-for="Form" />
                <input type="hidden" asp-for="Unit" />

                <div class="form-group row mb-3">
                    <label asp-for="SelectedPatientId" class="col-sm-3 col-form-label">Patient Name</label>
                    <div class="col-sm-9">
                        <select asp-for="SelectedPatientId" class="form-control" asp-items="ViewBag.PatientList">
                            <option value="">Select Patient</option>
                        </select>
                        <span asp-validation-for="SelectedPatientId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Display medicine details -->
                <div class="form-group row mb-3">
                    <label asp-for="Form" class="col-sm-3 col-form-label">Form</label>
                    <div class="col-sm-9">
                        <input asp-for="Form" class="form-control" readonly />
                    </div>
                </div>

                <div class="row mb-4">
                    <label asp-for="Dose" class="col-sm-3 col-form-label">Dose</label>
                    <div class="col-sm-9">
                        <div class="row g-2">
                            <div class="col-md-8">
                                <input asp-for="Dose" type="number" step="0.01" class="form-control" required />
                                <span asp-validation-for="Dose" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <input asp-for="Unit" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label asp-for="Instruction" class="col-sm-3 col-form-label">Instruction</label>
                    <div class="col-sm-9">
                        <textarea asp-for="Instruction" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Instruction" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label asp-for="Frequency" class="col-sm-3 col-form-label">Frequency</label>
                    <div class="col-sm-9">
                        <select asp-for="Frequency" class="form-control">
                            <option value="">Select Frequency</option>
                            <option>Once a Day</option>
                            <option>Twice a Day</option>
                            <option>Thrice a Day</option>
                            <option>Every 6 Hours</option>
                            <option>Every 8 Hours</option>
                            <option>PRN</option>
                            <option>Once a Week</option>
                        </select>
                        <span asp-validation-for="Frequency" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label asp-for="StartDate" class="col-sm-3 col-form-label">Start Date</label>
                    <div class="col-sm-9">
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label asp-for="EndDate" class="col-sm-3 col-form-label">End Date</label>
                    <div class="col-sm-9">
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Index", "Medication")" class="btn-cancel btn-outline-secondary flex-fill text-decoration-none">Back</a>
                    <button type="submit" class="btn-next btn-primary flex-fill">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>