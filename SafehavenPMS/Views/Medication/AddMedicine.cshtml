@model SafehavenPMS.ViewModel.MedicineViewModel

@{
    ViewBag.Title = "Add Medicine";
}

@* Content Header *@
<div class="header-content">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <i class="bx bxs-group fs-2 me-2" title="Staff"></i>
            <span><strong class="fs-4 text-custom">@ViewBag.Title</strong></span>
        </div>
    </div>
    <hr class="mt-0 mb-2" />
</div>

    <div class="form-container">
        <form asp-controller="Medication" asp-action="AddMedicine" method="post">
            <div class="header d-flex justify-content-start">
                <h3 class="text-custom m-3">Patient Medication Details</h3>
            </div>
            <div class="p-5">
                <div class="form-group">
                    <label asp-for="MedicineName">Medication Name</label>
                <input asp-for="MedicineName" type="text" class="form-control" />
                    <span asp-validation-for="MedicineName"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form">Form</label>
                <input asp-for="Form" type="text" class="form-control" />
                    <span asp-validation-for="Form"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Dosage">Dosage</label>
                <input asp-for="Dosage" type="text" class="form-control" />
                    <span asp-validation-for="Dosage"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Price">Price</label>
                    <input asp-for="Price" type="text" class="form-control" />
                    <span asp-validation-for="Price"></span>
                </div>

                <!-- Buttons in a horizontal flex container -->
                <div class="d-flex gap-2">
                    <button class="btn-cancel flex-fill" onclick="history.back()">Back</button>
                    <button type="submit" class="btn-next flex-fill">Add</button>
                </div>
            </div>
        </form>
    </div>

<style>
    .form-container {
        max-width: 50%;
        margin: 20px auto;
        border: 1px solid #ccc;
        border-radius: 5px;
        background-color: #fff;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
        }

        .form-group input {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

    .header {
        background: linear-gradient(to right, #069FB2, #058594);
        color: white;
        border-radius: 5px 5px 0 0;
        text-align: center;
    }
</style>