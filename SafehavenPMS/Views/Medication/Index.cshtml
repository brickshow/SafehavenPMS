@model SafehavenPMS.ViewModel.MedicationPageViewModel

@{
    ViewBag.Title = "Medication";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index", "ClinicalStaff")" class="me-3">
            </a>
            <div>
                <div class="d-flex flex-row justify-content-start align-items-center" style="gap:10px">
                    <i class='bx bxs-capsule fs-2'></i>
                    <h4 class="mb-0 text-custom">Medication</h4>
                </div>
            </div>
        </div>
        <a href="@Url.Action("AddMedicine", "Medication")" id="add-medicine-button" class="add-availability btn-custom btn-primary text-decoration-none" style="display:none">
            + Add Medicine
        </a>
        <a href="@Url.Action("AddMedicationOrder", "Medication")" id="add-medication-order-button" class="add-availability btn-custom btn-primary text-decoration-none" style="display:none">
            + Add Medication Order
        </a>
    </div>


    @* Tabs *@
    <ul class="nav nav-tabs mb-4" id="staffTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview"
                    type="button" role="tab" aria-controls="overview" aria-selected="true">
                Summary
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal"
                    type="button" role="tab" aria-controls="personal" aria-selected="false">
                Medication Orders
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents"
                    type="button" role="tab" aria-controls="documents" aria-selected="false">
                Medicines
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link availability-tab" id="availability-tab" data-bs-toggle="tab" data-bs-target="#availability"
                    type="button" role="tab" aria-controls="documents" aria-selected="false">
                History
            </button>
        </li>
    </ul>


    @* Tab Content *@
    <div class="tab-content" id="staffTabContent">
        <div class="tab-pane fade show active" id="overview" role="tabpanel" aria-labelledby="overview-tab">
          @await Html.PartialAsync("TabContent/_SummaryTab")
        </div>

        <div class="tab-pane fade" id="personal" role="tabpanel" aria-labelledby="personal-tab">
            @await Html.PartialAsync("TabContent/_MedicationOrderTab")
        </div>

        <div class="tab-pane fade" id="documents" role="tabpanel" aria-labelledby="documents-tab">
            @await Html.PartialAsync("TabContent/_MedicineTab", Model.Medicines)
        </div>

        @* <div class="tab-pane fade" id="availability" role="tabpanel" aria-labelledby="availability-tab"> *@
        @*     @await Html.PartialAsync("_Availability", Model) *@
        @* @* </div> *@ 
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #767676;
        background-color: transparent;
        border: none;
        font-weight: normal;
    }

        .nav-tabs .nav-link.active {
            color: #00A3B4;
            background-color: transparent;
            border: none;
            border-bottom: 3px solid #00A3B4;
            font-weight: bold;
        }

</style>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Get saved tab from localStorage
        var activeTab = localStorage.getItem('activeTab');

        // Default tab is overview
        var defaultTabId = "overview-tab";
        var tabToActivate = activeTab || defaultTabId;

        var tabEl = document.getElementById(tabToActivate);
        if(tabEl){
            var tab = new bootstrap.Tab(tabEl);
            tab.show();
        }

        // Save tab on click and toggle buttons
        document.querySelectorAll('#staffTab button[data-bs-toggle="tab"]').forEach(function(tabButton) {
            tabButton.addEventListener('shown.bs.tab', function (event) {
                var tabId = event.target.id;
                localStorage.setItem('activeTab', tabId);

                toggleAddButtons(tabId);
            });
        });

        // Run once on page load to show correct button
        toggleAddButtons(tabToActivate);

        // Function to show/hide buttons
        function toggleAddButtons(tabId){
            var addMedicineBtn = document.getElementById("add-medicine-button");
            var addMedicationOrderBtn = document.getElementById("add-medication-order-button");

            if(tabId === "documents-tab"){
                addMedicineBtn.style.display = "flex";
                addMedicationOrderBtn.style.display = "none";
            }
            else if(tabId === "personal-tab"){
                addMedicationOrderBtn.style.display = "flex";
                addMedicineBtn.style.display = "none";
            }
            else{
                // Hide both for other tabs
                addMedicineBtn.style.display = "none";
                addMedicationOrderBtn.style.display = "none";
            }
        }
    });
</script>

