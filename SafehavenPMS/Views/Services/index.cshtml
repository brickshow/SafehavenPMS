@using SafehavenPMS.Enum
@model List<SafehavenPMS.Models.Service>

@{
    ViewBag.Title = "Services";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center g-4">
            <div class="d-flex justify-content-center align-items-center">
                <i class='bx bxs-user fs-2 me-2'></i>   
                <h5 class="text-custom mb-0">Services</h5>
            </div>
            <div class="top-content m-2 d-flex justify-content-between align-content-center">
                <div class="top-left-corner d-flex flex-row align-items-center gap-2">
                    @* Search bar *@
                    <form asp-controller="Services" asp-action="Index" method="get" class="d-flex flex-row justify-content-center m-1 gap-2">
                        <div class="search-input-wrapper d-flex flex-row gap-2">
                            <i class='bx bx-search search-icon'></i>
                            <input name="searchQuery" value="@ViewBag.SearchQuery" class="form-control search-input" placeholder="Search services or role..." />
                        </div>
                        <button type="submit" class="btn-custom" style="height:30px">Search</button>
                    </form>

                    <!-- Sort by -->
                    <div class="sort-by d-flex align-items-center">
                        <form asp-controller="Services" asp-action="Index" method="get" id="sortForm" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="searchQuery" value="@ViewBag.SearchQuery" />
                            <input type="hidden" name="pageSize" value="@ViewBag.PageSize" />
                            <input type="hidden" name="sortOrder" value="@(ViewBag.SortOrder == "descending" ? "ascending" : "descending")" />
                            <select name="sortBy" class="form-select form-select-sm" style="min-width:160px;" onchange="this.form.submit()">
                                <option value="" selected='@(ViewBag.SortBy == "" ? "selected" : null)'>Sort by</option>
                                <option value="Name" selected='@(ViewBag.SortBy == "Name" ? "selected" : null)'>Name</option>
                            </select>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <a href="#" class="btn-custom btn-primary text-decoration-none" 
                    data-bs-toggle="modal" 
                    data-bs-target="#addServiceModal">
            + Add Service
        </a>

        @* <ul class="nav nav-tabs mb-4" id="staffTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview"
                        type="button" role="tab" aria-controls="overview" aria-selected="true">
                    Active
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview"
                        type="button" role="tab" aria-controls="overview" aria-selected="true">
                    Archived
                </button>
            </li>
        </ul> *@

    </div>
    <hr class="mt-0 mb-2" />
</div>
